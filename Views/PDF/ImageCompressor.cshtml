    <script src="~/js/image-toolkit.js" asp-append-version="true"></script>
    <script>
        async function compressImageAction() {
            try {
                await ImageToolkit.runWithAccess('imagecompress', async () => {
                    await compressImage();
                });
            } catch (e) {
                if (!e.paywall) {
                    const errorBox = document.getElementById("errorBox");
                    errorBox.innerText = e.message || "Something went wrong.";
                    errorBox.classList.remove("d-none");
                }
            }
        }

        async function compressImage() {
            const input = document.getElementById("imageInput");
            const errorBox = document.getElementById("errorBox");
            const outputSection = document.getElementById("outputSection");
            const previewImg = document.getElementById("previewImg");
            const originalSize = document.getElementById("originalSize");
            const compressedSize = document.getElementById("compressedSize");
            const base64Output = document.getElementById("base64Output");
            const downloadLink = document.getElementById("downloadLink");

            errorBox.classList.add("d-none");
            errorBox.innerText = "";
            outputSection.classList.add("d-none");

            if (!input.files || !input.files[0]) {
                errorBox.innerText = "Please upload an image file.";
                errorBox.classList.remove("d-none");
                return;
            }

            const file = input.files[0];
            const v = await ImageToolkit.validateImageFile(file, 'imagecompress');
            if (!v.ok) {
                errorBox.innerText = v.error;
                errorBox.classList.remove("d-none");
                return;
            }
            originalSize.innerText = (file.size / 1024).toFixed(2) + " KB";

            const reader = new FileReader();
            reader.onload = function(e) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement("canvas");
                    const ctx = canvas.getContext("2d");

                    // Optional: Resize large images
                    let maxWidth = 1920;
                    let maxHeight = 1080;
                    let width = img.width;
                    let height = img.height;

                    if (width > maxWidth) {
                        height = height * (maxWidth / width);
                        width = maxWidth;
                    }
                    if (height > maxHeight) {
                        width = width * (maxHeight / height);
                        height = maxHeight;
                    }

                    canvas.width = width;
                    canvas.height = height;
                    ctx.drawImage(img, 0, 0, width, height);

                    // Compress image: convert PNG/WebP to JPEG for real compression
                    const mimeType = "image/jpeg";
                    const quality = 0.7; // 0.1–1.0 adjust as needed

                    const dataUrl = canvas.toDataURL(mimeType, quality);

                    // Show preview
                    previewImg.src = dataUrl;

                    // Approximate compressed size
                    const compressedBytes = Math.round((dataUrl.length * 3) / 4);
                    compressedSize.innerText = (compressedBytes / 1024).toFixed(2) + " KB";

                    // Show output section
                    base64Output.value = dataUrl;
                    downloadLink.href = dataUrl;
                    downloadLink.download = "compressed_image.jpg";
                    outputSection.classList.remove("d-none");
                };
                img.onerror = function() {
                    errorBox.innerText = "Invalid image file.";
                    errorBox.classList.remove("d-none");
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        function copyBase64() {
            const base64 = document.getElementById("base64Output").value;
            navigator.clipboard.writeText(base64)
                .then(() => alert("Copied Base64 to clipboard!"))
                .catch(() => alert("Copy failed."));
        }

        function clearAll() {
            document.getElementById("imageInput").value = "";
            document.getElementById("previewImg").src = "";
            document.getElementById("originalSize").innerText = "";
            document.getElementById("compressedSize").innerText = "";
            document.getElementById("base64Output").value = "";
            document.getElementById("outputSection").classList.add("d-none");
            document.getElementById("errorBox").classList.add("d-none");
        }
    </script>

}
