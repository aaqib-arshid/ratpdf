@{
    ViewData["Title"] = "Convert PDF to Excel Online Free";
    ViewData["Description"] = "Convert PDF to EXCEL online for free. Fast and secure PDF to EXCEL converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="max-width: 500px; width: 100%;">
        <div class="card-body text-center">
            <h2 class="fw-bold mb-3">Convert PDF to Excel</h2>
            <p class="text-muted mb-4">Upload a PDF and get its text extracted into an Excel file.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="PdfToExcel" method="post" enctype="multipart/form-data">
                <input type="file" name="file" class="form-control mb-3" accept="application/pdf">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i> Convert to Excel
                </button>
            </form>
            <div class="container py-5">
                <div class="card shadow-sm p-4" style="border-radius: 12px;">
                    <h2 class="fw-bold mb-3">How to Convert PDF to Excel Online</h2>

                    <p>
                        Our free PDF to Excel converter lets you extract data from PDF files and
                        turn it into an editable Excel spreadsheet quickly and securely. Perfect for
                        reports, tables, invoices, and structured data.
                    </p>

                    <ol class="mb-4">
                        <li>
                            <strong>Upload your PDF file</strong> using the upload button above.
                        </li>
                        <li>
                            <strong>Click “Convert to Excel”</strong> to extract tables and text into XLSX format.
                        </li>
                        <li>
                            <strong>Download the Excel file</strong> instantly once the conversion is complete.
                        </li>
                    </ol>

                    <h3 class="fw-semibold mt-4">Why Use Our PDF to Excel Converter?</h3>
                    <ul>
                        <li>✔ Convert PDF to XLSX or XLS online for free</li>
                        <li>✔ Accurate data extraction with formatting preserved</li>
                        <li>✔ Fast, secure, and private processing</li>
                        <li>✔ Works on Windows, Mac, Android, and iOS</li>
                        <li>✔ No signup or software installation required</li>
                    </ul>

                    <p class="mt-3">
                        This tool is ideal for extracting financial statements, reports, tables, and data
                        from PDFs for analysis, sharing, or further processing in Excel.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "PDF to Excel Converter",
          "applicationCategory": "UtilityApplication",
          "operatingSystem": "Web",
          "url": "https://ratpdf.com/PDF/PdfToExcel",
          "description": "Convert PDF files to Excel spreadsheets online for free. Fast and secure.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
    </script>
}