@using ratpdf.Constants
@{
    ViewData["Title"] = "PDF to Excel Converter Online Free — Tables & Data | RatPDF";
    ViewData["Description"] = "Convert PDF to Excel (XLSX) online. Extract tables with borders, structured sheets, and reading-order text. Free 200 MB, Pro 4 GB.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/PDF/PdfToExcel");
    ViewData["PdfToolId"] = "pdftoexcel";
    ViewData["ToolTitle"] = "PDF to Excel";
    ViewData["ToolSubtitle"] = "Table borders · multi-sheet · structured data";
    ViewData["AcceptHint"] = "PDF files";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-file-earmark-spreadsheet";
    ViewData["BtnLabel"] = "Convert to Excel";
    ViewData["SeoH1"] = "PDF to Excel — Extract Tables Without Losing Structure";
    ViewData["SeoLead"] = "Pull tables, grid lines, and cell data from PDFs into editable Excel workbooks — not a single-column text dump.";
}

@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")

@section Scripts {
<script>
PdfToolkit.initJobTool({
    toolId: 'pdftoexcel',
    convertUrl: '/PDF/PdfToExcel/convert',
    extensions: ['.pdf'],
    typeLabel: 'PDF',
    multiple: false,
    defaultFileName: 'converted.xlsx',
    dropZoneId: 'dropZone',
    fileInputId: 'fileInput',
    fileListId: 'fileList',
    convertBtnId: 'convertBtn',
    errorAreaId: 'errorArea',
    progressAreaId: 'progressArea',
    progressBarId: 'progressBar',
    progressMsgId: 'progressMsg',
    progressPctId: 'progressPct',
    badgeId: 'usageBadge',
    limitHintId: 'limitHint',
});
</script>
}
