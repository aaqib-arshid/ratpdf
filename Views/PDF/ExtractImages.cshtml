@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.ExtractImages, ViewData);
    ViewData["ToolTitle"] = "Extract PDF Images";
    ViewData["ToolSubtitle"] = "Download all embedded images as ZIP";
    ViewData["AcceptHint"] = "PDF files";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-file-image";
    ViewData["BtnLabel"] = "Extract Images";
}
@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
PdfToolkit.initJobTool({ toolId: 'extractimages', convertUrl: '/PDF/ExtractImages', extensions: ['.pdf'], typeLabel: 'PDF', multiple: false, defaultFileName: 'images.zip', dropZoneId: 'dropZone', fileInputId: 'fileInput', fileListId: 'fileList', convertBtnId: 'convertBtn', errorAreaId: 'errorArea', progressAreaId: 'progressArea', progressBarId: 'progressBar', progressMsgId: 'progressMsg', progressPctId: 'progressPct', badgeId: 'usageBadge', limitHintId: 'limitHint' });
</script>
}
