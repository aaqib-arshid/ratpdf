@{
    ViewData["Title"] = "Convert PDF to Text Online Free";
    ViewData["Description"] = "Convert PDF to TEXT online for free. Fast and secure PDF to TEXT converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">PDF to Text</h2>
            <p class="text-muted mb-4">Upload a PDF file to extract all text content into a plain text file.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="PdfToText" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop a PDF here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text me-2"></i> Extract Text
                </button>
            </form>
        </div>
    </div>
</div>
<section class="related-tools">
  <h3>Related Tools</h3>
  <ul>
     <li><a href="/PDF/TextToPdf">Text to PDF</a></li>
     <li><a href="/PDF/PdfToDoc">PDF to Word</a></li>
     <li><a href="/PDF/PdfToExcel">PDF to Excel</a></li>
  </ul>
</section>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Convert PDF to Text Online</h2>

        <p>
            Our free PDF to Text converter extracts all text content from PDF files into a plain
            text (.txt) file quickly and securely. This makes it easy to reuse or edit your PDF content.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> by dragging and dropping it into the upload area
                or selecting it from your device.
            </li>
            <li>
                <strong>Click “Extract Text”</strong> to convert the PDF content into a plain text file.
            </li>
            <li>
                <strong>Download the text file</strong> immediately after the conversion is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF to Text Converter?</h3>
        <ul>
            <li>✔ Convert PDF content to plain text quickly and free</li>
            <li>✔ Preserve text accuracy without formatting issues</li>
            <li>✔ Secure and private online processing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No registration or software installation required</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for extracting text from reports, scanned documents, research papers,
            contracts, and other PDFs for editing, copying, or analysis.
        </p>
    </div>
</div>
