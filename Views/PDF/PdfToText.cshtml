                        <p class="mb-0 text-muted">Drag & drop a PDF here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text me-2"></i> Extract Text
                </button>
            </form>
        </div>
    </div>
    </div>
