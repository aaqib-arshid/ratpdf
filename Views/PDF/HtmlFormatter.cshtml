    <style>
        /* Make the colored output look like a textarea */
        .colored-output {
            font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
            font-size: 0.85rem;
            line-height: 1.5;
            background-color: #1e2a36;
            color: #f8f8f2;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.75rem;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
            resize: vertical;
            min-height: 240px;
            max-height: 400px;
        }
        .colored-output pre {
            margin: 0;
            background: transparent;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .colored-output code {
            background: transparent;
            font-family: inherit;
            font-size: inherit;
        }
        /* Scrollbar styling */
        .colored-output::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .colored-output::-webkit-scrollbar-track {
            background: #0f1a24;
            border-radius: 8px;
        }
        .colored-output::-webkit-scrollbar-thumb {
            background: #3b82f6;
            border-radius: 8px;
        }
    </style>
</head>

<div class="container py-5">
    <div class="card shadow-lg p-4" style="border-radius:15px;">
        <div class="card-body">

