    <script src="https://cdnjs.cloudflare.com/ajax/libs/js-beautify/1.14.9/beautify-html.min.js"></script>
    <script>
        let currentRawOutput = "";

        function highlightAndDisplay(code) {
            const outputDiv = document.getElementById("htmlOutput");
            const container = document.createElement('div');
            const pre = document.createElement('pre');
            const codeEl = document.createElement('code');
            codeEl.className = 'language-markup';
            codeEl.textContent = code;
            pre.appendChild(codeEl);
            container.appendChild(pre);
            Prism.highlightElement(codeEl);
            outputDiv.innerHTML = '';
            outputDiv.appendChild(pre);
            // Apply scroll and style
            pre.style.margin = '0';
            pre.style.background = 'transparent';
            pre.style.whiteSpace = 'pre-wrap';
            pre.style.wordBreak = 'break-word';
        }

        function formatHtml() {
            let input = document.getElementById("htmlInput").value;
            let formatted = html_beautify(input, {
                indent_size: 2,
                wrap_line_length: 120
            });
            currentRawOutput = formatted;
            highlightAndDisplay(formatted);
        }

        function minifyHtml() {
            let input = document.getElementById("htmlInput").value;
            let minified = input
                .replace(/\n/g, "")
                .replace(/\s+/g, " ")
                .replace(/>\s+</g, "><")
                .trim();
            currentRawOutput = minified;
            highlightAndDisplay(minified);
        }

        function copyOutput() {
            if (currentRawOutput) {
                navigator.clipboard.writeText(currentRawOutput)
                    .then(() => showToast("Copied to clipboard!"))
                    .catch(() => showToast("Copy failed"));
            } else {
                showToast("No formatted output to copy. Please click Beautify or Minify first.");
            }
        }

        function clearAll() {
            document.getElementById("htmlInput").value = "";
            currentRawOutput = "";
            const outputDiv = document.getElementById("htmlOutput");
            outputDiv.innerHTML = '<pre><code class="language-markup">← Formatted HTML will appear here with colors →</code></pre>';
            const codeEl = outputDiv.querySelector('code');
            if (codeEl) Prism.highlightElement(codeEl);
        }
    </script>
}