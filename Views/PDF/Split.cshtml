@{
    ViewData["Title"] = "Split PDF online free";
    ViewData["Description"] = "Split PDF online for free. Fast and secure PDF split tool.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Split PDF</h2>
            <p class="text-muted mb-4">Upload a PDF and extract specific pages into a new PDF file.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Split" method="post" enctype="multipart/form-data" id="splitForm">
                <!-- Drag & Drop -->
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop PDF here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <!-- Page Range Inputs -->
                <div class="row mb-3 g-2">
                    <div class="col">
                        <input type="number" class="form-control" name="startPage" placeholder="Start Page" min="1" required>
                    </div>
                    <div class="col">
                        <input type="number" class="form-control" name="endPage" placeholder="End Page" min="1" required>
                    </div>
                </div>

                <!-- Submit -->
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-scissors me-2"></i> Split PDF
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Split a PDF Online</h2>

        <p>
            Our free PDF splitter allows you to extract specific pages from a PDF document
            or split it into multiple smaller PDFs quickly and securely. No software installation is required.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> by dragging and dropping it into the upload area or selecting it from your device.
            </li>
            <li>
                <strong>Enter the page range</strong> you want to extract using the “Start Page” and “End Page” fields.
            </li>
            <li>
                <strong>Click “Split PDF”</strong> to generate a new PDF containing only the selected pages.
            </li>
            <li>
                <strong>Download your new PDF</strong> immediately after the process is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Splitter?</h3>
        <ul>
            <li>✔ Split PDF pages online for free</li>
            <li>✔ Extract selected pages quickly and easily</li>
            <li>✔ Secure and private file processing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No registration or software installation required</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for splitting reports, extracting invoices, or separating chapters
            from PDF books or documents for sharing or editing purposes.
        </p>
    </div>
</div>
@section Scripts {
   <script type="application/ld+json">
@Html.Raw(@"{
  ""@context"": ""https://schema.org"",
  ""@graph"": [
    {
      ""@type"": ""SoftwareApplication"",
      ""name"": ""Split PDF Pages Online"",
      ""applicationCategory"": ""UtilityApplication"",
      ""operatingSystem"": ""Web"",
      ""url"": ""https://ratpdf.com/PDF/Split"",
      ""description"": ""Split your PDF files into separate pages or extract selected pages easily online for free."",
      ""offers"": {
        ""@type"": ""Offer"",
        ""price"": ""0"",
        ""priceCurrency"": ""USD""
      }
    },
    {
      ""@type"": ""FAQPage"",
      ""mainEntity"": [
        {
          ""@type"": ""Question"",
          ""name"": ""How do I split a PDF online?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Upload your PDF file, enter the start and end page numbers for the pages you want to extract, click 'Split PDF', and download the new PDF.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is splitting PDFs online free?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, our PDF splitting tool is completely free and does not require any registration or software installation.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Can I select a range of pages to extract?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, you can specify the start and end page numbers to extract only the pages you need.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is my PDF secure when using this tool?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, all uploaded PDFs are processed securely and deleted after splitting to ensure privacy.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Which devices can I use to split PDFs?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""This online PDF splitter works on any device with a browser, including Windows, Mac, Android, and iOS.""
          }
        }
      ]
    }
  ]
}");
    </script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
        });
    </script>
}