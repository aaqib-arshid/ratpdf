@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.RepairPdf, ViewData);
    ViewData["ToolTitle"] = "Repair PDF";
    ViewData["ToolSubtitle"] = "Fix corrupt or unreadable PDF files";
    ViewData["AcceptHint"] = "Damaged or won't-open PDFs";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-wrench-adjustable";
    ViewData["BtnLabel"] = "Repair PDF";
}
@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
PdfToolkit.initJobTool({ toolId: 'repairpdf', convertUrl: '/pdf/repair', extensions: ['.pdf'], typeLabel: 'PDF', multiple: false, defaultFileName: 'repaired.pdf', dropZoneId: 'dropZone', fileInputId: 'fileInput', fileListId: 'fileList', convertBtnId: 'convertBtn', errorAreaId: 'errorArea', progressAreaId: 'progressArea', progressBarId: 'progressBar', progressMsgId: 'progressMsg', progressPctId: 'progressPct', badgeId: 'usageBadge', limitHintId: 'limitHint' });
</script>
}
