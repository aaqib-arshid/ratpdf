@{
    ViewData["Title"] = "Add Watermark To PDF Online Free";
    ViewData["Description"] = "Add Watermark to PDF online for free. Fast and secure Water mark tool.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Add Watermark</h2>
            <p class="text-muted mb-4">Upload a PDF and add a text watermark to all pages.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Watermark" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="file" name="file" class="form-control" accept="application/pdf">
                </div>
                <div class="mb-3">
                    <input type="text" name="watermarkText" class="form-control" placeholder="Watermark Text">
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-droplet-half me-2"></i> Add Watermark
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Add a Watermark to Your PDF</h2>

        <p>
            Our free online PDF watermark tool allows you to add custom text watermarks to one or multiple pages
            of your PDF document. It's fast, secure, and works entirely in your browser.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> by dragging and dropping it or selecting it from your device.
            </li>
            <li>
                <strong>Enter the watermark text</strong> you want to appear on all pages of the PDF.
            </li>
            <li>
                <strong>Click “Add Watermark”</strong> to apply your text watermark instantly.
            </li>
            <li>
                <strong>Download your new PDF</strong> with the watermark applied.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Watermark Tool?</h3>
        <ul>
            <li>✔ Add text watermarks online for free</li>
            <li>✔ Works on all PDF pages simultaneously</li>
            <li>✔ Safe and secure processing</li>
            <li>✔ Compatible with Windows, Mac, Android, and iOS</li>
            <li>✔ No software installation or registration required</li>
        </ul>

        <p class="mt-3">
            Protect your documents, mark drafts, or brand your PDFs with custom watermarks easily and quickly
            using our free online tool.
        </p>
    </div>
</div>
@section Scripts {

    <script type="application/ld+json">
@Html.Raw(@"{
  ""@context"": ""https://schema.org"",
  ""@graph"": [
    {
      ""@type"": ""SoftwareApplication"",
      ""name"": ""Add Watermark to PDF"",
      ""applicationCategory"": ""UtilityApplication"",
      ""operatingSystem"": ""Web"",
      ""url"": ""https://ratpdf.com/PDF/Watermark"",
      ""description"": ""Add custom text or image watermarks to your PDF files online for free."",
      ""offers"": {
        ""@type"": ""Offer"",
        ""price"": ""0"",
        ""priceCurrency"": ""USD""
      }
    },
    {
      ""@type"": ""FAQPage"",
      ""mainEntity"": [
        {
          ""@type"": ""Question"",
          ""name"": ""How do I add a watermark to a PDF online?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Upload your PDF file, enter the text you want as a watermark, click 'Add Watermark', and download the new PDF.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is adding watermarks online free?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, our PDF watermark tool is completely free and does not require registration or software installation.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Can I apply a watermark to all pages?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, the tool applies the watermark text to all pages of your PDF automatically.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is my PDF file secure when using this tool?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, all PDFs are processed securely and deleted after processing to ensure privacy.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Which devices can I use to add watermarks?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""This online watermark tool works on any device with a browser, including Windows, Mac, Android, and iOS.""
          }
        }
      ]
    }
  ]
}");
    </script>
}