@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.Watermark, ViewData);
    ViewData["ToolTitle"] = "Watermark PDF";
    ViewData["ToolSubtitle"] = "Text or image · opacity · page range";
    ViewData["AcceptHint"] = "PDF files";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-droplet-half";
    ViewData["BtnLabel"] = "Add Watermark";
}
@await Html.PartialAsync("_PdfJobToolShell")
<div class="container pb-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <ul class="nav nav-pills nav-fill mb-3" id="wmModeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-mode="text" type="button">Text</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-mode="image" type="button">Image / logo</button>
                        </li>
                    </ul>

                    <div id="textWmPanel">
                        <label class="form-label fw-semibold" for="watermarkText">Watermark text</label>
                        <input type="text" id="watermarkText" class="form-control form-control-lg mb-2" placeholder="CONFIDENTIAL" maxlength="80">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary wm-preset" data-text="DRAFT">DRAFT</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary wm-preset" data-text="CONFIDENTIAL">CONFIDENTIAL</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary wm-preset" data-text="SAMPLE">SAMPLE</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary wm-preset" data-text="COPY">COPY</button>
                        </div>
                    </div>

                    <div id="imageWmPanel" class="d-none">
                        <label class="form-label fw-semibold" for="watermarkImage">Watermark image (PNG/JPG)</label>
                        <input type="file" id="watermarkImage" class="form-control" accept="image/png,image/jpeg,image/webp">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="opacity">Opacity <span id="opacityVal" class="text-muted">35%</span></label>
                            <input type="range" id="opacity" class="form-range" min="5" max="80" value="35">
                        </div>
                        <div class="col-md-6" id="fontSizeWrap">
                            <label class="form-label fw-semibold" for="fontSize">Text size</label>
                            <select id="fontSize" class="form-select">
                                <option value="36">Small</option>
                                <option value="48" selected>Medium</option>
                                <option value="64">Large</option>
                                <option value="84">Extra large</option>
                            </select>
                        </div>
                        <div class="col-md-6" id="rotationWrap">
                            <label class="form-label fw-semibold" for="rotation">Rotation</label>
                            <select id="rotation" class="form-select">
                                <option value="-45">Diagonal (-45°)</option>
                                <option value="0">Horizontal</option>
                                <option value="45">Diagonal (+45°)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="layout">Layout</label>
                            <select id="layout" class="form-select">
                                <option value="diagonal">Center diagonal</option>
                                <option value="horizontal">Center horizontal</option>
                                <option value="tile">Tiled repeat</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" for="pages">Pages</label>
                            <select id="pages" class="form-select">
                                <option value="all">All pages</option>
                                <option value="first">First page only</option>
                                <option value="range">Page range</option>
                            </select>
                        </div>
                        <div class="col-md-3" id="pageStartWrap" style="display:none;">
                            <label class="form-label fw-semibold" for="pageStart">From</label>
                            <input type="number" id="pageStart" class="form-control" min="1" value="1">
                        </div>
                        <div class="col-md-3" id="pageEndWrap" style="display:none;">
                            <label class="form-label fw-semibold" for="pageEnd">To</label>
                            <input type="number" id="pageEnd" class="form-control" min="1" value="1">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
(async function () {
    const toolId = 'watermark';
    const access = await PdfToolkit.checkToolAccess(toolId);
    const elements = PdfToolkit.getStandardProgressElements();
    let selected = null;
    let wmMode = 'text';
    let wmImage = null;

    const fileInput = document.getElementById('fileInput');
    const convertBtn = document.getElementById('convertBtn');
    const errorArea = document.getElementById('errorArea');
    const opacity = document.getElementById('opacity');
    const opacityVal = document.getElementById('opacityVal');
    const pages = document.getElementById('pages');

    const hint = document.getElementById('limitHint');
    if (hint) hint.textContent = `${access.maxFileSizeLabel || '200 MB'} per file`;
    const badge = document.getElementById('usageBadge');
    if (badge) PdfToolkit.setUsageBadgeEl(badge, access);

    opacity?.addEventListener('input', () => {
        opacityVal.textContent = opacity.value + '%';
    });

    document.querySelectorAll('#wmModeTabs .nav-link').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#wmModeTabs .nav-link').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            wmMode = btn.dataset.mode;
            document.getElementById('textWmPanel').classList.toggle('d-none', wmMode !== 'text');
            document.getElementById('imageWmPanel').classList.toggle('d-none', wmMode !== 'image');
            document.getElementById('fontSizeWrap').classList.toggle('d-none', wmMode !== 'text');
            document.getElementById('rotationWrap').classList.toggle('d-none', wmMode !== 'text');
        });
    });

    document.querySelectorAll('.wm-preset').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('watermarkText').value = btn.dataset.text;
        });
    });

    document.getElementById('watermarkImage')?.addEventListener('change', (e) => {
        wmImage = e.target.files?.[0] || null;
    });

    pages?.addEventListener('change', () => {
        const show = pages.value === 'range';
        document.getElementById('pageStartWrap').style.display = show ? '' : 'none';
        document.getElementById('pageEndWrap').style.display = show ? '' : 'none';
    });

    await PdfToolkit.bindPdfUpload({
        fileInput,
        dropZone: document.getElementById('dropZone'),
        previewContainer: document.getElementById('fileList'),
        errorArea,
        toolId,
        multiple: false,
        onChange: (files) => {
            selected = files[0] || null;
            convertBtn.disabled = !selected;
        },
    });

    convertBtn?.addEventListener('click', async () => {
        if (!selected) return;
        errorArea.classList.add('d-none');

        const formData = new FormData();
        formData.append('file', selected);
        formData.append('mode', wmMode);
        formData.append('opacity', opacity.value);
        formData.append('fontSize', document.getElementById('fontSize').value);
        formData.append('rotation', document.getElementById('rotation').value);
        formData.append('layout', document.getElementById('layout').value);
        formData.append('pages', pages.value);
        formData.append('pageStart', document.getElementById('pageStart').value || '1');
        formData.append('pageEnd', document.getElementById('pageEnd').value || '1');

        if (wmMode === 'text') {
            const text = document.getElementById('watermarkText').value.trim();
            if (!text) {
                errorArea.textContent = 'Please enter watermark text.';
                errorArea.classList.remove('d-none');
                return;
            }
            formData.append('watermarkText', text);
        } else {
            if (!wmImage) {
                errorArea.textContent = 'Please upload a watermark image.';
                errorArea.classList.remove('d-none');
                return;
            }
            formData.append('watermarkImage', wmImage);
        }

        convertBtn.disabled = true;
        try {
            await PdfToolkit.runJobFlow({
                url: '/PDF/Watermark',
                formData,
                elements,
                toolId,
                defaultFileName: 'watermarked.pdf',
            });
            const s = await PdfToolkit.checkToolAccess(toolId);
            if (badge) PdfToolkit.setUsageBadgeEl(badge, s);
        } catch (e) {
            if (e.paywall) PdfToolkit.showPaywall(e.message);
            else {
                errorArea.textContent = PdfToolkit.sanitizeErrorMessage(e.message || 'Watermark failed.');
                errorArea.classList.remove('d-none');
            }
        } finally {
            convertBtn.disabled = !selected;
        }
    });
})();
</script>
}
