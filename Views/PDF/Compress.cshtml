@{
    ViewData["Title"] = "Compress PDF size online free";
    ViewData["Description"] = "Compress pdf size online for free. Fast and secure PDF compressor.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Compress PDF</h2>
            <p class="text-muted mb-4">Upload a PDF to reduce its file size while keeping content quality.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Compress" method="post" enctype="multipart/form-data" id="compressForm">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop PDF here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <!-- File Preview -->
                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-speedometer2 me-2"></i> Compress PDF
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Compress a PDF File Online</h2>

        <p>
            Our free online PDF compressor helps you reduce PDF file size quickly without compromising quality.
            Follow these simple steps to compress your PDF online.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> by dragging and dropping it into the upload area or clicking
                the upload box to select a file from your device.
            </li>
            <li>
                <strong>Click the “Compress PDF” button</strong> to start the compression process.
            </li>
            <li>
                <strong>Download your compressed PDF</strong> instantly once the process is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Compressor?</h3>
        <ul>
            <li>✔ 100% free online PDF compression</li>
            <li>✔ No registration or installation required</li>
            <li>✔ Secure file processing and privacy protection</li>
            <li>✔ Fast compression with high-quality output</li>
            <li>✔ Works on all devices (Windows, Mac, Android, iOS)</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for reducing PDF size for email attachments, website uploads,
            job applications, and document sharing.
        </p>
    </div>
</div>
@section Scripts {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SoftwareApplication",
  "name": "Compress PDF File Online",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "url": "https://ratpdf.com/PDF/Compress",
  "description": "Reduce PDF file size online without losing quality. Fast, safe, and free PDF compression.",
  "offers": {
    "@@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
    <!-- FAQ JSON-LD -->
    <script type="application/ld+json">
@Html.Raw(@"{
  ""@context"": ""https://schema.org"",
  ""@type"": ""FAQPage"",
  ""mainEntity"": [
    {
      ""@type"": ""Question"",
      ""name"": ""How do I compress a PDF file online?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Drag and drop your PDF into the upload area or click to select a file, then click 'Compress PDF' to reduce the file size instantly.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Is my PDF file secure when uploaded?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Yes, all files are processed securely and deleted from our servers after compression.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Can I use this tool on mobile devices?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Yes, the PDF compressor works on all devices including Windows, Mac, Android, and iOS.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Do I need to register to use the PDF compressor?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""No registration or installation is required; the tool is completely free to use.""
      }
    }
  ]
}")
</script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');

        function updatePreview() {
            if (fileInput.files.length === 0) {
                filePreview.textContent = '';
                return;
            }
            filePreview.textContent = 'Selected file: ' + fileInput.files[0].name;
        }

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            updatePreview();
        });

        fileInput.addEventListener('change', updatePreview);
    </script>
}