}")
        </script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

        <script>
            (function () {
            'use strict';

            pdfjsLib.GlobalWorkerOptions.workerSrc =
            'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';


            const dropZone          = document.getElementById('dropZone');
            const fileInput         = document.getElementById('fileInput');
            const filePreviewCard   = document.getElementById('filePreviewCard');
            const pdfThumbWrap      = document.getElementById('pdfThumbWrap');
            const previewName       = document.getElementById('previewName');
            const previewMeta       = document.getElementById('previewMeta');
            const clearFileBtn      = document.getElementById('clearFileBtn');
            const compressBtn       = document.getElementById('compressBtn');
            const progressArea      = document.getElementById('progressArea');
            const progressBar       = document.getElementById('progressBar');
            const progressMsg       = document.getElementById('progressMsg');
            const downloadContainer = document.getElementById('downloadContainer');
            const downloadLink      = document.getElementById('downloadLink');
            const sizeReport        = document.getElementById('sizeReport');
            const errorArea         = document.getElementById('errorArea');
            const errorMsgEl        = document.getElementById('errorMsg');

            let currentFile    = null;
            let pdfJsDoc       = null;
            let activeBlobUrl  = null;
            let abortCtrl      = null;   


            const fmtBytes = b =>
            b < 1024           ? b + ' B'
            : b < 1024 * 1024  ? (b / 1024).toFixed(1) + ' KB'
            :                    (b / (1024 * 1024)).toFixed(2) + ' MB';

            function setProgress(pct, msg) {
            progressBar.style.width = pct + '%';
            if (msg) progressMsg.textContent = msg;
            progressArea.style.display = 'block';
            }

            function hideProgress()  { progressArea.style.display = 'none'; progressBar.style.width = '0%'; }
            function clearError()    { errorArea.classList.add('d-none'); }
            function showError(msg)  { errorMsgEl.textContent = msg; errorArea.classList.remove('d-none'); }

            async function generateThumbnail(pdfDoc) {
            try {
            const page     = await pdfDoc.getPage(1);
            const viewport = page.getViewport({ scale: 0.35 });
            const canvas   = document.createElement('canvas');
            canvas.width   = Math.floor(viewport.width);
            canvas.height  = Math.floor(viewport.height);
            await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;
            const img      = document.createElement('img');
            img.src        = canvas.toDataURL('image/jpeg', 0.75);
            img.alt        = 'PDF preview';
            img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block;';
            pdfThumbWrap.innerHTML = '';
            pdfThumbWrap.appendChild(img);
            } catch {

            }
            }


            async function loadFile(file) {
            if (!file) return;
            if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
            showError('Please select a valid PDF file.');
            return;
            }
            const maxBytes = 50 * 1024 * 1024;
            if (file.size > maxBytes) {
            showError('File exceeds the 50 MB limit.');
            return;
            }

            clearError();
            hideProgress();
            downloadContainer.style.display = 'none';
            if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }

            currentFile = file;
            previewName.textContent = file.name;
            previewMeta.textContent = fmtBytes(file.size) + ' · loading…';
            pdfThumbWrap.innerHTML  =
            '<div class="spinner-border spinner-border-sm text-secondary" role="status" aria-label="Loading"></div>';
            filePreviewCard.classList.remove('d-none');
            compressBtn.disabled = true;

            try {
            const ab = await file.arrayBuffer();
            pdfJsDoc = await pdfjsLib.getDocument({ data: ab }).promise;
            const n  = pdfJsDoc.numPages;
            previewMeta.textContent = fmtBytes(file.size) + ' · ' + n + ' page' + (n !== 1 ? 's' : '');
            await generateThumbnail(pdfJsDoc);
            compressBtn.disabled = false;
            } catch (e) {
            showError('Could not read PDF: ' + e.message);
            filePreviewCard.classList.add('d-none');
            currentFile = null;
            pdfJsDoc    = null;
            }
            }


            function clearFile() {
            if (abortCtrl) { abortCtrl.abort(); abortCtrl = null; }
            currentFile = null;
            pdfJsDoc    = null;
            fileInput.value = '';
            filePreviewCard.classList.add('d-none');
            pdfThumbWrap.innerHTML =
            '<i class="bi bi-file-earmark-pdf text-danger" style="font-size:1.8rem;"></i>';
            compressBtn.disabled = true;
            hideProgress();
            downloadContainer.style.display = 'none';
            clearError();
            if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }
            }


            dropZone.addEventListener('click', () => fileInput.click());

            dropZone.addEventListener('dragover', e => {
            e.preventDefault();
            dropZone.style.backgroundColor = '#e9ecef';
            dropZone.style.borderColor     = '#0d6efd';
            });
            dropZone.addEventListener('dragleave', () => {
            dropZone.style.backgroundColor = '#f8f9fa';
            dropZone.style.borderColor     = '';
            });
            dropZone.addEventListener('drop', e => {
            e.preventDefault();
            dropZone.style.backgroundColor = '#f8f9fa';
            dropZone.style.borderColor     = '';
            if (e.dataTransfer.files[0]) loadFile(e.dataTransfer.files[0]);
            });

            fileInput.addEventListener('change', () => { if (fileInput.files[0]) loadFile(fileInput.files[0]); });
            clearFileBtn.addEventListener('click', clearFile);


            compressBtn.addEventListener('click', async () => {
            if (!currentFile) { showError('Please select a PDF file first.'); return; }

            clearError();
            downloadContainer.style.display = 'none';
            if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }


            compressBtn.disabled = true;
            compressBtn.innerHTML =
            '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Compressing…';
            setProgress(10, 'Uploading PDF to server…');

            const level = document.querySelector('input[name="compressionLevel"]:checked').value;


            const formData = new FormData();
            formData.append('file', currentFile);
            formData.append('compressionLevel', level);

            abortCtrl = new AbortController();

            try {

            const compressedBytes = await uploadWithProgress(formData, abortCtrl.signal);



            } catch (err) {
            if (err.name === 'AbortError') return;   
            showError(err.message || 'Compression failed. Please try again.');
            hideProgress();
            } finally {
            abortCtrl    = null;
            compressBtn.disabled = false;
            compressBtn.innerHTML = '<i class="bi bi-speedometer2 me-2"></i>Compress PDF';
            }
            });


            function uploadWithProgress(formData, signal) {
            return new Promise((resolve, reject) => {
            const xhr = new XMLHttpRequest();


            signal.addEventListener('abort', () => xhr.abort(), { once: true });


            xhr.upload.addEventListener('progress', e => {
            if (e.lengthComputable) {
            const pct = Math.round((e.loaded / e.total) * 60);
            setProgress(pct, `Uploading… ${fmtBytes(e.loaded)} / ${fmtBytes(e.total)}`);
            }
            });

            xhr.addEventListener('load', () => {
            if (xhr.status >= 200 && xhr.status < 300) {
            setProgress(90, 'Processing on server…');


            const origSize   = parseInt(xhr.getResponseHeader('X-Original-Size')   || '0', 10);
            const compSize   = parseInt(xhr.getResponseHeader('X-Compressed-Size') || '0', 10);
            const reduction  = parseFloat(xhr.getResponseHeader('X-Reduction-Pct') || '0');
            const method     = xhr.getResponseHeader('X-Compression-Method')        || '';


            const blob      = new Blob([xhr.response], { type: 'application/pdf' });
            activeBlobUrl   = URL.createObjectURL(blob);

            const baseName  = currentFile.name.replace(/\.pdf$/i, '');
            downloadLink.href     = activeBlobUrl;
            downloadLink.download = baseName + '_compressed.pdf';

            if (origSize && compSize) {
            if (reduction > 0) {
            sizeReport.textContent =
            `Reduced from ${fmtBytes(origSize)} → ${fmtBytes(compSize)} ` +
            `(${reduction.toFixed(1)}% smaller)`;
            } else {
            sizeReport.textContent =
            `${fmtBytes(origSize)} → ${fmtBytes(compSize)} ` +
            `(PDF is already well-optimised)`;
            }
            } else {
            sizeReport.textContent = 'Compression complete — click below to download.';
            }

            setProgress(100, 'Done!');
            downloadContainer.style.display = 'block';


            setTimeout(() => {
            if (activeBlobUrl) { URL.revokeObjectURL(activeBlobUrl); activeBlobUrl = null; }
            }, 600_000);

            resolve();
            } else {

            let msg = `Server error (${xhr.status})`;
            try {
            const json = JSON.parse(xhr.responseText);
            if (json.error) msg = json.error;
            } catch { }
            reject(new Error(msg));
            }
            });

            xhr.addEventListener('error',  () => reject(new Error('Network error — please check your connection.')));
            xhr.addEventListener('abort',  () => reject(Object.assign(new Error('Aborted'), { name: 'AbortError' })));
            xhr.addEventListener('timeout',() => reject(new Error('Request timed out.')));

            xhr.open('POST', '/PDF/Compress');
            xhr.responseType = 'arraybuffer';
            xhr.timeout      = 5 * 60 * 1000;  



            xhr.send(formData);
            });
            }

            })();
        </script>
    }
