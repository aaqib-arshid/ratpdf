    <script>
         $('#rotatePdfForm').on('submit', function (e) {
         e.preventDefault();
         showLoader('Getting Ready...');
         setTimeout(function () {
                 showLoader('Processing...');;
         }, 3000);
         setTimeout(function () {
                submitWithLoader('rotatePdfForm', 'Downloading...');
         }, 5000);
        });
         $('#removePdfForm').on('submit', function (e) {
         e.preventDefault();
         showLoader('Getting Ready...');
