@{
    ViewData["Title"] = "Rotate Or Remove Pages Of PDF Online Free";
    ViewData["Description"] = "Rotate or Remove Pages by index inside PDF online for free. Fast and secure PDF editor.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%;">
        <div class="card-body text-center">
            <h2 class="fw-bold mb-3">Rotate/Remove</h2>
            <p class="text-muted mb-4">Upload a PDF and perform edits: add text, add image, rotate, or remove pages.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="RotatePage" method="post" enctype="multipart/form-data" class="mb-3">
                <input type="file" name="file" class="form-control mb-2">
                <input type="number" name="pageNumber" class="form-control mb-2" placeholder="Page number (0-indexed)">
                <input type="number" name="degree" class="form-control mb-2" placeholder="Degree (90, 180, 270)">
                <button type="submit" class="btn btn-primary w-100">Rotate Page</button>
            </form>

            <form asp-action="RemovePage" method="post" enctype="multipart/form-data" class="mb-3">
                <input type="file" name="file" class="form-control mb-2">
                <input type="number" name="pageNumber" class="form-control mb-2" placeholder="Page number (0-indexed)">
                <button type="submit" class="btn btn-danger w-100">Remove Page</button>
            </form>
        </div>
    </div>
</div>
<section class="related-tools">
  <h3>Related Tools</h3>
  <ul>
    <li><a href="/PDF/Split">Split PDF</a></li>
    <li><a href="/PDF/Merge">Merge PDF</a></li>
    <li><a href="/PDF/Compress">Compress PDF</a></li>
  </ul>
</section>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Rotate or Remove Pages from PDF Online</h2>

        <p>
            Our free PDF editor lets you rotate pages by 90°, 180°, or 270°, or remove specific pages
            from your PDF documents quickly and securely. No software installation or registration is required.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> using the upload buttons above.
            </li>
            <li>
                <strong>Rotate a page:</strong> Enter the 0-indexed page number and rotation degree (90, 180, 270), then click “Rotate Page.”
            </li>
            <li>
                <strong>Remove a page:</strong> Enter the 0-indexed page number and click “Remove Page.”
            </li>
            <li>
                <strong>Download your updated PDF</strong> instantly after editing.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Page Editor?</h3>
        <ul>
            <li>✔ Rotate or remove PDF pages online for free</li>
            <li>✔ Fast and secure page-level editing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No account or software installation needed</li>
            <li>✔ Ideal for reports, scanned documents, and presentations</li>
        </ul>

        <p class="mt-3">
            This tool is perfect for rearranging PDF documents, correcting page orientation,
            or removing unwanted pages from contracts, reports, and eBooks.
        </p>
    </div>
</div>
