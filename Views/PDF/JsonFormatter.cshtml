    <!-- Prism.js and dependencies -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"></script>

    <script>
        // DOM elements
        const jsonInput = document.getElementById("jsonInput");
        const outputDiv = document.getElementById("jsonOutput");
        const errorBox = document.getElementById("errorBox");
        const beautifyBtn = document.getElementById("beautifyBtn");
        const minifyBtn = document.getElementById("minifyBtn");
        const copyBtn = document.getElementById("copyBtn");
        const clearBtn = document.getElementById("clearBtn");

        let currentRawOutput = ""; // Stores raw JSON (pretty or minified)

        // Helper: Show colored JSON inside output div
        function displayColoredJson(rawJsonString) {
            if (!rawJsonString) {
                outputDiv.innerHTML = '<pre><code class="language-json">← Formatted JSON will appear here with colors →</code></pre>';
                // re-highlight placeholder
                const codeElem = outputDiv.querySelector('code');
                if (codeElem) Prism.highlightElement(codeElem);
                return;
            }

            const container = document.createElement('div');
            const pre = document.createElement('pre');
            const code = document.createElement('code');
            code.className = 'language-json';
            code.textContent = rawJsonString;
            pre.appendChild(code);
            container.appendChild(pre);
            Prism.highlightElement(code);
            outputDiv.innerHTML = '';
            outputDiv.appendChild(pre);
            pre.style.margin = '0';
            pre.style.background = 'transparent';
            pre.style.whiteSpace = 'pre-wrap';
            pre.style.wordBreak = 'break-word';
        }

        // Show toast notification
        function showToast(message, isError = false) {
            let toast = document.querySelector('.json-toast');
            if (toast) toast.remove();
            toast = document.createElement('div');
            toast.className = 'json-toast' + (isError ? ' error' : '');
            toast.innerText = message;
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '1'; }, 10);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        // Beautify JSON
        function beautifyJson() {
            errorBox.classList.add("d-none");
            errorBox.innerText = "";
            try {
                const parsed = JSON.parse(jsonInput.value);
                const pretty = JSON.stringify(parsed, null, 2);
                currentRawOutput = pretty;
                displayColoredJson(pretty);
            } catch (error) {
                errorBox.innerText = "Invalid JSON: " + error.message;
                errorBox.classList.remove("d-none");
                displayColoredJson("");
                currentRawOutput = "";
            }
        }

        // Minify JSON
        function minifyJson() {
            errorBox.classList.add("d-none");
            errorBox.innerText = "";
            try {
                const parsed = JSON.parse(jsonInput.value);
                const minified = JSON.stringify(parsed);
                currentRawOutput = minified;
                displayColoredJson(minified);
            } catch (error) {
                errorBox.innerText = "Invalid JSON: " + error.message;
                errorBox.classList.remove("d-none");
                displayColoredJson("");
                currentRawOutput = "";
            }
        }

        // Copy with toast
        function copyOutput() {
            if (currentRawOutput && currentRawOutput.trim()) {
                navigator.clipboard.writeText(currentRawOutput)
                    .then(() => showToast("✓ Copied to clipboard!"))
                    .catch(() => showToast("❌ Copy failed", true));
            } else {
                // Try to get from output div if no currentRawOutput (e.g., after clear but maybe user formatted? but currentRawOutput is set on beautify/minify)
                // fallback: if output div has some text, extract it.
                const codeElem = outputDiv.querySelector('code');
                if (codeElem && codeElem.textContent && codeElem.textContent !== "← Formatted JSON will appear here with colors →") {
                    const text = codeElem.textContent;
                    navigator.clipboard.writeText(text)
                        .then(() => showToast("✓ Copied to clipboard!"))
                        .catch(() => showToast("❌ Copy failed", true));
                } else {
                    showToast("⚠️ Nothing to copy. Format or minify JSON first.", true);
                }
            }
        }

        // Clear all
        function clearAll() {
            jsonInput.value = "";
            errorBox.classList.add("d-none");
            errorBox.innerText = "";
            currentRawOutput = "";
            displayColoredJson("");
        }

        // Event listeners
        beautifyBtn.addEventListener("click", beautifyJson);
        minifyBtn.addEventListener("click", minifyJson);
        copyBtn.addEventListener("click", copyOutput);
        clearBtn.addEventListener("click", clearAll);

        // Optional: sample demo on load
        if (!jsonInput.value.trim()) {
            jsonInput.value = `{
  "name": "JSON Formatter",
  "features": ["beautify", "minify", "validate", "color output"],
  "free": true,
  "author": "RatPDF"
}`;
            beautifyJson();
        }
    </script>

}