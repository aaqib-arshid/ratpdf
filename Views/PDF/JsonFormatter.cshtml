@{
    ViewData["Title"] = "JSON Formatter & Validator Online Free";
    ViewData["Description"] = "Format, beautify, validate, and minify JSON online for free. Fast, secure, and browser-based JSON formatter tool.";
}

<head>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="json formatter, json beautifier, json validator, format json online, minify json free" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/PDF/JsonFormatter" />
</head>

<div class="container py-5">
    <div class="card shadow-lg p-4" style="border-radius:15px;">
        <div class="card-body">

            <div class="text-center mb-4">
                <img src="~/images/ratpdf-logo.png" height="60" class="mb-3" />
                <h2 class="fw-bold">JSON Formatter & Validator</h2>
                <p class="text-muted">
                    Beautify, validate, and minify JSON instantly.
                </p>
            </div>

            <!-- Input -->
            <label class="fw-bold">Paste JSON:</label>
            <textarea id="jsonInput" class="form-control mb-3" rows="8"
                      placeholder='Example: { "name": "John", "age": 30 }'></textarea>

            <!-- Buttons -->
            <div class="d-grid gap-2 d-md-flex justify-content-md-between mb-3">
                <button class="btn btn-primary" onclick="beautifyJson()">Beautify</button>
                <button class="btn btn-warning" onclick="minifyJson()">Minify</button>
                <button class="btn btn-success" onclick="copyOutput()">Copy</button>
                <button class="btn btn-outline-secondary" onclick="clearAll()">Clear</button>
            </div>

            <!-- Error Box -->
            <div id="errorBox" class="alert alert-danger d-none"></div>

            <!-- Output -->
            <label class="fw-bold">Output:</label>
            <textarea id="jsonOutput" class="form-control" rows="10"
                      placeholder="Formatted JSON will appear here..."></textarea>

        </div>
    </div>

    <!-- SEO Content -->
    <div class="mt-5">
        <h3>How to Use JSON Formatter?</h3>
        <ol>
            <li>Paste your JSON into the input field.</li>
            <li>Click “Beautify” to format and validate.</li>
            <li>Click “Minify” to compress JSON.</li>
            <li>Copy the result instantly.</li>
        </ol>

        <h3>Features</h3>
        <ul>
            <li>Instant JSON validation</li>
            <li>Error detection with clear message</li>
            <li>Fast browser-based processing</li>
            <li>No server storage</li>
        </ul>
    </div>
</div>

@section Scripts {

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "JSON Formatter & Validator",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Web",
          "url": "https://ratpdf.com/PDF/JsonFormatter",
          "description": "Free online JSON formatter and validator tool to beautify, validate, and minify JSON instantly.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "creator": {
            "@@type": "Organization",
            "name": "RatPDF",
            "url": "https://ratpdf.com"
          }
        }
    </script>

    <script>
        function beautifyJson() {
            const input = document.getElementById("jsonInput").value;
            const errorBox = document.getElementById("errorBox");
            const output = document.getElementById("jsonOutput");

            errorBox.classList.add("d-none");
            errorBox.innerText = "";

            try {
                const parsed = JSON.parse(input);
                output.value = JSON.stringify(parsed, null, 2);
            } catch (error) {
                errorBox.innerText = "Invalid JSON: " + error.message;
                errorBox.classList.remove("d-none");
                output.value = "";
            }
        }

        function minifyJson() {
            const input = document.getElementById("jsonInput").value;
            const errorBox = document.getElementById("errorBox");
            const output = document.getElementById("jsonOutput");

            errorBox.classList.add("d-none");
            errorBox.innerText = "";

            try {
                const parsed = JSON.parse(input);
                output.value = JSON.stringify(parsed);
            } catch (error) {
                errorBox.innerText = "Invalid JSON: " + error.message;
                errorBox.classList.remove("d-none");
                output.value = "";
            }
        }

        function copyOutput() {
            const output = document.getElementById("jsonOutput");
            navigator.clipboard.writeText(output.value)
                .then(() => alert("Copied to clipboard!"))
                .catch(() => alert("Copy failed"));
        }

        function clearAll() {
            document.getElementById("jsonInput").value = "";
            document.getElementById("jsonOutput").value = "";
            document.getElementById("errorBox").classList.add("d-none");
        }
    </script>

}