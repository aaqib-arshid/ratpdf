@{
    ViewData["Title"] = "Merge PDFs online free";
    ViewData["Description"] = "Merge multiple PDFs online for free. Fast and secure PDF merger tool.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Merge PDFs</h2>
            <p class="text-muted mb-4">Upload two or more PDF files to merge them into a single document.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Merge" method="post" enctype="multipart/form-data" id="mergeForm">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop PDFs here or click to select</p>
                        <input type="file" name="files" multiple class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <!-- Preview Selected Files -->
                <ul id="preview" class="list-group list-group-flush mb-3"></ul>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i> Merge PDFs
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Merge PDF Files Online</h2>

        <p>
            Our free PDF merger allows you to combine multiple PDF files into a single document
            quickly and securely. No software installation or registration is required.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload two or more PDF files</strong> by dragging and dropping them into the upload area
                or selecting them from your device.
            </li>
            <li>
                <strong>Arrange files automatically</strong> in the order they are uploaded.
            </li>
            <li>
                <strong>Click “Merge PDFs”</strong> to combine your files into one PDF.
            </li>
            <li>
                <strong>Download the merged PDF</strong> instantly once processing is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Merger?</h3>
        <ul>
            <li>✔ Merge PDF files online for free</li>
            <li>✔ No watermark or quality loss</li>
            <li>✔ Secure file handling and privacy protection</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No account or software download needed</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for combining reports, invoices, contracts, scanned documents,
            and multiple PDFs into one organized file.
        </p>
    </div>
</div>
@section Scripts {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SoftwareApplication",
  "name": "Merge PDF Files Online",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "url": "https://ratpdf.com/PDF/Merge",
  "description": "Combine multiple PDF files into one document online for free. Quick and secure PDF merging.",
  "offers": {
    "@@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
    <!-- FAQ JSON-LD -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "How do I merge PDF files online?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Upload two or more PDF files using the drag & drop area or select them from your device, then click 'Merge PDFs' to combine them into a single PDF."
              }
            },
            {
              "@@type": "Question",
              "name": "Is merging PDFs free?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, our PDF merger is completely free to use with no watermarks or restrictions."
              }
            },
            {
              "@@type": "Question",
              "name": "Do I need to register or install software?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "No registration or software download is required; the tool works entirely in your browser."
              }
            },
            {
              "@@type": "Question",
              "name": "Are my files secure?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, file processing is secure and private. Files are handled temporarily and are not stored permanently on our servers."
              }
            },
            {
              "@@type": "Question",
              "name": "Can I merge PDFs on any device?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, the PDF merger works on Windows, Mac, Android, and iOS devices directly in the browser."
              }
            }
          ]
        }
    </script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const preview = document.getElementById('preview');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            showPreview();
        });

        fileInput.addEventListener('change', showPreview);

        function showPreview() {
            preview.innerHTML = '';
            const files = fileInput.files;
            for (let i = 0; i < files.length; i++) {
                if (files[i].type !== 'application/pdf') continue;
                const li = document.createElement('li');
                li.className = 'list-group-item d-flex justify-content-between align-items-center';
                li.textContent = files[i].name;
                preview.appendChild(li);
            }
        }
    </script>
}