@using ratpdf.Constants
@{
    ViewData["Title"] = "Merge PDF Online Free — Combine PDF Files | RatPDF";
    ViewData["Description"] = "Merge PDF files online free. Combine multiple PDFs into one document without losing quality. Secure, fast, up to 4 GB on Pro.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/PDF/Merge");
    ViewData["PdfToolId"] = "merge";
}

<div class="container py-4 py-md-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-4 p-md-5 rp-legacy-tool-card" style="max-width: 600px; width: 100%;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h1 class="fw-bold mb-2">Merge PDFs</h1>
            <p class="text-muted mb-2">Combine multiple PDFs into one document — free, secure, no signup.</p>
            @await Html.PartialAsync("_PdfToolUsageBadge")
            @await Html.PartialAsync("_PdfToolTrustPills")

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Merge" method="post" enctype="multipart/form-data" id="mergeForm" data-pdf-tool="merge">
                <div class="mb-3">
                    <div id="dropZone" class="rp-dropzone border border-dashed rounded p-4 mb-3">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag &amp; drop PDFs here or tap to select</p>
                        <input type="file" name="files" multiple class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                @await Html.PartialAsync("_PdfFilePreviewCard")
                <p id="limitHint" class="text-muted small text-start mb-2"></p>
                <div id="errorArea" class="alert alert-danger d-none text-start" role="alert"></div>
                @await Html.PartialAsync("_PdfProgressBar")

                <button type="submit" class="btn btn-primary btn-lg w-100 rp-tool-primary-btn" disabled>
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i> Merge &amp; download PDF
                </button>
                @await Html.PartialAsync("_PdfSubmitHint")
            </form>
            @await Html.PartialAsync("_PdfToolTrustFooter")
        </div>
    </div>
</div>
@await Html.PartialAsync("_PdfToolInternalLinks")
