@section Scripts {
    <script>
        let mergeLimits = { maxFiles: 10, maxSizeBytes: 10 * 1024 * 1024, maxTotalBytes: 100 * 1024 * 1024, maxTotalBatchLabel: '100 MB combined' };

        async function loadLimits() {
            const access = await PdfToolkit.checkToolAccess('merge');
            mergeLimits = {
                maxFiles: access.maxBatchFiles || 10,
                maxSizeBytes: access.maxFileSizeBytes || mergeLimits.maxSizeBytes,
                maxTotalBytes: access.maxTotalBatchBytes || null,
                maxTotalBatchLabel: access.maxTotalBatchLabel || null,
            };
            const hint = document.getElementById('limitHint');
            if (hint) {
                if (access.isPremium && mergeLimits.maxTotalBatchLabel) {
                    hint.textContent = `2–${mergeLimits.maxFiles} PDFs · up to ${mergeLimits.maxTotalBatchLabel} · ${access.maxFileSizeLabel || '100 MB'} per file`;
                } else {
                    hint.textContent = `2–${mergeLimits.maxFiles} PDFs · ${access.maxFileSizeLabel || PdfToolkit.fmtBytes(mergeLimits.maxSizeBytes)} per file · ${mergeLimits.maxTotalBatchLabel || '100 MB combined'} (Pro: up to 40 PDFs, 100 MB each)`;
                }
            }
        }
        loadLimits();

        $('#mergeForm').on('submit', function (e) {
            e.preventDefault();
            const fileInput = document.getElementById('fileInput');
            const v = PdfToolkit.validatePdfFiles(fileInput.files, { ...mergeLimits, multiple: true });
            if (!v.ok || v.files.length < 2) {
                const err = document.getElementById('errorArea');
                if (err) {
                    err.textContent = v.ok ? 'Please select at least 2 PDF files.' : v.error;
                    err.classList.remove('d-none');
                }
                return;
            }
            submitWithLoader('mergeForm', 'Merging…', 'merged.pdf');
        });
    </script>
}