@{
    ViewData["Title"] = "Add Password to Pdf files free online";
    ViewData["Description"] = "Protect and add password to your PDFs online for free. Fast and secure.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Add Password Protection</h2>
            <p class="text-muted mb-4">Upload a PDF and protect it with a password.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Password" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="file" name="file" class="form-control" accept="application/pdf">
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="form-control" placeholder="Enter Password">
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-shield-lock-fill me-2"></i> Protect PDF
                </button>
            </form>
        </div>
    </div>
</div>
<section class="related-tools">
    <h3>Related Tools</h3>
    <ul>
        <li><a href="/PDF/Watermark">Add Watermark</a></li>
        <li><a href="/PDF/Compress">Compress PDF</a></li>
        <li><a href="/PDF/Merge">Merge PDF</a></li>
    </ul>
</section>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Add a Password to a PDF Online</h2>

        <p>
            Our free PDF password protection tool allows you to secure your PDF files by adding
            a password online. Protect sensitive documents from unauthorized access in just a few clicks.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> using the file upload option above.
            </li>
            <li>
                <strong>Enter a strong password</strong> to protect your PDF document.
            </li>
            <li>
                <strong>Click “Protect PDF”</strong> to apply password protection.
            </li>
            <li>
                <strong>Download your secured PDF</strong> instantly after processing.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Password Protection Tool?</h3>
        <ul>
            <li>✔ Add password protection to PDF files for free</li>
            <li>✔ Keep confidential documents safe and private</li>
            <li>✔ Fast and secure online processing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No registration or software installation required</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for securing contracts, invoices, bank statements,
            resumes, and confidential PDF documents.
        </p>
    </div>
</div>
@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "Password Protect PDF",
          "applicationCategory": "UtilityApplication",
          "operatingSystem": "Web",
          "url": "https://ratpdf.com/PDF/Password",
          "description": "Secure your PDF files with a password online. Easy and free PDF protection tool.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
    </script>
    <!-- FAQ JSON-LD -->
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
            {
              "@@type": "Question",
              "name": "How do I add a password to a PDF online?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Upload your PDF file using the upload option, enter a strong password, then click 'Protect PDF' to secure your document."
              }
            },
            {
              "@@type": "Question",
              "name": "Is adding a password to a PDF free?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, this PDF password protection tool is completely free to use with no hidden fees or watermarks."
              }
            },
            {
              "@@type": "Question",
              "name": "Do I need to install software or register?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "No, you can protect your PDF entirely in the browser without installing anything or creating an account."
              }
            },
            {
              "@@type": "Question",
              "name": "Are my PDFs secure?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, the tool processes files securely online and does not store them permanently."
              }
            },
            {
              "@@type": "Question",
              "name": "Can I add passwords on any device?",
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": "Yes, it works on Windows, Mac, Android, and iOS devices directly in your browser."
              }
            }
          ]
        }
    </script>
}