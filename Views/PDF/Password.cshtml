@{
    ViewData["Title"] = "Add Password to Pdf files free online";
    ViewData["Description"] = "Protect and add password to your PDFs online for free. Fast and secure.";
    ViewData["PdfToolId"] = "password";
}

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h1 class="fw-bold mb-3">Add Password Protection</h1>
            <p class="text-muted mb-2">Upload a PDF and protect it with a password.</p>
            @await Html.PartialAsync("_PdfToolUsageBadge")
            @await Html.PartialAsync("_PdfToolTrustPills")

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Password" method="post" enctype="multipart/form-data" id="pdfProtectForm" data-pdf-tool="password">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop PDF here or click to select</p>
                        <input type="file" name="file" id="fileInput" class="d-none" accept="application/pdf">
                    </div>
                </div>
                @await Html.PartialAsync("_PdfFilePreviewCard")
                <div class="mb-3">
                    <input type="password" name="password" class="form-control" placeholder="Enter Password">
                </div>
                <div id="errorArea" class="alert alert-danger d-none text-start" role="alert"></div>
                @await Html.PartialAsync("_PdfProgressBar")
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-shield-lock-fill me-2"></i> Protect PDF
                </button>
            </form>
            @await Html.PartialAsync("_PdfToolTrustFooter")
        </div>
    </div>
    </div>
@await Html.PartialAsync("_PdfToolInternalLinks")
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h1 class="fw-bold mb-3">How to Add a Password to a PDF Online</h1>

        <p>
            Protecting your PDF files from unauthorized access is essential in today’s digital world. Whether you’re sharing sensitive business reports, financial statements, contracts, or personal documents, adding a password ensures that only authorized people can access your files. Our <strong>PDF password protection tool online</strong> makes it quick, safe, and completely free to secure your PDFs without installing any software or creating an account.
