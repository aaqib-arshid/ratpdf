@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.PdfToImages, ViewData);
    ViewData["ToolTitle"] = "PDF to Images";
    ViewData["ToolSubtitle"] = "Export every page as PNG in a ZIP archive";
    ViewData["AcceptHint"] = "PDF files";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-images";
    ViewData["BtnLabel"] = "Export Images";
}
@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
PdfToolkit.initJobTool({ toolId: 'pdftoimages', convertUrl: '/PDF/PdfToImages', extensions: ['.pdf'], typeLabel: 'PDF', multiple: false, defaultFileName: 'pages.zip', dropZoneId: 'dropZone', fileInputId: 'fileInput', fileListId: 'fileList', convertBtnId: 'convertBtn', errorAreaId: 'errorArea', progressAreaId: 'progressArea', progressBarId: 'progressBar', progressMsgId: 'progressMsg', progressPctId: 'progressPct', badgeId: 'usageBadge', limitHintId: 'limitHint' });
</script>
}
