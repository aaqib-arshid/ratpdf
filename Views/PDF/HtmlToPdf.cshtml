@using ratpdf.Constants
@{
    ViewData["Title"] = "HTML to PDF Converter Online Free — Web Page to PDF | RatPDF";
    ViewData["Description"] = "Convert HTML to PDF online. Paste full HTML with CSS, upload .html files, or edit markup directly. iText html2pdf engine — free 200 MB, Pro 4 GB.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/pdf/htmltopdf");
    ViewData["PdfToolId"] = "htmltopdf";
    ViewData["OgImage"] = PdfToolSeo.OgImageForToolId("htmltopdf");
    ViewData["SeoH1"] = "HTML to PDF — Convert Web Pages & Markup to PDF";
    ViewData["SeoLead"] = "Turn HTML snippets, email templates, or full .html files into print-ready PDFs — styles, tables, and page breaks preserved.";
}

@await Html.PartialAsync("_PdfToolBreadcrumbs")

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 900px; width: 100%; border-radius: 15px;">
        <div class="card-body">
            <div class="text-center text-md-start mb-3">
                @await Html.PartialAsync("_PdfToolTrustPills")
                <h1 class="h2 fw-bold mb-1">@ViewData["SeoH1"]</h1>
                <p class="text-muted mb-2">@ViewData["SeoLead"]</p>
                @await Html.PartialAsync("_PdfToolUsageBadge")
            </div>

            <form asp-action="HtmlToPdf" method="post" enctype="multipart/form-data" id="htmlForm" data-pdf-tool="htmltopdf">
                <div id="dropZone" class="border border-dashed rounded p-4 mb-3 text-center" style="cursor:pointer;background:#f8f9fa;">
                    <i class="bi bi-filetype-html display-5 text-primary"></i>
                    <p class="mb-0 text-muted mt-2">Drag &amp; drop an .html file or click to browse</p>
                    <input type="file" name="file" class="d-none" id="fileInput" accept=".html,.htm,text/html">
                </div>

                <label class="form-label fw-semibold" for="rawHtmlInput">Paste or edit raw HTML</label>
                <p class="small text-muted mb-2">
                    Include <code>&lt;style&gt;</code>, tables, SVG, and <code>page-break</code> rules — full documents are sent to the PDF engine as-is (not stripped like a visual editor).
                </p>
                <textarea id="rawHtmlInput" class="form-control font-monospace mb-2" rows="18" spellcheck="false"
                          placeholder="<!DOCTYPE html>&#10;<html>&#10;  <head>&#10;    <style>body { font-family: Arial; }</style>&#10;  </head>&#10;  <body>&#10;    <h1>Hello PDF</h1>&#10;  </body>&#10;</html>"
                          style="font-size:0.85rem;line-height:1.45;resize:vertical;"></textarea>
                <input type="hidden" name="htmlContent" id="htmlContent" />

                <div id="errorArea" class="alert alert-danger d-none mt-3" role="alert"></div>
                @await Html.PartialAsync("_PdfProgressBar")

                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Convert HTML to PDF
                </button>
            </form>
            @await Html.PartialAsync("_PdfToolTrustFooter")
        </div>
    </div>
</div>

@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")

@section Scripts {
    <script>
        (function () {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const rawHtmlInput = document.getElementById('rawHtmlInput');
            const htmlContent = document.getElementById('htmlContent');
            const errorArea = document.getElementById('errorArea');

            function showError(msg) {
                errorArea.textContent = msg;
                errorArea.classList.remove('d-none');
            }

            function clearError() {
                errorArea.classList.add('d-none');
            }

            async function loadFileIntoEditor(file) {
                if (!file) return;
                try {
                    rawHtmlInput.value = await file.text();
                    clearError();
                } catch {
                    showError('Could not read the HTML file.');
                }
            }

            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', e => {
                e.preventDefault();
                dropZone.classList.add('border-primary');
            });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-primary'));
            dropZone.addEventListener('drop', async e => {
                e.preventDefault();
                dropZone.classList.remove('border-primary');
                const f = e.dataTransfer.files?.[0];
                if (!f) return;
                const dt = new DataTransfer();
                dt.items.add(f);
                fileInput.files = dt.files;
                await loadFileIntoEditor(f);
            });

            fileInput.addEventListener('change', () => loadFileIntoEditor(fileInput.files?.[0]));

            document.getElementById('htmlForm').addEventListener('submit', async function (e) {
                e.preventDefault();
                clearError();

                let html = rawHtmlInput.value.trim();
                const file = fileInput.files?.[0];

                if (!html && file) {
                    try {
                        html = (await file.text()).trim();
                    } catch {
                        showError('Could not read the HTML file.');
                        return;
                    }
                }

                if (!html || html === '<p><br></p>') {
                    showError('Please paste HTML markup or upload an .html file.');
                    return;
                }

                htmlContent.value = html;
                fileInput.value = '';
                submitWithLoader('htmlForm', 'Rendering HTML to PDF…', 'document.pdf');
            });
        })();
    </script>
}
