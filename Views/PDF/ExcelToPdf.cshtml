    <script>
         $('#xlToPdfForm').on('submit', function (e) {
     e.preventDefault();
     showLoader('Getting Ready...');
     setTimeout(function () {
             showLoader('Processing...');;
     }, 3000);
     setTimeout(function () {
            submitWithLoader('xlToPdfForm', 'Downloading...');
     }, 5000);
    });
    </script>
}