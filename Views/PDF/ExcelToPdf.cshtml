@{
    ViewData["Title"] = "Convert Excel to PDF free online";
    ViewData["Description"] = "Convert Excel to PDF online for free. Fast and secure xls, xlsx, csv to PDF converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>

<div class="container py-5 d-flex justify-content-center">
    <div class="card shadow-lg p-5" style="max-width: 500px; width: 100%;">
        <div class="card-body text-center">
            <h2 class="fw-bold mb-3">Convert Excel to PDF</h2>
            <p class="text-muted mb-4">
                Upload an Excel file (.xlsx) and convert it into a PDF document.
            </p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="ExcelToPdf" method="post" enctype="multipart/form-data">
                <input type="file" name="file" class="form-control mb-3"
                       accept=".xlsx,.xls">
                <button type="submit" class="btn btn-primary w-100">
                    Convert to PDF
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Convert Excel to PDF Online</h2>

        <p>
            Our free Excel to PDF converter allows you to convert Excel spreadsheets into
            high-quality PDF files online. All tables, rows, columns, and formatting are preserved
            during conversion.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your Excel file</strong> (.XLS or .XLSX) using the file upload button.
            </li>
            <li>
                <strong>Click “Convert to PDF”</strong> to start the Excel to PDF conversion.
            </li>
            <li>
                <strong>Download your PDF</strong> instantly after conversion is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our Excel to PDF Converter?</h3>
        <ul>
            <li>✔ Convert XLS, XLSX, and CSV files to PDF for free</li>
            <li>✔ Preserves spreadsheet layout and formatting</li>
            <li>✔ Secure and private file processing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No registration or software installation required</li>
        </ul>

        <p class="mt-3">
            This tool is perfect for reports, invoices, financial statements, and spreadsheets
            that need to be shared or printed in PDF format.
        </p>
    </div>
</div>
@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "Excel to PDF Converter",
          "applicationCategory": "UtilityApplication",
          "operatingSystem": "Web",
          "url": "https://ratpdf.com/PDF/ExcelToPdf",
          "description": "Convert Excel spreadsheets to PDF online quickly, safely, and for free.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
    </script>
}