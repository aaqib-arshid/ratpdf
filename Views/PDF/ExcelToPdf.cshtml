@using ratpdf.Constants
@{
    ViewData["Title"] = "Excel to PDF Converter Online Free — Print Ready | RatPDF";
    ViewData["Description"] = "Convert XLSX to PDF online with charts, column widths & print layout preserved. LibreOffice engine. Free 200 MB, Pro 4 GB.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/PDF/ExcelToPdf");
    ViewData["PdfToolId"] = "exceltopdf";
    ViewData["ToolTitle"] = "Excel to PDF";
    ViewData["ToolSubtitle"] = "Print layout · multi-sheet · charts";
    ViewData["AcceptHint"] = "XLSX files";
    ViewData["AcceptAttr"] = ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-file-earmark-pdf";
    ViewData["BtnLabel"] = "Convert to PDF";
    ViewData["SeoH1"] = "Excel to PDF — Spreadsheet Layout Preserved";
    ViewData["SeoLead"] = "Export Excel workbooks to professional PDFs with correct column widths, sheet breaks, and print areas.";
}

@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")

@section Scripts {
<script>
PdfToolkit.initJobTool({
    toolId: 'exceltopdf',
    convertUrl: '/PDF/ExcelToPdf/convert',
    extensions: ['.xlsx'],
    typeLabel: 'Excel XLSX',
    multiple: false,
    defaultFileName: 'converted.pdf',
    dropZoneId: 'dropZone',
    fileInputId: 'fileInput',
    fileListId: 'fileList',
    convertBtnId: 'convertBtn',
    errorAreaId: 'errorArea',
    progressAreaId: 'progressArea',
    progressBarId: 'progressBar',
    progressMsgId: 'progressMsg',
    progressPctId: 'progressPct',
    badgeId: 'usageBadge',
    limitHintId: 'limitHint',
});
</script>
}
