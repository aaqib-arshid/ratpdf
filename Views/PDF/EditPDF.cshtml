        }
    </script>
    <script>

        (function () {
            var source = document.getElementById('imported-html-source');
            if (!source) return;

            var html = source.value;
            if (html && html.trim().length > 0) {
                document.getElementById('editor').innerHTML = html;
            }
            source.remove();
        })();

        function execCmd(cmd, value) {
            document.getElementById('editor').focus();
            document.execCommand(cmd, false, value || null);
            updateToolbarState();
        }


        function setFontSize(pt) {
            var sel = window.getSelection();
            if (!sel.rangeCount) return;
            var range = sel.getRangeAt(0);
            if (range.collapsed) return;

            var span = document.createElement('span');
            span.style.fontSize = pt + 'pt';
            try {
                range.surroundContents(span);
            } catch (e) {
                var level = pt <= 10 ? 1 : pt <= 13 ? 2 : pt <= 16 ? 3 :
                            pt <= 18 ? 4 : pt <= 24 ? 5 : pt <= 32 ? 6 : 7;
                document.execCommand('fontSize', false, level);
            }
        }

        function updateToolbarState() {
            ['bold','italic','underline','strikeThrough'].forEach(function(cmd) {
                var btn = document.querySelector('.tb-btn[onclick*="' + cmd + '"]');
                if (btn) btn.classList.toggle('active', document.queryCommandState(cmd));
            });
        }

        document.getElementById('editor').addEventListener('keyup', updateToolbarState);
        document.addEventListener('selectionchange', updateToolbarState);
       
        document.getElementById('imageFileInput').addEventListener('change', function (e) {
            var file = e.target.files[0];
            if (!file) return;

            if (!file.type.startsWith('image/')) {
                showStatus('✗ File is not an image');
                return;
            }

            var reader = new FileReader();

            reader.onload = function (readerEvent) {
                var dataUrl = readerEvent.target.result;
                if (!dataUrl) return;

                var img = document.createElement('img');
                img.src = dataUrl;
                img.style.cssText = 'max-width:100%;height:auto;display:block;margin:8px 0;cursor:pointer;';
                img.alt = file.name;

                var editor   = document.getElementById('editor');
                var sel      = window.getSelection();
                var inserted = false;

                if (sel && sel.rangeCount > 0) {
                    var range = sel.getRangeAt(0);

                    if (editor.contains(range.commonAncestorContainer)) {
                        range.deleteContents();
                        range.insertNode(img);

                        range.setStartAfter(img);
                        range.setEndAfter(img);
                        sel.removeAllRanges();
                        sel.addRange(range);
                        inserted = true;
                    }
                }

                if (!inserted) {
                    editor.appendChild(img);
                }

                e.target.value = '';

                showStatus('✓ Image inserted');

                img.addEventListener('click', function () {
                    sel = window.getSelection();
                    var r = document.createRange();
                    r.selectNode(img);
                    sel.removeAllRanges();
                    sel.addRange(r);
                });
            };

            reader.onerror = function () {
                showStatus('✗ Failed to read image file');
                e.target.value = '';
            };

            reader.readAsDataURL(file);
        });

        function insertImage() {
            var sel = window.getSelection();
            if (sel && sel.rangeCount > 0) {
                window._savedImageRange = sel.getRangeAt(0).cloneRange();
            }
            document.getElementById('imageFileInput').click();
        }

        function handleImageFile(e) {
            var file = e.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (re) {
                document.getElementById('editor').focus();
                var img = '<img src="' + re.result + '" style="max-width:100%;height:auto;" />';
                document.execCommand('insertHTML', false, img);
            };
            reader.readAsDataURL(file);
            e.target.value = '';
        }

        function insertLink() {
            var url = prompt('Enter URL:', 'https://');
            if (url) execCmd('createLink', url);
        }

        function downloadPdf() {
            showStatus('Generating PDF…');

            var innerHtml = document.getElementById('editor').innerHTML;
            showLoader('Downloading...');
            fetch('/PDF/ExportPdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ html: innerHtml })  
            })
            .then(function(res) {
                if (!res.ok) throw new Error('Server error ' + res.status);
                hideLoader();
                return res.blob();
            })
            .then(function(blob) {
                hideLoader();
                var url = window.URL.createObjectURL(blob);
                var a   = document.createElement('a');
                a.href     = url;
                a.download = 'EditedDocument.pdf';
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
                showStatus('✓ PDF downloaded');
            })
            .catch(function(err) {
                hideLoader();
                showStatus('✗ PDF generation failed');
            });
        }

        var statusTimer;
        function showStatus(msg) {
            var el = document.getElementById('status');
            el.textContent = msg;
            el.style.display = 'block';
            clearTimeout(statusTimer);
            statusTimer = setTimeout(function() { el.style.display = 'none'; }, 3000);
        }

        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.key === 's') {
                e.preventDefault();
                downloadPdf();
            }
        });
            document.getElementById('uploadForm').addEventListener('submit', function (e) {
            e.preventDefault();

            showLoader('Getting Ready...');

            setTimeout(function () {
                showLoader('Processing...');
            }, 3000);

            setTimeout(function () {
                submitWithLoader('uploadForm', 'Importing...');
            }, 5000);
        });
    </script>
</body>
</html>