@model ratpdf.Models.PdfEditViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Professional PDF Editor";
    ViewData["Description"] = "Edit PDFs online with in-place text, whiteout, highlights, images, and object-level export. Up to 200 MB per file.";
    ViewData["PdfToolId"] = "editpdf";
    var modelJson = Context.Session.GetString("PdfEditModelJson") ?? "{}";
}
@section Head {
    <link rel="canonical" href="https://ratpdf.com/PDF/EditPDF" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <style>
        .edit-app {
            width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
            background: #e8eaf0; min-height: 85vh;
        }
        .edit-topbar {
            background: #1e293b; color: #fff; padding: 10px 16px;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        }
        .edit-topbar label { color: #94a3b8; font-size: 13px; margin: 0; }
        .edit-topbar .btn { font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 6px; border: none; }
        .edit-topbar .btn-primary { background: #3b82f6; color: #fff; }
        .edit-topbar .btn-success { background: #22c55e; color: #fff; }
        #toolbar {
            background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 6px 12px;
            display: flex; flex-wrap: wrap; align-items: center; gap: 4px;
            position: sticky; top: 0; z-index: 100; box-shadow: 0 1px 4px rgba(0,0,0,.08);
        }
        .tb-group { display: flex; align-items: center; gap: 3px; padding: 0 8px; border-right: 1px solid #cbd5e1; }
        .tb-group:last-child { border-right: none; }
        .tb-btn {
            width: 32px; height: 32px; border: none; background: transparent; border-radius: 4px;
            cursor: pointer; font-size: 14px; color: #334155;
            display: flex; align-items: center; justify-content: center;
        }
        .tb-btn:hover { background: #e2e8f0; }
        .tb-btn.active { background: #bfdbfe; color: #1d4ed8; }
        .tb-select { height: 28px; border: 1px solid #e2e8f0; border-radius: 4px; font-size: 13px; }
        .editor-shell { display: flex; min-height: calc(80vh - 100px); }
        #pdfPageSidebar { width: 100px; background: #1e293b; overflow-y: auto; flex-shrink: 0; padding: 8px 4px; }
        .pdf-page-thumb { position: relative; margin-bottom: 8px; cursor: pointer; border: 2px solid transparent; border-radius: 4px; overflow: hidden; }
        .pdf-page-thumb:hover, .pdf-page-thumb.active { border-color: #3b82f6; }
        .pdf-page-thumb canvas { width: 100%; display: block; }
        .pdf-page-num { position: absolute; bottom: 2px; right: 4px; background: rgba(0,0,0,.65); color: #fff; font-size: 10px; padding: 1px 4px; border-radius: 3px; }
        #pdfPageViewer {
            flex: 1; overflow: auto; padding: 24px; background: #64748b;
            display: flex; flex-direction: column; align-items: center; gap: 28px;
        }
        .pdf-page-view { position: relative; box-shadow: 0 4px 24px rgba(0,0,0,.3); background: #fff; }
        .pdf-page-label { position: absolute; top: -22px; left: 0; font-size: 12px; color: #f1f5f9; font-weight: 600; }
        .pdf-page-canvas { display: block; }
        .pdf-page-overlay { position: absolute; left: 0; top: 0; }
        #emptyState { padding: 80px 24px; text-align: center; color: #475569; }
        #editorStatus {
            position: fixed; bottom: 20px; right: 20px; background: #1e293b; color: #fff;
            padding: 10px 16px; border-radius: 8px; font-size: 13px; display: none; z-index: 9999;
        }
        .import-progress, .export-progress { display: none; padding: 8px 16px; background: #fff; border-bottom: 1px solid #e2e8f0; }
        .zoom-label { color: #cbd5e1; font-size: 12px; min-width: 42px; text-align: center; }
    </style>
}

<div class="edit-app">
    <div class="edit-topbar">
        <label>Open PDF</label>
        <input type="file" id="pdfFileInput" accept="application/pdf" class="form-control form-control-sm" style="max-width:220px;">
        <button type="button" class="btn btn-primary" id="importBtn"><i class="fa fa-upload"></i> Open</button>
        <span id="editUsageBadge" class="badge bg-light text-dark border">…</span>
        <div class="ms-auto d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-light btn-sm" id="zoomOutBtn" title="Zoom out"><i class="fa fa-search-minus"></i></button>
            <span id="zoomLabel" class="zoom-label">135%</span>
            <button type="button" class="btn btn-outline-light btn-sm" id="zoomInBtn" title="Zoom in"><i class="fa fa-search-plus"></i></button>
            <button type="button" class="btn btn-success" onclick="exportPdf()"><i class="fa fa-download"></i> Download PDF</button>
        </div>
    </div>

    <div class="import-progress" id="importProgressArea">
        <div class="progress" style="height:8px;">
            <div id="importProgressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"></div>
        </div>
        <small id="importProgressMsg" class="text-muted">Opening document…</small>
    </div>
    <div class="export-progress" id="exportProgressArea">
        <div class="progress" style="height:8px;">
            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated" style="width:100%"></div>
        </div>
        <small class="text-muted">Finalizing your edited PDF…</small>
    </div>

    <div id="toolbar">
        <div class="tb-group">
            <button class="tb-btn active" data-tool="select" title="Select &amp; edit text" onclick="setTool('select', this)"><i class="fa fa-mouse-pointer"></i></button>
            <button class="tb-btn" data-tool="pan" title="Pan (drag to scroll)" onclick="setTool('pan', this)"><i class="bi bi-arrows-move"></i></button>
            <button class="tb-btn" data-tool="whiteout" title="Whiteout area" onclick="setTool('whiteout', this)"><i class="fa fa-eraser"></i></button>
            <button class="tb-btn" data-tool="addText" title="Add text box" onclick="setTool('addText', this)"><i class="fa fa-font"></i></button>
            <button class="tb-btn" data-tool="highlight" title="Highlight area" onclick="setTool('highlight', this)"><i class="fa fa-highlighter"></i></button>
            <button class="tb-btn" title="Insert image" onclick="insertImageStamp()"><i class="fa fa-image"></i></button>
        </div>
        <div class="tb-group">
            <button class="tb-btn" id="boldToggle" title="Bold" onclick="toggleStyle(this,'bold')"><i class="fa fa-bold"></i></button>
            <button class="tb-btn" id="italicToggle" title="Italic" onclick="toggleStyle(this,'italic')"><i class="fa fa-italic"></i></button>
            <select class="tb-select" id="fontFamilySelect" style="width:110px">
                <option>Arial</option><option>Helvetica</option>
                <option>Times New Roman</option><option>Courier New</option><option>Georgia</option>
            </select>
            <select class="tb-select" id="fontSizeSelect" style="width:54px">
                <option>10</option><option>11</option><option selected>12</option>
                <option>14</option><option>16</option><option>18</option><option>24</option>
            </select>
            <input type="color" id="textColor" value="#000000" class="tb-select" style="width:36px;padding:2px;" title="Text color">
        </div>
        <div class="tb-group">
            <button class="tb-btn" title="Undo (Ctrl+Z)" onclick="undoEdit()"><i class="fa fa-undo"></i></button>
            <button class="tb-btn" title="Redo (Ctrl+Y)" onclick="redoEdit()"><i class="fa fa-redo"></i></button>
        </div>
        <div class="tb-group small text-muted d-none d-md-flex">
            Click text to edit · Drag to mark areas · Ctrl+scroll to zoom · Delete removes selection
        </div>
    </div>

    <div id="emptyState" class="@(Model.HasDocument ? "d-none" : "") text-center py-4">
        <i class="bi bi-file-earmark-pdf d-block mb-3" style="font-size:4rem;color:#94a3b8;"></i>
        <h4>Professional PDF Editor</h4>
        <p class="mb-3">Open a PDF to edit text in place, white out content, add annotations, and download a polished result.<br>Supports files up to 200 MB with full page rendering and thumbnail navigation.</p>
        <div class="d-flex justify-content-center mb-2">
            @await Html.PartialAsync("_PdfToolTrustPills")
        </div>
        @await Html.PartialAsync("_PdfToolTrustFooter")
    </div>

    <div id="editorWorkspace" class="editor-shell @(Model.HasDocument ? "" : "d-none")">
        <div id="pdfPageSidebar"></div>
        <div id="pdfPageViewer"></div>
    </div>

    <div id="editorStatus"></div>
    <input type="file" id="imageStampInput" accept="image/*" class="d-none">
</div>

@await Html.PartialAsync("_PdfToolInternalLinks")

@section Scripts {
    <script src="~/js/pdf-editor-studio.js" asp-append-version="true"></script>
    @if (Model.HasDocument)
    {
        <script>
            PdfStudioEditor.initFromServer('@Model.SessionId', @Html.Raw(modelJson), '@Model.OriginalFileName');
        </script>
    }
}
