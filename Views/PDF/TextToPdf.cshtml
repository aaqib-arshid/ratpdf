@{
    ViewData["Title"] = "Convert Text to PDF online free";
    ViewData["Description"] = "Convert TEXT to PDF online for free. Fast and secure TEXT to PDF converter.";
}

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 700px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Text to PDF</h2>
            <p class="text-muted mb-4">Upload a text file or type your content below to convert it into a PDF.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="TextToPdf" method="post" enctype="multipart/form-data" id="textForm">
                <!-- Drag & Drop File Upload -->
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop a text file here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept=".txt">
                    </div>
                </div>

                <!-- File Preview -->
                <div id="filePreview" class="text-muted mb-3"></div>

                <!-- Or Typed Text -->
                <div id="quillEditor" style="height: 250px; background: white; border-radius: 6px;"></div>
                <input type="hidden" name="typedText" id="typedText" />
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text-fill me-2"></i> Convert to PDF
                </button>
            </form>
        </div>
    </div>
    </div>
<section class="related-tools">
