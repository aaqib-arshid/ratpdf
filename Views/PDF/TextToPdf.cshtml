@{
    ViewData["Title"] = "Convert Text to PDF online free";
    ViewData["Description"] = "Convert TEXT to PDF online for free. Fast and secure TEXT to PDF converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 700px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Text to PDF</h2>
            <p class="text-muted mb-4">Upload a text file or type your content below to convert it into a PDF.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="TextToPdf" method="post" enctype="multipart/form-data" id="textForm">
                <!-- Drag & Drop File Upload -->
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop a text file here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept=".txt">
                    </div>
                </div>

                <!-- File Preview -->
                <div id="filePreview" class="text-muted mb-3"></div>

                <!-- Or Typed Text -->
                <textarea name="typedText" class="form-control mb-3" rows="8" placeholder="Or type your text here..."></textarea>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text-fill me-2"></i> Convert to PDF
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Convert Text to PDF Online</h2>

        <p>
            Our free Text to PDF converter allows you to create PDF documents from plain text files
            or directly from typed content. It's fast, secure, and works in your browser without installation.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload a text file</strong> by dragging it into the upload area or selecting it from your device.
            </li>
            <li>
                <strong>Or type your content</strong> directly into the text area provided.
            </li>
            <li>
                <strong>Click “Convert to PDF”</strong> to generate your PDF document instantly.
            </li>
            <li>
                <strong>Download the PDF</strong> to your device immediately after conversion.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our Text to PDF Tool?</h3>
        <ul>
            <li>✔ Convert plain text files to PDF online for free</li>
            <li>✔ Type directly or upload .txt files</li>
            <li>✔ Secure and private file handling</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No software installation or registration needed</li>
        </ul>

        <p class="mt-3">
            This tool is perfect for creating professional PDFs from notes, reports, articles, or any text content
            quickly and easily without using any desktop software.
        </p>
    </div>
</div>
@section Scripts {
<script type="application/ld+json">
@Html.Raw(@"{
  ""@context"": ""https://schema.org"",
  ""@graph"": [
    {
      ""@type"": ""SoftwareApplication"",
      ""name"": ""Text to PDF Converter"",
      ""applicationCategory"": ""UtilityApplication"",
      ""operatingSystem"": ""Web"",
      ""url"": ""https://ratpdf.com/PDF/TextToPdf"",
      ""description"": ""Convert plain text files to PDF online for free. Easy and secure text to PDF conversion."",
      ""offers"": {
        ""@type"": ""Offer"",
        ""price"": ""0"",
        ""priceCurrency"": ""USD""
      }
    },
    {
      ""@type"": ""FAQPage"",
      ""mainEntity"": [
        {
          ""@type"": ""Question"",
          ""name"": ""How do I convert text to PDF online?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Upload a text file or type your content directly in the text area, then click 'Convert to PDF' to generate your PDF document.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is converting text to PDF free?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, our Text to PDF converter is completely free with no registration or software installation required.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Can I type text directly instead of uploading a file?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, you can type your text in the provided textarea and convert it to PDF directly.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Is my text file secure when using this tool?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""Yes, all files are processed securely and privately. Uploaded text is not stored permanently and is deleted after conversion.""
          }
        },
        {
          ""@type"": ""Question"",
          ""name"": ""Which devices are supported?"",
          ""acceptedAnswer"": {
            ""@type"": ""Answer"",
            ""text"": ""This online Text to PDF converter works on any device with a web browser, including Windows, Mac, Android, and iOS.""
          }
        }
      ]
    }
  ]
}");
    </script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');

        function updatePreview() {
            if (fileInput.files.length === 0) {
                filePreview.textContent = '';
                return;
            }
            filePreview.textContent = 'Selected file: ' + fileInput.files[0].name;
        }

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            updatePreview();
        });

        fileInput.addEventListener('change', updatePreview);
    </script>
}