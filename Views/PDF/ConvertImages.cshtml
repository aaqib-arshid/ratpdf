@model ImageUploadViewModel
@{
    ViewData["Title"] = "Convert Images to PDF Online Free";
    ViewData["Description"] = "Convert JPG, PNG and other images to PDF online for free. Fast and secure image to PDF converter.";
}

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <!-- Page Header -->
            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Convert Images to PDF</h2>
            <p class="text-muted mb-4">Upload one or multiple images to create a high-quality PDF instantly.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <!-- Drag & Drop Form -->
            <form asp-action="ConvertImages" method="post" enctype="multipart/form-data" id="imageForm">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop images here or click to select</p>
                        <input type="file" name="files" multiple class="form-control form-control-lg d-none" id="fileInput" accept="image/*">
                    </div>
                </div>

                <!-- Preview Thumbnails -->
                <div id="preview" class="d-flex flex-wrap justify-content-center mb-3 gap-2"></div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i> Convert to PDF
                </button>
            </form>

            <div class="mt-4 text-muted small">
                Supported formats: JPG, JPEG, PNG, GIF
            </div>
        </div>
    </div>
</div>
<section class="related-tools">
  <h3>Related Tools</h3>
  <ul>
    <li><a href="/PDF/ImageCompressor">Image Compressor</a></li>
    <li><a href="/PDF/Merge">Merge PDF</a></li>
    <li><a href="/PDF/Compress">Compress PDF</a></li>
    <li><a href="/PDF/Watermark">Add Watermark</a></li>
  </ul>
</section>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Convert Images to PDF Online</h2>

        <p>
            In the modern digital world, sharing images in PDF format is often more convenient and professional. 
            Whether you want to create a document from scanned photos, receipts, assignments, or presentations, our free online 
            <strong>image to PDF converter</strong> lets you turn JPG, PNG, GIF, and other image files into a single high-quality PDF quickly and easily. 
            No software installation or registration is required, making the process fast, secure, and hassle-free.
        </p>

