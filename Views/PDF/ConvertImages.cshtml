@model ImageUploadViewModel
@{
    ViewData["Title"] = "Convert Images to PDF Online Free";
    ViewData["Description"] = "Convert JPG, PNG and other images to PDF online for free. Fast and secure image to PDF converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <!-- Page Header -->
            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Convert Images to PDF</h2>
            <p class="text-muted mb-4">Upload one or multiple images to create a high-quality PDF instantly.</p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <!-- Drag & Drop Form -->
            <form asp-action="ConvertImages" method="post" enctype="multipart/form-data" id="imageForm">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop images here or click to select</p>
                        <input type="file" name="files" multiple class="form-control form-control-lg d-none" id="fileInput" accept="image/*">
                    </div>
                </div>

                <!-- Preview Thumbnails -->
                <div id="preview" class="d-flex flex-wrap justify-content-center mb-3 gap-2"></div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-pdf-fill me-2"></i> Convert to PDF
                </button>
            </form>

            <div class="mt-4 text-muted small">
                Supported formats: JPG, JPEG, PNG, GIF
            </div>
            <div class="container py-5">
                <div class="card shadow-sm p-4" style="border-radius: 12px;">
                    <h2 class="fw-bold mb-3">How to Convert Images to PDF Online</h2>

                    <p>
                        Our free image to PDF converter allows you to turn JPG, PNG, and other image files into a single
                        high-quality PDF document in seconds. No software installation required.
                    </p>

                    <ol class="mb-4">
                        <li>
                            <strong>Upload your images</strong> by dragging and dropping them into the upload area
                            or selecting files from your device.
                        </li>
                        <li>
                            <strong>Arrange your images automatically</strong> in the order they are uploaded.
                        </li>
                        <li>
                            <strong>Click “Convert to PDF”</strong> to instantly create your PDF file.
                        </li>
                        <li>
                            <strong>Download your PDF</strong> and share or store it securely.
                        </li>
                    </ol>

                    <h3 class="fw-semibold mt-4">Why Use Our Image to PDF Converter?</h3>
                    <ul>
                        <li>✔ Convert JPG, PNG, GIF, and JPEG to PDF for free</li>
                        <li>✔ High-quality PDF output with no watermark</li>
                        <li>✔ Secure and private file handling</li>
                        <li>✔ Works on Windows, Mac, Android, and iOS</li>
                        <li>✔ No registration or software download needed</li>
                    </ul>

                    <p class="mt-3">
                        This tool is perfect for creating PDFs from scanned documents, photos, receipts,
                        assignments, and presentations.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SoftwareApplication",
  "name": "Image to PDF Converter",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "url": "https://ratpdf.com/PDF/ConvertImages",
  "description": "Convert JPG, PNG and other image files to PDF online for free. Fast, secure, and easy to use.",
  "offers": {
    "@@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
    <script>
        // Drag & Drop and Preview
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const preview = document.getElementById('preview');

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            showPreview();
        });

        fileInput.addEventListener('change', showPreview);

        function showPreview() {
            preview.innerHTML = '';
            const files = fileInput.files;
            for (let i = 0; i < files.length; i++) {
                if (!files[i].type.startsWith('image/')) continue;
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'img-thumbnail';
                    img.style.height = '80px';
                    img.style.width = '80px';
                    preview.appendChild(img);
                }
                reader.readAsDataURL(files[i]);
            }
        }
    </script>
}