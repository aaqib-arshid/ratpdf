@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.PdfA, ViewData);
    ViewData["ToolTitle"] = "Convert to PDF/A";
    ViewData["ToolSubtitle"] = "Create archival PDF/A-1b or PDF/A-2b files";
    ViewData["AcceptHint"] = "PDF for long-term archiving";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-archive";
    ViewData["BtnLabel"] = "Convert to PDF/A";
}
@await Html.PartialAsync("_PdfToolBreadcrumbs")
<div class="rp-content-page">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rp-tool-hero" id="rpToolHero">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-3 text-center text-md-start">
                        @await Html.PartialAsync("_PdfToolTrustPills")
                        <h1 class="h2 fw-bold mb-1">@ViewData["ToolTitle"]</h1>
                        <p class="text-muted mb-2">@ViewData["ToolSubtitle"]</p>
                        @await Html.PartialAsync("_PdfToolUsageBadge")
                    </div>

                    <div class="alert alert-light border small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Output is optimized for archival workflows. For certified compliance, validate with
                        <strong>veraPDF</strong> before submitting to regulated archives.
                    </div>

                    <div id="dropZone" class="rp-dropzone border border-2 border-dashed rounded-4 p-4 p-md-5 text-center mb-3">
                        <i class="bi bi-cloud-arrow-up display-5 text-primary"></i>
                        <p class="mb-1 fw-semibold mt-2">Drag &amp; drop here or tap to browse</p>
                        <p id="limitHint" class="text-muted small mb-0">@ViewData["AcceptHint"]</p>
                        <input type="file" id="fileInput" class="d-none" accept="@ViewData["AcceptAttr"]">
                    </div>

                    <div class="mb-3">
                        <label for="levelSelect" class="form-label fw-semibold small text-muted">PDF/A level</label>
                        <select id="levelSelect" class="form-select">
                            <option value="1b" selected>PDF/A-1b (widest archive compatibility)</option>
                            <option value="2b">PDF/A-2b (Pro — supports transparency)</option>
                        </select>
                    </div>

                    <div id="fileList" class="mb-3"></div>
                    @await Html.PartialAsync("_PdfLargeFileNotice")
                    <div id="errorArea" class="alert alert-danger d-none" role="alert"></div>

                    <div id="progressArea" class="mb-3" style="display:none;">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span id="progressMsg">Processing…</span>
                            <span id="progressPct">0%</span>
                        </div>
                        <div class="progress" style="height:10px;border-radius:6px;">
                            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" style="width:0%;background:linear-gradient(90deg,#4a90e2,#667eea);"></div>
                        </div>
                    </div>

                    <button type="button" id="convertBtn" class="btn btn-primary btn-lg w-100 py-3 fw-semibold rp-tool-primary-btn" disabled>
                        <i class="bi @ViewData["BtnIcon"] me-2"></i>@ViewData["BtnLabel"]
                    </button>
                    @await Html.PartialAsync("_PdfSubmitHint")
                    @await Html.PartialAsync("_PdfToolTrustFooter")
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
(function () {
    const cfg = {
        toolId: 'pdfa',
        convertUrl: '/pdf/pdfa',
        extensions: ['.pdf'],
        typeLabel: 'PDF',
        multiple: false,
        defaultFileName: 'pdfa.pdf',
        dropZoneId: 'dropZone',
        fileInputId: 'fileInput',
        fileListId: 'fileList',
        convertBtnId: 'convertBtn',
        errorAreaId: 'errorArea',
        progressAreaId: 'progressArea',
        progressBarId: 'progressBar',
        progressMsgId: 'progressMsg',
        progressPctId: 'progressPct',
        badgeId: 'usageBadge',
        limitHintId: 'limitHint',
    };

    const levelSelect = document.getElementById('levelSelect');
    let selectedFiles = [];
    let isPremium = false;

    PdfToolkit.checkToolAccess(cfg.toolId).then(access => {
        isPremium = !!access.isPremium;
        const hint = document.getElementById(cfg.limitHintId);
        if (hint) hint.textContent = `${access.maxFileSizeLabel || '200 MB'} per file`;
        const badge = document.getElementById(cfg.badgeId);
        if (badge) PdfToolkit.setUsageBadgeEl(badge, access);
        if (levelSelect && !isPremium) {
            levelSelect.querySelector('option[value="2b"]')?.setAttribute('disabled', 'disabled');
        }
    });

    const dropZone = document.getElementById(cfg.dropZoneId);
    const fileInput = document.getElementById(cfg.fileInputId);
    const fileList = document.getElementById(cfg.fileListId);
    const convertBtn = document.getElementById(cfg.convertBtnId);
    const errorArea = document.getElementById(cfg.errorAreaId);
    const progressElements = PdfToolkit.getStandardProgressElements();

    function showError(msg) {
        if (!errorArea) return;
        errorArea.textContent = PdfToolkit.sanitizeErrorMessage(msg);
        errorArea.classList.remove('d-none');
    }
    function clearError() { errorArea?.classList.add('d-none'); }

    function renderFileList() {
        if (!fileList) return;
        if (!selectedFiles.length) {
            PdfToolkit.renderPdfFilePreview(fileList, [], {});
            if (convertBtn) convertBtn.disabled = true;
            return;
        }
        PdfToolkit.renderPdfFilePreview(fileList, selectedFiles, {
            onClear: () => { selectedFiles = []; PdfToolkit.assignFilesToInput(fileInput, []); renderFileList(); clearError(); },
        });
        if (convertBtn) convertBtn.disabled = false;
    }

    dropZone?.addEventListener('click', () => fileInput?.click());
    dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.style.background = '#eef2ff'; });
    dropZone?.addEventListener('dragleave', () => { dropZone.style.background = '#f8fafc'; });
    dropZone?.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.style.background = '#f8fafc';
        const dt = e.dataTransfer?.files;
        if (dt?.length) {
            const v = PdfToolkit.validateFiles(dt, { maxFiles: 1, extensions: cfg.extensions, typeLabel: cfg.typeLabel });
            if (!v.ok) showError(v.error);
            else { clearError(); selectedFiles = v.files; renderFileList(); }
        }
    });
    fileInput?.addEventListener('change', () => {
        const v = PdfToolkit.validateFiles(fileInput.files, { maxFiles: 1, extensions: cfg.extensions, typeLabel: cfg.typeLabel });
        if (!v.ok) showError(v.error);
        else { clearError(); selectedFiles = v.files; renderFileList(); }
    });

    convertBtn?.addEventListener('click', async () => {
        if (!selectedFiles.length) return;
        const level = levelSelect?.value || '1b';
        if (level === '2b' && !isPremium) {
            PdfToolkit.showPaywall('PDF/A-2b conversion is a Pro feature.');
            return;
        }
        clearError();
        convertBtn.disabled = true;
        const formData = new FormData();
        formData.append('file', selectedFiles[0]);
        formData.append('level', level);
        try {
            await PdfToolkit.runJobFlow({
                url: cfg.convertUrl,
                formData,
                elements: progressElements,
                toolId: cfg.toolId,
                defaultFileName: cfg.defaultFileName,
            });
            const s = await PdfToolkit.checkToolAccess(cfg.toolId);
            const badge = document.getElementById(cfg.badgeId);
            if (badge) PdfToolkit.setUsageBadgeEl(badge, s);
        } catch (err) {
            if (err.paywall) PdfToolkit.showPaywall(err.message);
            else showError(err.message || 'Conversion failed.');
        } finally {
            convertBtn.disabled = !selectedFiles.length;
        }
    });
})();
</script>
}
