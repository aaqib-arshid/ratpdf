@{
    ViewData["Title"] = "Convert PDF to DOCX Online Free";
    ViewData["Description"] = "Convert PDF to DOCX online for free. Fast and secure PDF to DOCX converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">PDF to DOCX</h2>
            <p class="text-muted mb-4">Upload a PDF file to convert all its text content into a Word document.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="PdfToDoc" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop a PDF here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept="application/pdf">
                    </div>
                </div>

                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text me-2"></i> Convert to DOCX
                </button>
            </form>
            <div class="container py-5">
                <div class="card shadow-sm p-4" style="border-radius: 12px;">
                    <h2 class="fw-bold mb-3">How to Convert PDF to DOCX Online</h2>

                    <p>
                        Our free PDF to DOCX converter allows you to turn PDF files into fully editable
                        Microsoft Word documents online. Text content is extracted accurately, making it easy
                        to edit, copy, and reuse your documents.
                    </p>

                    <ol class="mb-4">
                        <li>
                            <strong>Upload your PDF file</strong> by dragging and dropping it into the upload area
                            or selecting it from your device.
                        </li>
                        <li>
                            <strong>Click “Convert to DOCX”</strong> to start converting your PDF to Word format.
                        </li>
                        <li>
                            <strong>Download the DOCX file</strong> instantly once the conversion is complete.
                        </li>
                    </ol>

                    <h3 class="fw-semibold mt-4">Why Use Our PDF to Word Converter?</h3>
                    <ul>
                        <li>✔ Convert PDF to DOCX online for free</li>
                        <li>✔ Editable Word output with accurate text conversion</li>
                        <li>✔ Secure and private file handling</li>
                        <li>✔ Works on Windows, Mac, Android, and iOS</li>
                        <li>✔ No registration or software installation required</li>
                    </ul>

                    <p class="mt-3">
                        This tool is ideal for editing PDFs, updating reports, modifying contracts,
                        and converting scanned or text-based PDF documents into Word format.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SoftwareApplication",
  "name": "PDF to Word Converter",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "url": "https://ratpdf.com/PDF/PdfToDoc",
  "description": "Convert PDF files to editable Word documents online quickly and safely for free.",
  "offers": {
    "@@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');

        function updatePreview() {
            if (fileInput.files.length === 0) {
                filePreview.textContent = '';
                return;
            }
            filePreview.textContent = 'Selected file: ' + fileInput.files[0].name;
        }

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            updatePreview();
        });

        fileInput.addEventListener('change', updatePreview);
    </script>
}