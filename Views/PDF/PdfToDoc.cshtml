@using ratpdf.Constants

@{

    ViewData["Title"] = "PDF to Word Converter Online Free — High Fidelity DOCX | RatPDF";

    ViewData["Description"] = "Convert PDF to Word (DOCX) online free. Preserve tables, logos, borders & layout like Adobe Acrobat. Scanned PDF support. 200 MB free, 4 GB Pro.";

    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/PDF/PdfToDoc");

    ViewData["PdfToolId"] = "pdftodoc";

    ViewData["ToolTitle"] = "PDF to Word";

    ViewData["ToolSubtitle"] = "Tables · logos · borders · scanned PDFs · multi-column layouts";

    ViewData["AcceptHint"] = "PDF files";

    ViewData["AcceptAttr"] = ".pdf,application/pdf";

    ViewData["Multiple"] = true;

    ViewData["BtnIcon"] = "bi-file-earmark-word";

    ViewData["BtnLabel"] = "Convert to Word";

    ViewData["SeoH1"] = "PDF to Word Converter — Keep Tables, Logos & Exact Layout";

    ViewData["SeoLead"] = "RatPDF converts PDF files to editable Microsoft Word documents while preserving the visual structure businesses depend on: branded headers, data tables with borders, charts, and multi-column reports.";

    var proDisplay = SubscriptionPricing.FormatProDisplay();

    ViewData["SeoSections"] = $@"

<h2 class='h4 fw-semibold mt-4'>When you need more than copy-paste</h2>

<p>Most free converters dump plain text into a DOCX file and destroy your document. RatPDF runs a <strong>multi-engine pipeline</strong> designed for real-world PDFs:</p>

<ol>

<li><strong>pdf2docx</strong> — reconstructs editable text, tables, and embedded images.</li>

<li><strong>Page-render fallback</strong> — embeds each page at 200 DPI when logos or complex graphics would otherwise break (common with scanned brochures and marketing PDFs).</li>

<li><strong>OCR</strong> — extracts text from scanned pages when no text layer exists.</li>

<li><strong>LibreOffice</strong> — additional pass on servers where it is installed.</li>

</ol>



<h2 class='h4 fw-semibold mt-4'>Document types we handle well</h2>

<div class='row g-3 mt-2'>

<div class='col-md-6'><div class='p-3 bg-light rounded-3 h-100'><strong>Invoices &amp; GST bills</strong><br><span class='text-muted small'>Line items, tax tables, company logos</span></div></div>

<div class='col-md-6'><div class='p-3 bg-light rounded-3 h-100'><strong>Contracts &amp; legal PDFs</strong><br><span class='text-muted small'>Numbered clauses, signature blocks</span></div></div>

<div class='col-md-6'><div class='p-3 bg-light rounded-3 h-100'><strong>Marketing brochures</strong><br><span class='text-muted small'>Full-bleed images, brand colors</span></div></div>

<div class='col-md-6'><div class='p-3 bg-light rounded-3 h-100'><strong>Scanned office documents</strong><br><span class='text-muted small'>OCR + high-res page images</span></div></div>

</div>



<h2 class='h4 fw-semibold mt-4'>RatPDF vs typical free converters</h2>

<div class='table-responsive mt-2'>

<table class='table table-bordered align-middle'>

<thead class='table-light'><tr><th>Feature</th><th>RatPDF</th><th>Basic online tools</th></tr></thead>

<tbody>

<tr><td>Table borders preserved</td><td>Yes</td><td>Often lost</td></tr>

<tr><td>Logos &amp; images</td><td>High-res embed</td><td>Missing or blurry</td></tr>

<tr><td>Scanned PDFs</td><td>OCR + page render</td><td>Fails or empty</td></tr>

<tr><td>File size limit</td><td>200 MB free / 4 GB Pro</td><td>Usually 10–50 MB</td></tr>

<tr><td>Progress tracking</td><td>Real-time bar</td><td>None</td></tr>

</tbody>

</table>

</div>



<h2 class='h4 fw-semibold mt-4'>Tips for best results</h2>

<ul>

<li>Use the <strong>original PDF</strong> (not a re-scanned photocopy) when possible.</li>

<li>For password-protected files, unlock them before upload.</li>

<li>Large image-heavy PDFs may produce a Word file with page images — visually identical to the PDF, ideal for printing and sharing.</li>

<li>Need unlimited conversions? <a href='/Subscription/Plans'>Pro from {proDisplay}</a> — cancel anytime.</li>

</ul>



<h2 class='h4 fw-semibold mt-4'>Related tools</h2>

<p>After converting, you may also need <a href='/PDF/DocToPdf'>Word to PDF</a>, <a href='/PDF/PdfToExcel'>PDF to Excel</a>, <a href='/PDF/Merge'>Merge PDF</a>, or <a href='/PDF/Compress'>Compress PDF</a>.</p>";

}



@await Html.PartialAsync("_PdfJobToolShell")

@await Html.PartialAsync("_PdfToolInternalLinks")

@await Html.PartialAsync("_PdfToolSeoArticle")



@section Head {

<script type="application/ld+json">

{

  "@@context": "https://schema.org",

  "@@graph": [

    {

      "@@type": "WebApplication",

      "name": "RatPDF PDF to Word Converter",

      "url": "@PdfToolSeo.Canonical("/PDF/PdfToDoc")",

      "applicationCategory": "BusinessApplication",

      "operatingSystem": "Web",

      "description": "@ViewData["Description"]",

      "offers": { "@@type": "Offer", "price": "0", "priceCurrency": "USD" },

      "featureList": "PDF to DOCX, table preservation, logo preservation, scanned PDF OCR"

    },

    {

      "@@type": "FAQPage",

      "mainEntity": [

        {

          "@@type": "Question",

          "name": "Why does my PDF to Word conversion lose logos or tables?",

          "acceptedAnswer": {

            "@@type": "Answer",

            "text": "Basic converters only extract text. RatPDF uses pdf2docx plus a high-resolution page-image fallback so logos, borders, and tables stay intact."

          }

        },

        {

          "@@type": "Question",

          "name": "Can RatPDF convert scanned PDF to Word?",

          "acceptedAnswer": {

            "@@type": "Answer",

            "text": "Yes. Scanned PDFs are detected automatically. RatPDF uses OCR and page rendering to produce a usable Word document."

          }

        },

        {

          "@@type": "Question",

          "name": "Is PDF to Word free on RatPDF?",

          "acceptedAnswer": {

            "@@type": "Answer",

            "text": "Yes — 3 free conversions per day up to 200 MB. Pro subscribers get unlimited conversions and 4 GB file uploads."

          }

        }

      ]

    }

  ]

}

</script>

}



@section Scripts {

<script>

PdfToolkit.initJobTool({

    toolId: 'pdftodoc',

    convertUrl: '/PDF/PdfToDoc/convert',

    extensions: ['.pdf'],

    typeLabel: 'PDF',

    multiple: true,

    defaultFileName: 'converted.docx',

    dropZoneId: 'dropZone',

    fileInputId: 'fileInput',

    fileListId: 'fileList',

    convertBtnId: 'convertBtn',

    errorAreaId: 'errorArea',

    progressAreaId: 'progressArea',

    progressBarId: 'progressBar',

    progressMsgId: 'progressMsg',

    progressPctId: 'progressPct',

    limitHintId: 'limitHint',

});

</script>

}


