                "text": "Our online converter works on any device with a browser, including Windows, Mac, Android, and iOS."
              }
            }
          ]
        }
    </script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');

        function updatePreview() {
            if (fileInput.files.length === 0) {
                filePreview.textContent = '';
                return;
            }
            filePreview.textContent = 'Selected file: ' + fileInput.files[0].name;
        }

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            updatePreview();
        });

        fileInput.addEventListener('change', updatePreview);

         $('#pdfToDocForm').on('submit', function (e) {
         e.preventDefault();
         showLoader('Getting Ready...');
         setTimeout(function () {
                 showLoader('Processing...');;
         }, 3000);
         setTimeout(function () {
                submitWithLoader('pdfToDocForm', 'Downloading...');
         }, 5000);
        });
    </script>
}