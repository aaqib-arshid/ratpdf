@{
    ViewData["Title"] = "Sign PDF with your Name online free";
    ViewData["Description"] = "Sign PDF online for free. Fast and secure PDF Signing tool.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">
            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">Sign PDF with Your Name</h2>
            <p class="text-muted mb-4">Upload a PDF and enter your name to sign it in italic.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="SignText" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <input type="file" name="file" class="form-control form-control-lg" accept="application/pdf">
                </div>

                <div class="mb-3">
                    <input type="text" name="name" class="form-control form-control-lg" placeholder="Enter your name for signature">
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-pencil-square me-2"></i> Sign PDF
                </button>
            </form>
        </div>
    </div>
</div>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Sign a PDF Online with Your Name</h2>

        <p>
            Our free PDF signing tool allows you to add your name as a signature to any PDF document.
            It's fast, secure, and requires no installation or account registration.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your PDF file</strong> using the upload button above.
            </li>
            <li>
                <strong>Enter your name</strong> in the field provided to create your signature.
            </li>
            <li>
                <strong>Click “Sign PDF”</strong> to add your name as a signature in italic style.
            </li>
            <li>
                <strong>Download your signed PDF</strong> instantly after processing.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our PDF Signing Tool?</h3>
        <ul>
            <li>✔ Sign PDFs online for free without software</li>
            <li>✔ Secure and private file handling</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ Simple and fast, ideal for contracts, forms, and agreements</li>
            <li>✔ No registration or installation needed</li>
        </ul>

        <p class="mt-3">
            This tool is perfect for digitally signing contracts, agreements, invoices, or any PDF
            document that requires a name-based signature.
        </p>
    </div>
</div>
@section Scripts {
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "SoftwareApplication",
          "name": "Sign PDF Online",
          "applicationCategory": "UtilityApplication",
          "operatingSystem": "Web",
          "url": "https://ratpdf.com/PDF/SignText",
          "description": "Add your signature to PDF files online for free. Easy and secure PDF signing tool.",
          "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
    </script>
}