@using ratpdf.Constants
@{
    PdfToolSeoMeta.ApplyToViewData(PdfToolIds.SignPdf, ViewData);
    ViewData["ToolTitle"] = "Sign PDF Online";
    ViewData["ToolSubtitle"] = "Type, draw, or upload your signature";
    ViewData["AcceptHint"] = "PDF files";
    ViewData["AcceptAttr"] = ".pdf,application/pdf";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-pen";
    ViewData["BtnLabel"] = "Sign PDF";
}
@await Html.PartialAsync("_PdfJobToolShell")
<div class="container pb-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <ul class="nav nav-pills nav-fill mb-3" id="signModeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-mode="typed" type="button">Type name</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-mode="draw" type="button">Draw</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-mode="image" type="button">Upload image</button>
                        </li>
                    </ul>

                    <div id="typedPanel">
                        <label class="form-label fw-semibold" for="signerName">Your name</label>
                        <input type="text" id="signerName" class="form-control form-control-lg mb-3" placeholder="Jane Smith" maxlength="80">
                        <label class="form-label fw-semibold" for="fontStyle">Signature style</label>
                        <select id="fontStyle" class="form-select mb-3">
                            <option value="script">Script (italic)</option>
                            <option value="classic">Classic serif</option>
                            <option value="modern">Modern sans</option>
                        </select>
                    </div>

                    <div id="drawPanel" class="d-none">
                        <label class="form-label fw-semibold">Draw your signature</label>
                        <div id="signCanvasWrap" class="border rounded-3 bg-light position-relative mb-2" style="touch-action:none;height:180px;">
                            <canvas id="signCanvas" class="d-block w-100 h-100" style="cursor:crosshair;touch-action:none;"></canvas>
                        </div>
                        <button type="button" id="clearCanvas" class="btn btn-sm btn-outline-secondary">Clear drawing</button>
                    </div>

                    <div id="imagePanel" class="d-none">
                        <label class="form-label fw-semibold" for="signatureUpload">Signature image (PNG/JPG)</label>
                        <input type="file" id="signatureUpload" class="form-control" accept="image/png,image/jpeg,image/webp">
                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="pageTarget">Page</label>
                            <select id="pageTarget" class="form-select">
                                <option value="last">Last page</option>
                                <option value="first">First page</option>
                                <option value="all">All pages</option>
                                <option value="page">Specific page</option>
                            </select>
                        </div>
                        <div class="col-md-4" id="pageNumberWrap" style="display:none;">
                            <label class="form-label fw-semibold" for="pageNumber">Page number</label>
                            <input type="number" id="pageNumber" class="form-control" min="1" value="1">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold" for="position">Position</label>
                            <select id="position" class="form-select">
                                <option value="bottom-right">Bottom right</option>
                                <option value="bottom-left">Bottom left</option>
                                <option value="center">Center</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="includeDate">
                        <label class="form-check-label" for="includeDate">Add date below signature</label>
                    </div>
                    <p class="text-muted small mt-3 mb-0">Visual signature only — not a certificate-based digital signature. For legal e-sign with audit trails, use a dedicated e-sign platform.</p>
                </div>
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")
@section Scripts {
@await Html.PartialAsync("_PdfToolJsonLd")
<script>
(async function () {
    const toolId = 'signpdf';
    const access = await PdfToolkit.checkToolAccess(toolId);
    const elements = PdfToolkit.getStandardProgressElements();
    let selected = null;
    let signMode = 'typed';
    let uploadedSignature = null;

    const fileInput = document.getElementById('fileInput');
    const convertBtn = document.getElementById('convertBtn');
    const errorArea = document.getElementById('errorArea');
    const pageTarget = document.getElementById('pageTarget');
    const pageNumberWrap = document.getElementById('pageNumberWrap');
    const canvas = document.getElementById('signCanvas');
    const canvasWrap = document.getElementById('signCanvasWrap');
    const ctx = canvas.getContext('2d');
    let canvasReady = false;
    let deviceRatio = 1;

    const hint = document.getElementById('limitHint');
    if (hint) hint.textContent = `${access.maxFileSizeLabel || '200 MB'} per file`;
    const badge = document.getElementById('usageBadge');
    if (badge) PdfToolkit.setUsageBadgeEl(badge, access);

    function applyStrokeStyle() {
        ctx.lineWidth = 2.5;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.strokeStyle = '#1a1a2e';
    }

    function resizeCanvas() {
        if (!canvasWrap || canvasWrap.offsetParent === null) return false;
        const rect = canvasWrap.getBoundingClientRect();
        if (rect.width < 10 || rect.height < 10) return false;

        deviceRatio = window.devicePixelRatio || 1;
        const w = Math.floor(rect.width * deviceRatio);
        const h = Math.floor(rect.height * deviceRatio);
        if (canvas.width === w && canvas.height === h) return canvasReady;

        canvas.width = w;
        canvas.height = h;
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, w, h);
        ctx.setTransform(deviceRatio, 0, 0, deviceRatio, 0, 0);
        applyStrokeStyle();
        canvasReady = true;
        return true;
    }

    let drawing = false;
    let lastPoint = null;

    function canvasPos(e) {
        const r = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - r.left, y: clientY - r.top };
    }

    function startDraw(e) {
        if (!canvasReady && !resizeCanvas()) return;
        drawing = true;
        lastPoint = canvasPos(e);
        ctx.beginPath();
        ctx.moveTo(lastPoint.x, lastPoint.y);
        if (e.pointerId != null && canvas.setPointerCapture) {
            try { canvas.setPointerCapture(e.pointerId); } catch (_) { /* ignore */ }
        }
        e.preventDefault();
    }

    function moveDraw(e) {
        if (!drawing || !lastPoint) return;
        const p = canvasPos(e);
        ctx.beginPath();
        ctx.moveTo(lastPoint.x, lastPoint.y);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
        lastPoint = p;
        e.preventDefault();
    }

    function endDraw(e) {
        if (!drawing) return;
        drawing = false;
        lastPoint = null;
        if (e?.pointerId != null && canvas.releasePointerCapture) {
            try { canvas.releasePointerCapture(e.pointerId); } catch (_) { /* ignore */ }
        }
    }

    canvas.addEventListener('pointerdown', startDraw);
    canvas.addEventListener('pointermove', moveDraw);
    canvas.addEventListener('pointerup', endDraw);
    canvas.addEventListener('pointerleave', endDraw);
    canvas.addEventListener('pointercancel', endDraw);

    if (canvasWrap && typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => {
            if (signMode === 'draw' && canvasWrap.offsetParent !== null && !canvasReady) resizeCanvas();
        });
        ro.observe(canvasWrap);
    }

    document.getElementById('clearCanvas')?.addEventListener('click', () => {
        if (!canvasReady) resizeCanvas();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.setTransform(deviceRatio, 0, 0, deviceRatio, 0, 0);
        applyStrokeStyle();
    });

    document.querySelectorAll('#signModeTabs .nav-link').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('#signModeTabs .nav-link').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            signMode = btn.dataset.mode;
            document.getElementById('typedPanel').classList.toggle('d-none', signMode !== 'typed');
            document.getElementById('drawPanel').classList.toggle('d-none', signMode !== 'draw');
            document.getElementById('imagePanel').classList.toggle('d-none', signMode !== 'image');
            if (signMode === 'draw') {
                requestAnimationFrame(() => resizeCanvas());
            }
        });
    });

    document.getElementById('signatureUpload')?.addEventListener('change', (e) => {
        uploadedSignature = e.target.files?.[0] || null;
    });

    pageTarget?.addEventListener('change', () => {
        pageNumberWrap.style.display = pageTarget.value === 'page' ? '' : 'none';
    });

    await PdfToolkit.bindPdfUpload({
        fileInput,
        dropZone: document.getElementById('dropZone'),
        previewContainer: document.getElementById('fileList'),
        errorArea,
        toolId,
        multiple: false,
        onChange: (files) => {
            selected = files[0] || null;
            convertBtn.disabled = !selected;
        },
    });

    function getSignatureBounds() {
        if (!canvasReady || !canvas.width || !canvas.height) return null;
        const w = canvas.width;
        const h = canvas.height;
        const imageData = ctx.getImageData(0, 0, w, h);
        const d = imageData.data;
        let minX = w, minY = h, maxX = -1, maxY = -1;
        for (let y = 0; y < h; y++) {
            for (let x = 0; x < w; x++) {
                const a = d[(y * w + x) * 4 + 3];
                if (a > 8) {
                    if (x < minX) minX = x;
                    if (y < minY) minY = y;
                    if (x > maxX) maxX = x;
                    if (y > maxY) maxY = y;
                }
            }
        }
        if (maxX < minX) return null;
        const pad = Math.max(4, Math.floor(deviceRatio * 4));
        minX = Math.max(0, minX - pad);
        minY = Math.max(0, minY - pad);
        maxX = Math.min(w - 1, maxX + pad);
        maxY = Math.min(h - 1, maxY + pad);
        return { x: minX, y: minY, w: maxX - minX + 1, h: maxY - minY + 1 };
    }

    async function canvasToPngFile() {
        const bounds = getSignatureBounds();
        if (!bounds) return null;

        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = bounds.w;
        exportCanvas.height = bounds.h;
        const exportCtx = exportCanvas.getContext('2d');
        exportCtx.drawImage(canvas, bounds.x, bounds.y, bounds.w, bounds.h, 0, 0, bounds.w, bounds.h);

        return new Promise((resolve) => {
            exportCanvas.toBlob((blob) => {
                if (!blob) return resolve(null);
                resolve(new File([blob], 'signature.png', { type: 'image/png' }));
            }, 'image/png');
        });
    }

    function canvasIsBlank() {
        return getSignatureBounds() === null;
    }

    convertBtn?.addEventListener('click', async () => {
        if (!selected) return;
        errorArea.classList.add('d-none');

        const formData = new FormData();
        formData.append('file', selected);
        formData.append('mode', signMode);
        formData.append('pageTarget', pageTarget.value);
        formData.append('pageNumber', document.getElementById('pageNumber').value || '1');
        formData.append('position', document.getElementById('position').value);
        formData.append('fontStyle', document.getElementById('fontStyle').value);
        formData.append('includeDate', document.getElementById('includeDate').checked ? 'true' : 'false');

        if (signMode === 'typed') {
            const name = document.getElementById('signerName').value.trim();
            if (!name) {
                errorArea.textContent = 'Please enter your name.';
                errorArea.classList.remove('d-none');
                return;
            }
            formData.append('name', name);
        } else if (signMode === 'draw') {
            if (!resizeCanvas()) {
                errorArea.textContent = 'Signature pad is not ready. Click Draw again or refresh the page.';
                errorArea.classList.remove('d-none');
                return;
            }
            if (canvasIsBlank()) {
                errorArea.textContent = 'Please draw your signature first.';
                errorArea.classList.remove('d-none');
                return;
            }
            const sigFile = await canvasToPngFile();
            if (!sigFile) {
                errorArea.textContent = 'Could not capture signature drawing.';
                errorArea.classList.remove('d-none');
                return;
            }
            formData.append('signatureImage', sigFile);
        } else {
            if (!uploadedSignature) {
                errorArea.textContent = 'Please upload a signature image.';
                errorArea.classList.remove('d-none');
                return;
            }
            formData.append('signatureImage', uploadedSignature);
        }

        convertBtn.disabled = true;
        try {
            await PdfToolkit.runJobFlow({
                url: '/PDF/SignText',
                formData,
                elements,
                toolId,
                defaultFileName: 'signed.pdf',
            });
            const s = await PdfToolkit.checkToolAccess(toolId);
            if (badge) PdfToolkit.setUsageBadgeEl(badge, s);
        } catch (e) {
            if (e.paywall) PdfToolkit.showPaywall(e.message);
            else {
                errorArea.textContent = PdfToolkit.sanitizeErrorMessage(e.message || 'Signing failed.');
                errorArea.classList.remove('d-none');
            }
        } finally {
            convertBtn.disabled = !selected;
        }
    });
})();
</script>
}
