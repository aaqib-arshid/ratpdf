@using ratpdf.Constants
@{
    ViewData["Title"] = "Word to PDF Converter Online Free — Print-Accurate | RatPDF";
    ViewData["Description"] = "Convert DOCX to PDF online with Adobe-quality layout. Fonts, tables, logos & images preserved via LibreOffice engine. Free 200 MB, Pro 4 GB.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/PDF/DocToPdf");
    ViewData["PdfToolId"] = "doctopdf";
    ViewData["ToolTitle"] = "Word to PDF";
    ViewData["ToolSubtitle"] = "Print-accurate layout · fonts · tables · logos";
    ViewData["AcceptHint"] = "DOCX files";
    ViewData["AcceptAttr"] = ".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document";
    ViewData["Multiple"] = false;
    ViewData["BtnIcon"] = "bi-file-earmark-pdf";
    ViewData["BtnLabel"] = "Convert to PDF";
    ViewData["SeoH1"] = "Word to PDF Converter — Keep Formatting & Logos";
    ViewData["SeoLead"] = "Turn DOCX files into print-ready PDFs without broken tables or missing brand assets. Powered by LibreOffice for Acrobat-class output.";
}

@await Html.PartialAsync("_PdfJobToolShell")
@await Html.PartialAsync("_PdfToolInternalLinks")
@await Html.PartialAsync("_PdfToolSeoArticle")

@section Scripts {
<script>
PdfToolkit.initJobTool({
    toolId: 'doctopdf',
    convertUrl: '/PDF/DocToPdf/convert',
    extensions: ['.docx'],
    typeLabel: 'Word DOCX',
    multiple: false,
    defaultFileName: 'converted.pdf',
    dropZoneId: 'dropZone',
    fileInputId: 'fileInput',
    fileListId: 'fileList',
    convertBtnId: 'convertBtn',
    errorAreaId: 'errorArea',
    progressAreaId: 'progressArea',
    progressBarId: 'progressBar',
    progressMsgId: 'progressMsg',
    progressPctId: 'progressPct',
    badgeId: 'usageBadge',
    limitHintId: 'limitHint',
});
</script>
}
