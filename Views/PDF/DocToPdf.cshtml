@{
    ViewData["Title"] = "Convert DOCX to PDF Free online";
    ViewData["Description"] = "Convert Doc and Docx file to PDF online for free. Fast and secure docx to PDF converter.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="60" class="mb-3">
            <h2 class="fw-bold mb-3">DOCX to PDF</h2>
            <p class="text-muted mb-4">Upload a DOCX file to convert it into a PDF document.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="DocToPdf" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3" style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-cloud-arrow-up display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">Drag & drop DOCX here or click to select</p>
                        <input type="file" name="file" class="form-control form-control-lg d-none" id="fileInput" accept=".docx">
                    </div>
                </div>

                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-file-earmark-text-fill me-2"></i> Convert to PDF
                </button>
            </form>
        </div>
    </div>
</div>
<section class="related-tools">
  <h3>Related Tools</h3>
  <ul>
    <li><a href="/PDF/PdfToDoc">PDF to Word</a></li>
    <li><a href="/PDF/ExcelToPdf">Excel to PDF</a></li>
    <li><a href="/PDF/Merge">Merge PDF</a></li>
  </ul>
</section>
<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">
        <h2 class="fw-bold mb-3">How to Convert DOCX to PDF Online</h2>

        <p>
            Our free DOCX to PDF converter lets you convert Microsoft Word documents into
            professional-quality PDF files online. Formatting, fonts, and layout are preserved
            during conversion.
        </p>

        <ol class="mb-4">
            <li>
                <strong>Upload your DOC or DOCX file</strong> by dragging and dropping it into the upload box
                or selecting it from your device.
            </li>
            <li>
                <strong>Click “Convert to PDF”</strong> to start the Word to PDF conversion process.
            </li>
            <li>
                <strong>Download your PDF file</strong> instantly once the conversion is complete.
            </li>
        </ol>

        <h3 class="fw-semibold mt-4">Why Use Our Word to PDF Converter?</h3>
        <ul>
            <li>✔ Convert DOCX and DOC files to PDF for free</li>
            <li>✔ Accurate layout and formatting preservation</li>
            <li>✔ Secure and private file processing</li>
            <li>✔ Works on Windows, Mac, Android, and iOS</li>
            <li>✔ No signup or software installation required</li>
        </ul>

        <p class="mt-3">
            This tool is ideal for resumes, contracts, reports, assignments, and business documents
            that need to be shared in a universal PDF format.
        </p>
    </div>
</div>
@section Scripts {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "SoftwareApplication",
  "name": "Word to PDF Converter",
  "applicationCategory": "UtilityApplication",
  "operatingSystem": "Web",
  "url": "https://ratpdf.com/PDF/DocToPdf",
  "description": "Convert DOC or DOCX files to PDF online for free. Fast, secure, and accurate conversion.",
  "offers": {
    "@@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
<script type="application/ld+json">
@Html.Raw(@"{
  ""@context"": ""https://schema.org"",
  ""@type"": ""FAQPage"",
  ""mainEntity"": [
    {
      ""@type"": ""Question"",
      ""name"": ""How do I convert DOCX to PDF online?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Upload your DOCX or DOC file into the converter, click 'Convert to PDF', and download the resulting PDF instantly.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Can I convert multiple Word files at once?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Currently, the tool converts one DOC or DOCX file at a time. You can repeat the process for multiple files.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Is my document secure during conversion?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Yes, all uploaded documents are securely processed and deleted from our servers after conversion.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Do I need to install software or register?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""No installation or registration is required; the converter is completely free and web-based.""
      }
    },
    {
      ""@type"": ""Question"",
      ""name"": ""Can I use this tool on mobile devices?"",
      ""acceptedAnswer"": {
        ""@type"": ""Answer"",
        ""text"": ""Yes, the Word to PDF converter works on Windows, Mac, Android, and iOS devices.""
      }
    }
  ]
}")
</script>
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');

        function updatePreview() {
            if (fileInput.files.length === 0) {
                filePreview.textContent = '';
                return;
            }
            filePreview.textContent = 'Selected file: ' + fileInput.files[0].name;
        }

        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('border-primary', 'bg-light');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('border-primary', 'bg-light');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-primary', 'bg-light');
            fileInput.files = e.dataTransfer.files;
            updatePreview();
        });

        fileInput.addEventListener('change', updatePreview);
    </script>
}