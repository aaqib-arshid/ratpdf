@using System.Text.Json
@using ratpdf.Constants
@using ratpdf.Helpers
@model ratpdf.Models.SEOPageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonical = $"{PdfToolSeo.SiteUrl}/{Model.RoutePrefix}/{Model.Slug}";
    var toolHref = PdfToolSeo.Canonical(Model.ToolUrl);
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.Description;
    ViewData["CanonicalUrl"] = canonical;
    ViewData["LightLayout"] = true;
    ViewData["SeoToolUrl"] = toolHref;
    ViewData["SeoToolLabel"] = $"Start {Model.ToolLinkText} free";
}

@section Head {
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildSoftwareApplicationLdJson(Model.ToolLinkText, toolHref, Model.Description))
    </script>
    @if (Model.FAQ.Count > 0)
    {
        <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "FAQPage",
          "mainEntity": [
        @for (var i = 0; i < Model.FAQ.Count; i++)
        {
            var faq = Model.FAQ[i];
            <text>    {
              "@@type": "Question",
              "name": @Html.Raw(JsonSerializer.Serialize(faq.Question)),
              "acceptedAnswer": {
                "@@type": "Answer",
                "text": @Html.Raw(JsonSerializer.Serialize(faq.Answer))
              }
            }</text>@(i < Model.FAQ.Count - 1 ? "," : "")
        }
          ]
        }
        </script>
    }
}

<article class="container py-4 py-md-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="@TopicalAuthority.PdfToolsHubPath">PDF tools</a></li>
            <li class="breadcrumb-item"><a href="@toolHref">@Model.ToolLinkText</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Slug</li>
        </ol>
    </nav>

    @await Html.PartialAsync("_PdfToolSocialProof")
    @await Html.PartialAsync("_PdfToolTrustPills")

    <h1 class="fw-bold mb-3">@Model.Title.Replace(" | RatPDF", "")</h1>
    <p class="lead text-muted">@Model.Description</p>

    <div class="d-flex flex-wrap gap-2 mb-4">
        <a href="@toolHref" class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold">
            <i class="bi bi-lightning-charge-fill me-2"></i>@Model.ToolLinkText — free
        </a>
        <a href="/Subscription/Plans?source=seo-landing" class="btn btn-outline-primary btn-lg rounded-pill px-4">Pro @SubscriptionPricing.FormatProShort()</a>
    </div>
    <p class="small text-muted mb-4">3 uses/day · 200 MB · no signup · TLS encrypted · <a href="@SiteEntity.TrustHubPath">Trust center</a></p>

    <div class="seo-landing-body">@Html.Raw(Model.FullContentHtml)</div>

    @if (Model.FAQ.Count > 0)
    {
        <h2 class="h4 fw-semibold mt-5">Frequently Asked Questions</h2>
        @foreach (var faq in Model.FAQ)
        {
            <h3 class="h6 fw-semibold mt-3">@faq.Question</h3>
            <p class="text-muted">@faq.Answer</p>
        }
    }

    @await Html.PartialAsync("_SeoLandingCtaBand")
</article>

@await Html.PartialAsync("_ProgrammaticSeoLinks", Model)

<div class="rp-sticky-seo-cta d-md-none">
    <a href="@toolHref" class="btn btn-primary w-100 rounded-pill fw-semibold">@Model.ToolLinkText — free</a>
</div>
