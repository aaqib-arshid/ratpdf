@model ratpdf.Models.SEOPageModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <title>@Model.Title</title>
    <meta name="description" content="@Model.Description" />
    <link rel="canonical" href="https://ratpdf.com/pdf-to-word/@Model.Slug" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Article",
          "headline": "@Model.Title",
          "description": "@Model.Description",
          "author": { "@@type": "Organization", "name": "RatPDF" },
          "publisher": { "@@type": "Organization", "name": "RatPDF" },
          "mainEntityOfPage": {
            "@@type": "WebPage",
            "@@id": "https://ratpdf.com/pdf-to-word/@Model.Slug"
          }
        }
    </script>

    <!-- FAQ Schema -->
    @if (Model.FAQ.Any())
    {
        <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "FAQPage",
              "mainEntity": [
                @for (int i = 0; i < Model.FAQ.Count; i++)
                {
                                    var faq = Model.FAQ[i];
                                    <text>
                                    {
                                      "@@type": "Question",
                                      "name": "@faq.Question",
                                      "acceptedAnswer": {
                                        "@@type": "Answer",
                                        "text": "@faq.Answer"
                                      }
                                    }@((i < Model.FAQ.Count - 1) ? "," : "")
                                    </text>
                }
              ]
            }
        </script>
    }
}
<div class="container mt-4">
    <h1>@Model.Title</h1>
    <div>@Html.Raw(Model.FullContentHtml)</div>

    @if (Model.FAQ.Any())
    {
        <h2>Frequently Asked Questions</h2>
        @foreach (var faq in Model.FAQ)
        {
            <h3>@faq.Question</h3>
            <p>@faq.Answer</p>
        }
    }

    <p>Use the <a href="https://ratpdf.com/PDF/PdfToDoc">PDF To Word Tool</a> for all your conversion needs.</p>
</div>
