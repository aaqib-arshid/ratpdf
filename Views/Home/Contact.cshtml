@using ratpdf.Constants
@{
    ViewData["Title"] = "Contact Us";
    ViewData["Description"] = "Contact RatPDF for support, questions, or feedback about our online PDF tools.";
}

<head>
    <meta name="robots" content="index, follow">

    <script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>
    <script>
        (function () {
            emailjs.init("hTDWduyc9ut7NaL0E"); 
        })();

        function sendEmail(event) {
            event.preventDefault();

            const form = event.target;

            emailjs.sendForm('service_84ust0p', 'template_bkp6d2i', form)
                .then(function () {
                    window.location.href = "/Home/ThankyouContact";
                }, function (error) {
                    alert("Failed to send message. Please try again later.");
                });
        }
    </script>
</head>

<div class="card p-4">

    <h1>Contact Us</h1>

    <p>
        If you have any questions, suggestions, or need assistance with our PDF tools, please use the contact form below or email us at <a href="mailto:@SiteEntity.ContactEmail">@SiteEntity.ContactEmail</a>.
    </p>

    <hr />

    <form onsubmit="sendEmail(event)">

        <div class="mb-3">
            <label class="form-label">Your Name</label>
            <input type="text" name="name" class="form-control" placeholder="Enter your name" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Email Address</label>
            <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Subject</label>
            <input type="text" name="subject" class="form-control" placeholder="Subject" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="message" rows="5" class="form-control" placeholder="Write your message here..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Send Message</button>

    </form>

    <hr />

    <h4>Support Information</h4>

    <p>
        For faster support, please include details about the tool you were using
        and the issue you experienced.
    </p>

    <ul>
        <li>The PDF tool you used</li>
        <li>Your browser (Chrome, Firefox, etc.)</li>
        <li>Description of the issue</li>
    </ul>

    <hr />

    <p>
        Your privacy matters to us. Any information submitted through this form
        will only be used to respond to your inquiry.
    </p>

    <p>
        Please review our <a href="/Home/Privacy">Privacy Policy</a> for more information.
    </p>

</div>