@{
    ViewData["Title"] = "20+ Unlimited Free PDF Tools Online – Compress, Merge, Split & More | Rat PDF";
    ViewData["Description"] = "All-in-one free PDF toolkit: compress, merge, split, convert, protect, edit PDFs and more. 40+ browser-based tools. No signup, no watermark. Fast & secure.";
}

@section Head {
    <link rel="canonical" href="https://ratpdf.com/" />
    <meta property="og:title" content="Unlimited Free PDF Tools – Compress, Merge, Split & More | Rat PDF" />
    <meta property="og:description" content="Unlimited 20+ free PDF tools: compress, merge, split, convert images to PDF, PDF to Word, and many more. No registration, no watermark." />
    <meta property="og:image" content="https://ratpdf.com/images/ratpdf-logo.png" />
    <meta property="og:url" content="https://ratpdf.com/" />
    <meta property="og:type" content="website" />
}

<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "Rat PDF",
        "url": "https://ratpdf.com",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "https://ratpdf.com/PDF?search={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
</script>
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "Rat PDF",
        "url": "https://ratpdf.com",
        "logo": "https://ratpdf.com/images/ratpdf-logo.png",
        "sameAs": ["https://twitter.com/ratpdf", "https://facebook.com/ratpdf"]
    }
</script>
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "ItemList",
        "name": "Free PDF Tools",
        "itemListElement": [
            { "@@type": "SoftwareApplication", "name": "Compress PDF", "applicationCategory": "Utility" },
            { "@@type": "SoftwareApplication", "name": "Merge PDF", "applicationCategory": "Utility" },
            { "@@type": "SoftwareApplication", "name": "Split PDF", "applicationCategory": "Utility" },
            { "@@type": "SoftwareApplication", "name": "Image to PDF", "applicationCategory": "Utility" },
            { "@@type": "SoftwareApplication", "name": "PDF to Word", "applicationCategory": "Utility" }
        ]
    }
</script>

<div class="rp">
    <!-- Hero Section - Redesigned for multi-tool messaging -->
    <div class="rp-hero">
        <div class="hero-pill">
            <span class="pill-dot"></span>
            No sign-up required <span class="pill-dot"></span> 100% free <span class="pill-dot"></span> 40+ tools
        </div>
        <h1>Professional PDF Tools<br /><span class="blu">Compress, Merge, Convert & Edit</span></h1>
        <p>Everything you need to work with PDFs, images, and documents — all in one place. No installation, no watermarks, no hidden fees.</p>

        <!-- Quick action tools (mini grid) -->
        <div class="hero-quick-tools">
            <a href="/PDF/Compress" class="quick-tool primary">⚡ Compress PDF</a>
            <a href="/PDF/Merge" class="quick-tool">📄 Merge PDF</a>
            <a href="/PDF/Split" class="quick-tool">✂️ Split PDF</a>
            <a href="/PDF/ConvertImages" class="quick-tool">🖼️ Image to PDF</a>
