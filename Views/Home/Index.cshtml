<style>
   
    @@import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap');

    .rp {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(145deg, #f9fafc 0%, #ffffff 100%);
        color: #111827;
        overflow-x: hidden;
    }

   
    .hero-quick-tools {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.75rem;
        max-width: 780px;
        margin: 1.5rem auto 0;
    }
    .quick-tool {
        background: white;
        border-radius: 60px;
        padding: 8px 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1f2937;
        text-decoration: none;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .quick-tool.primary {
        background: linear-gradient(105deg, #2563eb, #4f46e5);
        color: white;
        border: none;
        box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }
    .quick-tool:hover {
        transform: translateY(-2px);
        border-color: #cbd5e1;
        background: #f8fafc;
        text-decoration: none;
    }
    .quick-tool.primary:hover {
        background: linear-gradient(105deg, #1d4ed8, #4338ca);
        box-shadow: 0 6px 14px rgba(37,99,235,0.35);
        color: white;
    }

    
    .rp-hero {
        background: radial-gradient(ellipse at 80% 30%, rgba(37,99,235,0.03), transparent);
        padding: 4rem 2rem 3.5rem;
        text-align: center;
        position: relative;
        border-bottom: none;
    }
    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(37,99,235,0.08);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(37,99,235,0.2);
        border-radius: 100px;
        padding: 6px 16px 6px 10px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #2563eb;
        margin-bottom: 1.5rem;
    }
    .pill-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #2563eb;
        display: inline-block;
        animation: pulse 2s infinite;
    }
    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .rp-hero h1 {
        font-family: 'Lucida Sans', 'Lucida Sans Regular', 'Lucida Grande', 'Lucida Sans Unicode', Geneva, Verdana, sans-serif, Georgia, 'Times New Roman', Times, serif;
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 1rem;
    }
    .rp-hero h1 .blu {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .rp-hero p {
        font-size: 1.1rem;
        color: #4b5563;
        max-width: 550px;
        margin: 0 auto 1rem;
        line-height: 1.6;
    }
    .hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
        background: linear-gradient(105deg, #2563eb, #4f46e5);
        color: white;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        display: inline-block;
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37,99,235,0.3); color: white; text-decoration: none; }
    .btn-outline {
        background: transparent;
        border: 1.5px solid #cbd5e1;
        color: #1f2937;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 500;
        transition: all 0.2s;
        display: inline-block;
    }
    .btn-outline:hover { border-color: #2563eb; color: #2563eb; background: rgba(37,99,235,0.02); text-decoration: none; }

 
    .rp-stats {
        display: flex;
        justify-content: center;
        background: #ffffff;
        border-top: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
        flex-wrap: wrap;
        margin: 0;
    }
    .stat { text-align: center; padding: 1rem 2.5rem; border-right: 1px solid #edf2f7; }
    .stat:last-child { border-right: none; }
    .stat-num { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 700; background: linear-gradient(135deg,#2563eb,#4f46e5); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280; font-weight: 600; }

    
    .rp-section { max-width: 1100px; margin: 0 auto; padding: 3rem 2rem; }
    .sec-tag { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #2563eb; margin-bottom: 0.5rem; }
    .sec-h { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .sec-sub { font-size: 1rem; color: #6b7280; margin-bottom: 2rem; }

    
    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .tool-card {
        background: #fff;
        border-radius: 24px;
        padding: 1.5rem;
        transition: all 0.25s ease;
        text-decoration: none;
        border: 1px solid #eef2f6;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        display: block;
    }
    .tool-card:hover { transform: translateY(-6px); box-shadow: 0 20px 30px -12px rgba(0,0,0,0.1); border-color: #cbdff2; text-decoration: none; }
    .tool-card-featured {
        border: 2px solid #2563eb;
        background: linear-gradient(135deg, #ffffff, #f5f9ff);
        box-shadow: 0 8px 20px rgba(37,99,235,0.12);
