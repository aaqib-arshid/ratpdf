@{
    ViewData["Title"] = "Free PDF Tools Online – Merge, Split, Compress & Convert PDFs | Rat PDF";
    ViewData["Description"] = "Free online PDF tools to convert, merge, split, compress, and edit PDF files easily. Fast, secure and easy to use.";
}
<head>
    <link rel="canonical" href="https://ratpdf.com/" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<div class="container py-5">

    <div class="text-center mb-5">
        <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="80" class="mb-3">
        <h1 class="display-4 fw-bold">Welcome to Rat PDF</h1>
        <p class="lead text-muted">Convert, merge, and manage your PDF files quickly and easily — all online and free to start!</p>
        <a class="btn btn-primary btn-lg mt-3" asp-controller="PDF" asp-action="ConvertImages">
            <i class="bi bi-file-earmark-pdf-fill me-2"></i> Convert Images to PDF
        </a>
    </div>


    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-file-earmark-arrow-up-fill display-3 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Image to PDF</h5>
                    <p class="card-text text-muted">Convert JPG, PNG, and GIF images into high-quality PDF files quickly and easily.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-files display-3 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Merge PDFs</h5>
                    <p class="card-text text-muted">Combine multiple PDF documents into a single file in just a few clicks.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <i class="bi bi-scissors display-3 text-primary mb-3"></i>
                    <h5 class="card-title fw-bold">Split PDFs</h5>
                    <p class="card-text text-muted">Split large PDFs into smaller files or extract specific pages with ease.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 text-center">
        <h2 class="fw-bold mb-3">Why Choose Rat PDF?</h2>
        <p class="text-muted mb-4">Fast, reliable, and completely browser-based. No installations, no upload to server/server storage, no external dependencies — just upload your files and get results instantly.</p>
        <a class="btn btn-outline-primary btn-lg" asp-controller="PDF" asp-action="ConvertImages">
            Try It Now
        </a>
    </div>
</div>
<section class="tools-section">
    <h2 class="tools-title">Free PDF & Utility Tools</h2>

    <ul class="tools-grid">
        <li><a href="/PDF/Merge"><span>Merge PDF</span></a></li>
        <li><a href="/PDF/Split"><span>Split PDF</span></a></li>
        <li><a href="/PDF/Compress"><span>Compress PDF</span></a></li>
        <li><a href="/PDF/ConvertImages"><span>Images to PDF</span></a></li>
        <li><a href="/PDF/TextToPdf"><span>Text to PDF</span></a></li>
        <li><a href="/PDF/PdfToText"><span>PDF to Text</span></a></li>
        <li><a href="/PDF/DocToPdf"><span>Word to PDF</span></a></li>
        <li><a href="/PDF/PdfToDoc"><span>PDF to Word</span></a></li>
        <li><a href="/PDF/PdfToExcel"><span>PDF to Excel</span></a></li>
        <li><a href="/PDF/ExcelToPdf"><span>Excel to PDF</span></a></li>
        <li><a href="/PDF/Watermark"><span>Add Watermark</span></a></li>
        <li><a href="/PDF/Password"><span>Protect PDF</span></a></li>
        <li><a href="/PDF/RotateOrRemove"><span>Rotate PDF</span></a></li>
        <li><a href="/PDF/SignText"><span>Sign PDF</span></a></li>
        <li><a href="/PDF/ImageCompressor"><span>Image Compressor</span></a></li>
        <li><a href="/PDF/ImgToBase64"><span>Image to Base64</span></a></li>
        <li><a href="/PDF/HtmlFormatter"><span>HTML Formatter</span></a></li>
        <li><a href="/PDF/JsonFormatter"><span>JSON Formatter</span></a></li>
        <li><a href="/PDF/JwtDecoder"><span>JWT Decoder</span></a></li>
        <li><a href="/Tools/RingSizeConverter"><span>Ring Size Converter</span></a></li>
        <li><a href="/Tools/WordCounter"><span>Word Counter</span></a></li>
        <li><a href="/Tools/WhatIsMyIP"><span>What Is My IP</span></a></li>
        <li><a href="/Tools/IpLookup"><span>Ip Lookup</span></a></li>
        <li><a href="/Tools/ImgBackgroundRemove"><span>Remove Img Background</span></a></li>
    </ul>
</section>
<style>
    .tools-section {
        margin: 40px auto;
        max-width: 1200px;
        padding: 0 16px;
    }

    .tools-title {
        font-size: 1.6rem;
        margin-bottom: 20px;
        text-align: center;
    }

    .tools-grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 16px;
    }

        .tools-grid li a {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 90px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            text-decoration: none;
            color: #111827;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .tools-grid li a:hover {
                background: #f9fafb;
                border-color: #2563eb;
                color: #2563eb;
                transform: translateY(-2px);
            }

            .tools-grid li a span {
                text-align: center;
                padding: 0 8px;
            }
</style>