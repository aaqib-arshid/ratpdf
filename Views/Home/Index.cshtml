@{
    ViewData["Title"] = "Compress PDF Online – Free PDF Compressor | Reduce Size Up to 90% | Rat PDF";
    ViewData["Description"] = "Compress PDF files online for free – reduce PDF size up to 90% without losing quality. 40+ free tools for PDF, images, dev, and utilities. Fast, secure, no sign-up.";
}

@section Head {
    <link rel="canonical" href="https://ratpdf.com/" />
    <meta property="og:title" content="Compress PDF Online – Free PDF Compressor | Rat PDF" />
    <meta property="og:description" content="Reduce PDF size up to 90% instantly. No watermark, no sign-up. Plus 40+ free tools." />
    <meta property="og:image" content="https://ratpdf.com/images/ratpdf-logo.png" />
    <meta property="og:url" content="https://ratpdf.com/" />
    <meta property="og:type" content="website" />
}

<!-- Structured Data LD-JSON (unchanged) -->
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "Rat PDF",
        "url": "https://ratpdf.com",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "https://ratpdf.com/PDF?search={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
</script>
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "Rat PDF",
        "url": "https://ratpdf.com",
        "logo": "https://ratpdf.com/images/ratpdf-logo.png",
        "sameAs": ["https://twitter.com/ratpdf", "https://facebook.com/ratpdf"]
    }
</script>
<script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Rat PDF Compressor",
        "applicationCategory": "Utility",
        "operatingSystem": "Web",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.9",
            "ratingCount": "5234"
        }
    }
</script>

<div class="rp">
    <!-- Hero Section -->
    <div class="rp-hero">
        <div class="hero-pill">
            <span class="pill-dot"></span>
            No signup <span class="pill-dot"></span> No installation <span class="pill-dot"></span> 100% Free
        </div>
        <h1>Compress PDF Online<br /><span class="blu">Reduce Size Up to 90%</span></h1>
        <p>Make your PDFs smaller instantly – perfect for emails, uploads, and storage. No watermarks, no registration, no limits.</p>

        <div class="hero-compress-box">
            <div class="compress-badges">
                <span>⚡ Up to 90% smaller</span>
                <span>🔒 Auto-delete after 2h</span>
                <span>💧 No watermark</span>
            </div>
        </div>

        <div class="hero-btns">
            <a href="/PDF/Compress" class="btn-primary">Start Compressing PDF →</a>
            <a href="/Home/About" class="btn-outline">Learn more</a>
        </div>
    </div>

    <!-- Stats Bar -->
    <div class="rp-stats">
        <div class="stat"><div class="stat-num">40+</div><div class="stat-label">Free Tools</div></div>
        <div class="stat"><div class="stat-num">100%</div><div class="stat-label">Browser-based</div></div>
        <div class="stat"><div class="stat-num">0</div><div class="stat-label">Files Stored</div></div>
        <div class="stat"><div class="stat-num">Free</div><div class="stat-label">Always</div></div>
    </div>

    <!-- Popular Tools -->
    <div class="rp-section">
        <div class="sec-tag">Popular Tools</div>
        <div class="sec-h">Everything you need</div>
        <div class="sec-sub">All tools work directly in your browser — no installs, no accounts needed.</div>
        <div class="tools-grid">
            <a href="/PDF/Compress" class="tool-card tool-card-featured">
                <div class="tool-icon ic-g">⚡</div>
                <h3>Compress PDF</h3>
                <p>Reduce PDF file size without losing quality. Our flagship tool – fast, free, private.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
            <a href="/PDF/ConvertImages" class="tool-card">
                <div class="tool-icon ic-b">🖼️</div>
                <h3>Image to PDF</h3>
                <p>Convert JPG or PNG images into a PDF instantly.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
            <a href="/PDF/Merge" class="tool-card">
                <div class="tool-icon ic-p">📄</div>
                <h3>Merge PDFs</h3>
                <p>Combine multiple PDF files into one document easily.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
            <a href="/PDF/Split" class="tool-card">
                <div class="tool-icon ic-c">✂️</div>
                <h3>Split PDF</h3>
                <p>Extract or split PDF pages with just one click.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
            <a href="/Invoice/Create" class="tool-card">
                <div class="tool-icon ic-a">🧾</div>
                <h3>Free Invoice Generator</h3>
                <p>Create professional GST invoices instantly.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
            <a href="/Tools/WordCounter" class="tool-card">
                <div class="tool-icon ic-pk">📝</div>
                <h3>Word Counter</h3>
                <p>Count words, characters and reading time easily.</p>
                <div class="tool-tag">Try Free →</div>
            </a>
        </div>
    </div>

    <!-- Why Rat PDF -->
    <div class="rp-section pt-0">
        <div class="sec-tag">Why Rat PDF</div>
        <div class="sec-h">Built for speed &amp; privacy</div>
        <div class="sec-sub">No bloat. No ads. No data collection. Just tools that work.</div>
        <div class="why-grid">
            <div class="why-card"><div class="why-icon">🔒</div><div><h4>No file storage</h4><p>Files are processed securely and never stored on our servers permanently.</p></div></div>
            <div class="why-card"><div class="why-icon">⚡</div><div><h4>Lightning fast</h4><p>Lightweight browser-based processing — results ready in seconds.</p></div></div>
            <div class="why-card"><div class="why-icon">📱</div><div><h4>Works everywhere</h4><p>Fully responsive — works on mobile, tablet, and desktop.</p></div></div>
            <div class="why-card"><div class="why-icon">🆓</div><div><h4>Always free</h4><p>All core tools are free with no hidden paywalls or surprise charges.</p></div></div>
        </div>
    </div>

    <!-- Guides -->
    <div class="rp-section pt-0">
        <div class="sec-tag">Helpful Guides</div>
        <div class="sec-h">Learn how to use our tools</div>
        <div class="sec-sub">Step-by-step tutorials to get the best results.</div>
        <a href="/guides/compress-pdf-guide" class="guide-box"><span>📘 Compress PDF — Complete Guide</span><span class="guide-arr">→</span></a>
        <a href="/guides/pdf-txt-guide" class="guide-box"><span>📘 Pdf To Text — Complete Guide</span><span class="guide-arr">→</span></a>
        <a href="/guides/background-remover" class="guide-box"><span>📘 Remove image background — Complete Guide</span><span class="guide-arr">→</span></a>
        <a href="/guides/ring-size-converter-guide" class="guide-box"><span>📘 Ring Size Calculator or Converter — Complete Guide</span><span class="guide-arr">→</span></a>
        <a href="/guides/word-counter-guide" class="guide-box"><span>📘 Word And Character Counting — Complete Guide</span><span class="guide-arr">→</span></a>
        <a href="/guides/my-ip-guide" class="guide-box"><span>📘 What Is My IP — Complete Guide</span><span class="guide-arr">→</span></a>
    </div>

    <!-- FAQ -->
    <div class="rp-section pt-0">
        <div class="sec-tag">FAQ</div>
        <div class="sec-h">Common questions</div>
        <div class="faq-list">
            <div class="faq-item" id="f1"><div class="faq-q" onclick="toggleFaq('f1')">Is Rat PDF completely free?<span class="ch">+</span></div><div class="faq-a">Yes — all basic tools are 100% free. No signup, no credit card, no hidden charges at all.</div></div>
            <div class="faq-item" id="f2"><div class="faq-q" onclick="toggleFaq('f2')">Do I need to install anything?<span class="ch">+</span></div><div class="faq-a">No installation needed. Everything runs directly in your browser — just open a tool and start using it.</div></div>
            <div class="faq-item" id="f3"><div class="faq-q" onclick="toggleFaq('f3')">Is my data safe and private?<span class="ch">+</span></div><div class="faq-a">Yes. Files are processed securely and not stored permanently on our servers. Your privacy is our priority.</div></div>
            <div class="faq-item" id="f4"><div class="faq-q" onclick="toggleFaq('f4')">Can I use Rat PDF on my phone?<span class="ch">+</span></div><div class="faq-a">Absolutely — Rat PDF is fully mobile responsive and works on any smartphone or tablet browser.</div></div>
        </div>
    </div>

    <!-- CTA Banner -->
    <div class="rp-cta">
        <h2>Ready to compress your PDF?</h2>
        <p>Free tools. No signup. Results in seconds.</p>
        <a href="/PDF/Compress" class="btn-white">Start Compressing PDF →</a>
    </div>
</div>

<style>
    /* ---- Google Fonts & Base ---- */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=Syne:wght@400;500;600;700;800&display=swap');

    .rp {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(145deg, #f9fafc 0%, #ffffff 100%);
        color: #111827;
        overflow-x: hidden;
    }

    /* ---- Hero Section ---- */
    .rp-hero {
        background: radial-gradient(ellipse at 80% 30%, rgba(37,99,235,0.03), transparent);
        padding: 4rem 2rem 3.5rem;
        text-align: center;
        position: relative;
        border-bottom: none;
    }
    .hero-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(37,99,235,0.08);
        backdrop-filter: blur(4px);
        border: 1px solid rgba(37,99,235,0.2);
        border-radius: 100px;
        padding: 6px 16px 6px 10px;
        font-size: 0.8rem;
        font-weight: 500;
        color: #2563eb;
        margin-bottom: 1.5rem;
    }
    .pill-dot {
        width: 6px; height: 6px;
        border-radius: 50%;
        background: #2563eb;
        display: inline-block;
        animation: pulse 2s infinite;
    }
    @@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
    .rp-hero h1 {
        font-family: 'Syne', sans-serif;
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 1rem;
    }
    .rp-hero h1 .blu {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .rp-hero p {
        font-size: 1.1rem;
        color: #4b5563;
        max-width: 550px;
        margin: 0 auto 1.8rem;
        line-height: 1.6;
    }
    .hero-compress-box {
        max-width: 620px;
        margin: 2rem auto;
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border-radius: 32px;
        padding: 1.8rem;
        box-shadow: 0 20px 35px -12px rgba(0,0,0,0.12), 0 0 0 1px rgba(37,99,235,0.08);
        transition: all 0.3s ease;
    }
    .compress-preview {
        background: #ffffff;
        border-radius: 28px;
        padding: 1.5rem;
        border: 2px dashed #d1d5db;
        transition: all 0.2s;
    }
    .compress-preview:hover {
        border-color: #2563eb;
        background: #f8fafc;
    }
    .upload-icon { font-size: 3.5rem; margin-bottom: 0.25rem; }
    .upload-text { font-size: 0.9rem; color: #6b7280; font-weight: 500; }
    .btn-hero-compress {
        background: linear-gradient(105deg, #2563eb, #4f46e5);
        color: white;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 6px 14px rgba(37,99,235,0.3);
        transition: all 0.2s;
    }
    .btn-hero-compress:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 22px rgba(37,99,235,0.35);
        color: white;
    }
    .compress-badges {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        margin-top: 1.2rem;
        flex-wrap: wrap;
    }
    .compress-badges span {
        background: #eef2ff;
        padding: 5px 12px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 600;
        color: #2563eb;
        letter-spacing: 0.3px;
    }
    .hero-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-primary {
        background: linear-gradient(105deg, #2563eb, #4f46e5);
        color: white;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37,99,235,0.3); color: white; }
    .btn-outline {
        background: transparent;
        border: 1.5px solid #cbd5e1;
        color: #1f2937;
        padding: 12px 28px;
        border-radius: 40px;
        font-weight: 500;
        transition: all 0.2s;
    }
    .btn-outline:hover { border-color: #2563eb; color: #2563eb; background: rgba(37,99,235,0.02); }

    /* Stats */
    .rp-stats {
        display: flex;
        justify-content: center;
        background: #ffffff;
        border-top: 1px solid #edf2f7;
        border-bottom: 1px solid #edf2f7;
        flex-wrap: wrap;
        margin: 0;
    }
    .stat { text-align: center; padding: 1rem 2.5rem; border-right: 1px solid #edf2f7; }
    .stat:last-child { border-right: none; }
    .stat-num { font-family: 'Syne', sans-serif; font-size: 1.8rem; font-weight: 700; background: linear-gradient(135deg,#2563eb,#4f46e5); -webkit-background-clip:text; background-clip:text; color:transparent; }
    .stat-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: #6b7280; font-weight: 600; }

    /* Section Headers */
    .rp-section { max-width: 1100px; margin: 0 auto; padding: 3rem 2rem; }
    .sec-tag { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #2563eb; margin-bottom: 0.5rem; }
    .sec-h { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 700; color: #0f172a; letter-spacing: -0.02em; margin-bottom: 0.5rem; }
    .sec-sub { font-size: 1rem; color: #6b7280; margin-bottom: 2rem; }

    /* Tools Grid */
    .tools-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .tool-card {
        background: #fff;
        border-radius: 24px;
        padding: 1.5rem;
        transition: all 0.25s ease;
        text-decoration: none;
        border: 1px solid #eef2f6;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .tool-card:hover { transform: translateY(-6px); box-shadow: 0 20px 30px -12px rgba(0,0,0,0.1); border-color: #cbdff2; text-decoration: none; }
    .tool-card-featured {
        border: 2px solid #2563eb;
        background: linear-gradient(135deg, #ffffff, #f5f9ff);
        box-shadow: 0 8px 20px rgba(37,99,235,0.12);
        transform: scale(1.02);
    }
    .tool-icon { width: 48px; height: 48px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 1rem; background: #f1f5f9; }
    .ic-g { background: #dbeafe; color: #2563eb; }
    .tool-card h3 { font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; margin: 0 0 0.4rem; color: #0f172a; }
    .tool-card p { font-size: 0.8rem; color: #6b7280; line-height: 1.4; margin-bottom: 1rem; }
    .tool-tag { font-size: 0.7rem; font-weight: 600; color: #2563eb; }

    /* Why Grid */
    .why-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 1rem; }
    .why-card { background: #fff; border-radius: 20px; padding: 1.2rem; display: flex; gap: 1rem; align-items: flex-start; border: 1px solid #edf2f7; transition: all 0.2s; }
    .why-card:hover { border-color: #bfdbfe; box-shadow: 0 5px 12px rgba(0,0,0,0.02); }
    .why-icon { width: 44px; height: 44px; background: #eef2ff; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 1.3rem; }
    .why-card h4 { font-weight: 700; font-size: 1rem; margin-bottom: 0.25rem; color: #0f172a; }
    .why-card p { font-size: 0.75rem; color: #6b7280; line-height: 1.4; }

    /* Guide Boxes */
    .guide-box {
        background: #fff;
        border-radius: 18px;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        border: 1px solid #eef2f6;
        margin-bottom: 0.8rem;
        transition: all 0.2s;
    }
    .guide-box:hover { border-color: #2563eb; background: #fafcff; transform: translateX(4px); }
    .guide-box span:first-child { font-weight: 500; color: #1f2937; }
    .guide-arr { color: #2563eb; font-weight: 600; }

    /* FAQ */
    .faq-list { display: flex; flex-direction: column; gap: 0.75rem; }
    .faq-item { background: #fff; border-radius: 18px; border: 1px solid #edf2f7; overflow: hidden; transition: all 0.2s; }
    .faq-q { padding: 1rem 1.2rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: #0f172a; }
    .faq-q:hover { background: #f8fafc; }
    .faq-a { display: none; padding: 0 1.2rem 1rem; font-size: 0.9rem; color: #4b5563; line-height: 1.5; }
    .faq-item.open .faq-a { display: block; }
    .ch { font-size: 1.3rem; color: #94a3b8; transition: transform 0.2s; }
    .faq-item.open .ch { transform: rotate(45deg); color: #2563eb; }

    /* CTA */
    .rp-cta {
        margin: 2rem 2rem 3rem;
        border-radius: 32px;
        background: linear-gradient(115deg, #1e293b, #0f172a);
        padding: 3rem 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .rp-cta::before {
        content: '';
        position: absolute;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(37,99,235,0.2), transparent);
        top: -100px;
        right: -80px;
        border-radius: 50%;
    }
    .rp-cta h2 { font-family: 'Syne', sans-serif; font-size: 2rem; font-weight: 700; color: white; margin-bottom: 0.5rem; }
    .rp-cta p { color: #cbd5e1; margin-bottom: 1.5rem; }
    .btn-white { background: white; color: #2563eb; padding: 12px 30px; border-radius: 40px; font-weight: 600; transition: all 0.2s; display: inline-block; }
    .btn-white:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.2); color: #1e40af; text-decoration: none; }

    /* Responsive */
    @@media (max-width: 768px) {
        .rp-hero h1 { font-size: 2.2rem; }
        .hero-compress-box { margin: 1rem; padding: 1rem; }
        .tools-grid { grid-template-columns: 1fr; }
        .why-grid { grid-template-columns: 1fr; }
        .stat { padding: 0.75rem 1rem; }
        .rp-section { padding: 2rem 1rem; }
        .rp-cta { margin: 1rem; padding: 2rem 1rem; }
        .tool-card-featured { transform: none; }
    }
</style>

<script>
    function toggleFaq(id) {
        document.getElementById(id).classList.toggle('open');
    }
</script>