@using ratpdf.Constants
@using ratpdf.Content
@using ratpdf.Helpers
@{
    ViewData["FullWidth"] = true;
    var featuredGuides = ContentLibrary.Guides.Take(6).ToList();
    var latestPosts = ContentLibrary.Blogs.OrderByDescending(b => b.Published).Take(4).ToList();
    ViewData["Title"] = "Free PDF Tools Online — Compress, Merge, PDF to Word | RatPDF";
    ViewData["Description"] = $"RatPDF: {PdfToolSeo.ToolCountLabel} free PDF tools with Ghostscript, LibreOffice & pdf2docx engines. Compress, merge, split, convert PDF to Word/Excel. Guides, invoices & Pro from $8.99/mo.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/");
}

@section Head {
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildWebPageLdJson(
        ViewData["Title"]!.ToString()!,
        ViewData["Description"]!.ToString()!,
        PdfToolSeo.Canonical("/"),
        "WebPage",
        new[] { "h1", ".lead", ".rp-ai-summary" }))
    </script>
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildItemListLdJson(
        "RatPDF Free PDF Tools",
        PdfToolSeo.AllTools.Take(12).Select(t => (t.Name, PdfToolSeo.Canonical(t.Url)))))
    </script>
}

<div class="rp rp-home">
    <section class="rp-home-hero">
        @* Speakable / AI summary — visually hidden; keeps schema target without cluttering hero *@
        <div class="visually-hidden rp-ai-summary" aria-hidden="true">
            <p>@SiteEntity.Description</p>
            <p>@SiteEntity.CitePageWithDate("Free PDF Tools Online", "/", DateTime.UtcNow)</p>
        </div>
        <p class="rp-hero-eyebrow"><i class="bi bi-stars"></i> @ContentLibrary.Guides.Count() guides · @ContentLibrary.Blogs.Count() articles · @PdfToolSeo.ToolCountLabel PDF tools</p>
        <h1>Professional PDF tools &amp; tutorials you can trust</h1>
        <p class="lead">Compress, merge, and convert documents with production-grade engines — plus step-by-step guides for every tool.</p>
        <div class="rp-hero-actions">
            <a href="/pdf/compress" class="rp-tool-pill-home primary"><i class="bi bi-lightning-charge-fill"></i> Compress PDF</a>
            <a href="/pdf/merge" class="rp-tool-pill-home"><i class="bi bi-files"></i> Merge PDF</a>
            <a href="/pdf/pdftodoc" class="rp-tool-pill-home"><i class="bi bi-file-earmark-word"></i> PDF to Word</a>
            <a href="/invoice/create" class="rp-tool-pill-home"><i class="bi bi-receipt"></i> Invoice Generator</a>
            <a href="/guides/pdf-tools" class="rp-tool-pill-home"><i class="bi bi-grid-3x3-gap"></i> PDF Tools Hub</a>
        </div>
        <a href="#all-pdf-tools" class="btn btn-outline-primary rounded-pill px-4">Browse all tools</a>
    </section>

    <div class="rp-trust-row">
        <div class="rp-trust-item"><strong>@PdfToolSeo.ToolCountLabel</strong><span>PDF tools</span></div>
        <div class="rp-trust-item"><strong>@ContentLibrary.Guides.Count()</strong><span>Guides</span></div>
        <div class="rp-trust-item"><strong>200 MB</strong><span>Free upload</span></div>
        <div class="rp-trust-item"><strong>4 GB</strong><span>Pro upload</span></div>
        <div class="rp-trust-item"><strong>@SubscriptionPricing.FormatProShort()</strong><span>Pro plan</span></div>
    </div>

    <div class="text-center mb-4 d-flex flex-wrap justify-content-center align-items-center gap-3">
        <a href="https://startupfa.me/s/ratpdf?utm_source=ratpdf.com" target="_blank" rel="noopener noreferrer">
            <img src="https://startupfa.me/badges/featured-badge-small.webp" alt="Featured on Startup Fame" width="224" height="36" loading="lazy" />
        </a>
        <a href="https://peerpush.com/p/rat-pdf" target="_blank" rel="noopener">
            <img src="https://peerpush.com/p/rat-pdf/badge.png" alt="Rat PDF on PeerPush" width="230" height="36" loading="lazy" />
        </a>
    </div>

    <section class="rp-section-home">
        <div class="rp-section-head">
            <span class="rp-sec-label">Popular tools</span>
            <h2>Start here</h2>
            <p>Free browser tools with step-by-step guides for each task.</p>
        </div>
        <div class="row g-3">
            @foreach (var pillar in TopicalAuthority.Pillars)
            {
                var guide = ContentLibrary.GetGuideForToolUrl(pillar.Path);
                <div class="col-md-6 col-lg-4">
                    <a href="@pillar.Path" class="rp-guide-card d-block text-decoration-none h-100">
                        <h3 class="h6 fw-bold text-dark mb-1">@pillar.Label</h3>
                        <p class="small text-muted mb-0">@pillar.Description</p>
                        @if (guide != null)
                        {
                            <span class="small text-primary d-block mt-2">Includes step-by-step guide →</span>
                        }
                    </a>
                </div>
            }
            <div class="col-md-6 col-lg-4">
                <a href="@TopicalAuthority.SecureWorkflowPath" class="rp-guide-card d-block text-decoration-none h-100">
                    <h3 class="h6 fw-bold text-dark mb-1">Secure PDF workflow</h3>
                    <p class="small text-muted mb-0">Watermark, sign, password-protect, and unlock before you share.</p>
                </a>
            </div>
        </div>
        <div class="text-center mt-3"><a href="@TopicalAuthority.CompareHubPath" class="btn btn-outline-secondary rounded-pill px-4 me-2">Compare vs competitors</a><a href="@TopicalAuthority.PdfToolsHubPath" class="btn btn-outline-primary rounded-pill px-4">Browse all @PdfToolSeo.AllTools.Length tools</a></div>
    </section>

    <section class="rp-section-home">
        <div class="rp-section-head">
            <span class="rp-sec-label">Blog</span>
            <h2>Latest articles</h2>
            <p>Practical PDF workflows for freelancers and small businesses.</p>
        </div>
        <div class="row g-3">
            @foreach (var post in latestPosts)
            {
                <div class="col-md-6">
                    <article class="rp-editorial-card">
                        <span class="rp-badge">@post.Category</span>
                        <h3 class="mt-2"><a href="@post.Path" class="text-dark text-decoration-none">@post.Title</a></h3>
                        <p class="small text-muted mb-2">@post.Description</p>
                        <a href="@post.Path" class="small fw-semibold">Read article →</a>
                    </article>
                </div>
            }
        </div>
        <div class="text-center mt-3"><a href="/blog" class="btn btn-outline-primary btn-sm rounded-pill">All blog posts</a></div>
    </section>

    <section class="rp-section-home">
        <div class="rp-section-head">
            <span class="rp-sec-label">Tutorials</span>
            <h2>Guides for every tool</h2>
            <p>Read how each tool works, then run the job in your browser.</p>
        </div>
        <div class="row g-3">
            @foreach (var g in featuredGuides)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="@g.Path" class="rp-guide-card d-block text-decoration-none h-100">
                        <span class="rp-badge">@g.Category</span>
                        <h3 class="h6 fw-bold text-dark mt-2 mb-1">@g.Title</h3>
                        <p class="small text-muted mb-0">@g.Description</p>
                    </a>
                </div>
            }
        </div>
        <div class="text-center mt-3"><a href="/guides" class="btn btn-primary rounded-pill px-4">View all @ContentLibrary.Guides.Count() guides</a></div>
    </section>

    <section class="rp-section-home">
        <div class="rp-section-head">
            <span class="rp-sec-label">Why RatPDF</span>
            <h2>Built for real document work</h2>
            <p>Production engines, honest privacy, and editorial content on every major tool.</p>
