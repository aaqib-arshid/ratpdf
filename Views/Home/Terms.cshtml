@using ratpdf.Constants
@using ratpdf.Helpers
@{
    ViewData["Title"] = "Terms & Conditions — RatPDF";
    ViewData["Description"] = "Terms and conditions for using RatPDF online PDF tools. User responsibilities, file handling, service limits, and acceptable use.";
    ViewData["CanonicalUrl"] = PdfToolSeo.Canonical("/home/terms");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head {
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildWebPageLdJson(
        "RatPDF Terms & Conditions",
        ViewData["Description"]!.ToString()!,
        PdfToolSeo.Canonical("/home/terms"),
        "WebPage",
        new[] { "h1", "section" }))
    </script>
}

<article class="container my-5">
    <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius: 16px;">
        <h1 class="fw-bold mb-3">Terms &amp; Conditions</h1>
        <p class="text-muted">Last updated: June 2025</p>
        <p>
            Welcome to <strong>@SiteEntity.Name</strong>. By accessing or using our website and online PDF tools,
            you agree to these Terms &amp; Conditions. If you do not agree, please do not use our services.
        </p>

        <section aria-labelledby="use-of-services">
            <h2 id="use-of-services" class="h5 fw-semibold mt-4">1. Use of services</h2>
            <p>
                @SiteEntity.Name provides browser-based tools for processing PDF files including conversion,
                compression, merging, splitting, editing, OCR, and business document generation.
            </p>
            <p>By using our services, you agree that you will:</p>
            <ul>
                <li>Use the website only for lawful purposes.</li>
                <li>Not attempt to misuse, reverse-engineer, or disrupt the functionality of the website.</li>
                <li>Not upload or process illegal, harmful, or malicious content.</li>
                <li>Respect daily usage limits on the free tier (3 uses per tool per day, 200 MB per file).</li>
            </ul>
        </section>

        <section aria-labelledby="file-processing">
            <h2 id="file-processing" class="h5 fw-semibold mt-4">2. File processing &amp; privacy</h2>
            <p>
                @SiteEntity.Name processes most PDF operations on secure cloud servers (Microsoft Azure).
                This is described in detail in our <a href="@SiteEntity.PrivacyPath">Privacy Policy</a>
                and <a href="@SiteEntity.SecurityPath">Security policy</a>.
            </p>
            <ul>
                <li>Files are transmitted over HTTPS (TLS) to our application servers for processing.</li>
                <li>Uploaded files are stored temporarily only for the duration of the conversion job.</li>
                <li>Output files may be held in private cloud storage until you download them or they expire.</li>
                <li>Automated cleanup jobs delete stale files and job metadata on a schedule.</li>
                <li>Some lightweight utilities (formatters, counters, previews) may process data entirely in your browser; each tool page describes its behaviour.</li>
            </ul>
            <p>
                We do not manually review document contents except when investigating abuse or technical failures you report.
                You remain fully responsible for the files you choose to process.
            </p>
        </section>

        <section aria-labelledby="user-responsibility">
            <h2 id="user-responsibility" class="h5 fw-semibold mt-4">3. User responsibility</h2>
            <p>You are solely responsible for:</p>
            <ul>
                <li>The files you upload or process using our tools.</li>
                <li>Ensuring that you have the legal rights to use and modify those files.</li>
                <li>Ensuring your content does not violate any laws, copyrights, or third-party rights.</li>
                <li>Verifying important documents after processing (conversion quality varies by file type).</li>
            </ul>
            <p>@SiteEntity.Name does not monitor the content of files processed by users.</p>
        </section>

        <section aria-labelledby="subscriptions">
            <h2 id="subscriptions" class="h5 fw-semibold mt-4">4. Subscriptions &amp; payments</h2>
            <p>
                Pro subscriptions are billed through <strong>Razorpay</strong>. By subscribing, you agree to the
                pricing and billing terms shown on our <a href="/subscription/plans">Plans page</a>.
                Refunds are handled according to the policy stated at checkout.
            </p>
        </section>

        <section aria-labelledby="service-availability">
            <h2 id="service-availability" class="h5 fw-semibold mt-4">5. Service availability</h2>
            <p>
                While we strive to keep our services available, we do not guarantee uninterrupted or error-free operation.
                We may temporarily suspend or modify services for maintenance, updates, or security improvements.
            </p>
        </section>

        <section aria-labelledby="limitation">
            <h2 id="limitation" class="h5 fw-semibold mt-4">6. Limitation of liability</h2>
            <p>@SiteEntity.Name is provided on an <strong>"as-is" and "as-available"</strong> basis.</p>
            <p>We make no warranties regarding accuracy, compatibility with all file types, or continuous service.</p>
            <p>
                Under no circumstances shall @SiteEntity.Name be liable for any direct, indirect, incidental,
                or consequential damages resulting from the use of our website or tools.
            </p>
        </section>

        <section aria-labelledby="ip">
            <h2 id="ip" class="h5 fw-semibold mt-4">7. Intellectual property</h2>
            <p>
                All website content including text, design, branding, logos, and software is the property of
                @SiteEntity.Name unless otherwise stated. You may not copy, reproduce, distribute, or modify
                any part of the website without permission.
            </p>
        </section>

        <section aria-labelledby="third-party">
            <h2 id="third-party" class="h5 fw-semibold mt-4">8. Third-party services</h2>
            <p>
                Our website may use third-party services including analytics providers and advertising networks
                such as <strong>Google AdSense</strong>. These services may use cookies in accordance with their
                own privacy policies. See our <a href="@SiteEntity.PrivacyPath">Privacy Policy</a> for details.
            </p>
        </section>

        <section aria-labelledby="security">
            <h2 id="security" class="h5 fw-semibold mt-4">9. Security</h2>
            <p>We implement reasonable security measures including:</p>
            <ul>
                <li>HTTPS encrypted connections for all uploads and downloads</li>
                <li>Private cloud storage with no public listing of uploads</li>
                <li>Automated deletion of temporary files</li>
                <li>Least-privilege access to production systems</li>
            </ul>
            <p>
                Users should also take appropriate precautions when handling sensitive documents online.
                See our <a href="@SiteEntity.SecurityPath">Security policy</a> for full details.
            </p>
        </section>

        <section aria-labelledby="changes">
            <h2 id="changes" class="h5 fw-semibold mt-4">10. Changes to terms</h2>
            <p>
                We may update these Terms &amp; Conditions at any time. Changes take effect upon posting on this page.
                Continued use of the site after changes constitutes acceptance of the updated terms.
            </p>
        </section>

        <section aria-labelledby="contact">
            <h2 id="contact" class="h5 fw-semibold mt-4">11. Contact</h2>
            <p>
                Questions about these terms? Visit our <a href="@SiteEntity.ContactPath">Contact page</a>
                or email <a href="mailto:@SiteEntity.ContactEmail">@SiteEntity.ContactEmail</a>.
            </p>
        </section>
    </div>
</article>
