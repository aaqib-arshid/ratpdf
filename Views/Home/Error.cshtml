@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5 text-center" style="max-width: 560px;">
    <h1 class="fw-bold text-danger mb-3">Something went wrong</h1>
    <p class="text-muted mb-4">
        We hit an unexpected problem while loading this page. Please try again, or go back to the homepage.
    </p>
    <a href="/" class="btn btn-primary rounded-pill px-4">Back to home</a>
    <p class="text-muted small mt-4 mb-0">Reference: @Context.TraceIdentifier</p>
</div>
