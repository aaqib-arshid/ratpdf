@using ratpdf.Constants
@{
    var category = ViewData["RelatedToolCategory"] as string
        ?? SiteToolNavigation.InferRelatedCategory(Context.Request.Path.Value);
    if (string.IsNullOrEmpty(category)) return;

    var current = Context.Request.Path.Value ?? "";
    var tools = SiteToolNavigation.GetRelatedTools(category, current);
    if (tools.Count == 0) return;

    var heading = SiteToolNavigation.CategoryHeading(category);
}
<section class="related-tools container py-4" aria-label="@heading">
    <h3>@heading</h3>
    <ul>
        @foreach (var tool in tools)
        {
            <li><a href="@tool.Url">@tool.Name</a></li>
        }
    </ul>
    @if (category is SiteToolCategories.Medical or SiteToolCategories.Calculators)
    {
        <p class="small text-muted mb-0 mt-2">For document workflows, see our <a href="/pdf/compress">PDF compressor</a> and <a href="/Invoice/Create">invoice generator</a>.</p>
    }
    else if (category is SiteToolCategories.Developer or SiteToolCategories.Network or SiteToolCategories.Utilities)
    {
        <p class="small text-muted mb-0 mt-2">Document workflows: <a href="@TopicalAuthority.PdfToolsHubPath">PDF tools hub</a>, <a href="/pdf/merge">Merge PDF</a>, <a href="/pdf/pdftodoc">PDF to Word</a>.</p>
    }
    else if (category is SiteToolCategories.Business)
    {
        <p class="small text-muted mb-0 mt-2">After creating documents: <a href="/pdf/compress">Compress PDF</a>, <a href="/pdf/merge">Merge PDF</a>, <a href="@TopicalAuthority.PdfToolsHubPath">PDF tools hub</a>.</p>
    }
</section>
