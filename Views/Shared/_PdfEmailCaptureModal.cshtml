@using ratpdf.Constants
@using ratpdf.Services.PdfTools
<div class="modal fade" id="pdfEmailCaptureModal" tabindex="-1" aria-labelledby="pdfEmailCaptureModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="pdfEmailCaptureModalLabel">
                    <i class="bi bi-envelope-heart text-primary me-2"></i>Stay in the loop
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p class="text-muted mb-3">
                    You've used @PdfToolsAccessService.EmailCaptureAfterUses free tools today. Leave your email for PDF tips, new tools, and occasional Pro offers — or skip and use your remaining free try.
                </p>
                <form id="pdfEmailCaptureForm" class="mb-3">
                    <label class="form-label small fw-semibold" for="pdfLeadEmail">Email address</label>
                    <input type="email" class="form-control form-control-lg" id="pdfLeadEmail" name="email" placeholder="you@example.com" required autocomplete="email" />
                    <div id="pdfEmailCaptureError" class="text-danger small mt-2 d-none"></div>
                </form>
                <p class="small text-muted mb-0">
                    No spam. Unsubscribe anytime. <a href="/home/privacy">Privacy policy</a>
                    · Prefer an account? <a href="/account/register">Register free</a>
                </p>
            </div>
            <div class="modal-footer border-0 flex-column gap-2 pt-0">
                <button type="button" class="btn btn-primary btn-lg w-100 fw-semibold" id="pdfEmailCaptureSubmit">Send me PDF tips</button>
                <button type="button" class="btn btn-outline-secondary w-100" id="pdfEmailCaptureSkip" data-bs-dismiss="modal">Skip — keep using free tools</button>
            </div>
        </div>
    </div>
</div>
