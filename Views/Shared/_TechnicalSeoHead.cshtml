@using ratpdf.Constants
@{
    var toolId = ViewData["PdfToolId"] as string;
    var canonical = ViewData["CanonicalUrl"] as string;
    if (string.IsNullOrEmpty(canonical) && !string.IsNullOrEmpty(toolId))
    {
        var catalog = PdfToolSchemaCatalog.Get(toolId);
        if (catalog != null)
            canonical = PdfToolSeo.Canonical(catalog.ToolPath);
    }
    canonical ??= PdfToolSeo.Canonical(Context.Request.Path.Value ?? "/");

    var title = ViewData["Title"] as string ?? "Free PDF Tools Online";
    var description = ViewData["Description"] as string ?? "Free online PDF tools — merge, split, compress, convert PDF to Word, Excel, and more. Adobe-quality conversion with RatPDF.";
    var ogImage = ViewData["OgImage"] as string
        ?? (!string.IsNullOrEmpty(toolId) ? PdfToolSeo.OgImageForToolId(toolId) : null)
        ?? PdfToolSeo.DefaultOgImage;
    var robots = ViewData["Robots"] as string ?? "index, follow, max-image-preview:large, max-snippet:-1";
    var pageKeywords = ViewData["Keywords"] as string;
    var ogLocale = ViewData["OgLocale"] as string;
    var geoRegion = ViewData["GeoRegion"] as string;
    var geoCountry = ViewData["GeoCountry"] as string;
}
<link rel="canonical" href="@canonical" />
<meta name="robots" content="@robots" />
@if (!string.IsNullOrEmpty(pageKeywords))
{
<meta name="keywords" content="@pageKeywords" />
}
@if (!string.IsNullOrEmpty(geoRegion))
{
<meta name="geo.region" content="@geoRegion" />
}
@if (!string.IsNullOrEmpty(geoCountry))
{
<meta name="geo.country" content="@geoCountry" />
}
<meta property="og:site_name" content="@PdfToolSeo.SiteName" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:url" content="@canonical" />
<meta property="og:type" content="website" />
<meta property="og:image" content="@ogImage" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
@if (!string.IsNullOrEmpty(ogLocale))
{
<meta property="og:locale" content="@ogLocale" />
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@title" />
<meta name="twitter:description" content="@description" />
<meta name="twitter:image" content="@ogImage" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site guide" />
<link rel="author" href="@PdfToolSeo.Canonical(SiteEntity.AboutPath)" />
<meta name="publisher" content="@SiteEntity.Name" />
