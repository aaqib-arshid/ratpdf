@using ratpdf.Constants
@using ratpdf.Content
@* Compact trust row on PDF tool pages *@
<div class="rp-social-proof small text-muted mb-2" aria-label="Trust signals">
    <span class="me-2"><i class="bi bi-people-fill text-primary"></i> @PdfToolSeo.ToolCountLabel PDF tools</span>
    <span class="me-2"><i class="bi bi-journal-check text-primary"></i> @ContentLibrary.Guides.Count() guides</span>
    <span class="me-2"><i class="bi bi-person-check text-success"></i> No signup required</span>
    <span><i class="bi bi-shield-check text-success"></i> <a href="@SiteEntity.TrustHubPath" class="text-decoration-none">Trust center</a></span>
</div>
