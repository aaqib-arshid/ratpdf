@if (ViewData["HideLargeFileNotice"] as bool? != true)
{
    @await Html.PartialAsync("_PdfLargeFileNotice")
}
@* Unified progress bar for all PDF tools (sync + async jobs). *@
<div id="progressArea" class="mb-3" style="display:none;">
    <div class="d-flex justify-content-between small text-muted mb-1">
        <span id="progressMsg">Processing…</span>
        <span id="progressPct">0%</span>
    </div>
    <div class="progress" style="height:10px;border-radius:6px;">
        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated"
             role="progressbar" style="width:0%;background:linear-gradient(90deg,#4a90e2,#667eea);"></div>
    </div>
</div>
