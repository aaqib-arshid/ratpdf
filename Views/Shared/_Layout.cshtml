<!DOCTYPE html>
<html lang="en">
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": "Rat PDF",
          "url": "https://ratpdf.com"
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "Rat PDF",
          "url": "https://ratpdf.com",
          "logo": "https://ratpdf.com/images/ratpdf-logo.png"
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Free online PDF tools to convert, merge, split, compress, and edit PDF files easily. Fast, secure and easy to use." />
    <meta name="keywords" content="PDF converter, merge PDF, split PDF, compress PDF, img to pdf, pdf to img, PDF to Word, Word to PDF,doc to pdf, pdf to doc, docx to pdf, pdf to docx, pdf to xls, xls to pdf, excel to pdf, pdf to excel, edit pdf, free PDF tools" />
    <meta name="author" content="Rat PDF" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"] - Rat PDF</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ratpdf.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="icon" type="image/png" href="~/images/ratpdf-logo.png" />
    <style>
        body {
            background: #f5f6fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: #4a90e2; /* RatPDF primary color */
        }

            .navbar .nav-link, .navbar-brand {
                color: #fff !important;
            }

                .navbar .nav-link:hover {
                    color: #ffdd59 !important;
                }

        .card {
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        footer {
            background-color: #4a90e2;
            color: #fff;
        }

            footer a {
                color: #ffdd59;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="40" class="me-2" />
                    Rat PDF
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                        <!-- Converter Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="converterDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Converter
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="converterDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="ConvertImages">Image To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="DocToPdf">Doc To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToDoc">PDF To Doc</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToExcel">PDF To Excel</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="ExcelToPdf">Excel To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="TextToPdf">Text To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToText">PDF To Text</a></li>
                            </ul>
                        </li>

                        <!-- Other tools outside dropdown -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Merge">Merge PDFs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Split">Split PDFs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Compress">Compress PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Watermark">Add Watermark</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Password">Protect PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="SignText">Sign PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="RotateOrRemove">Rotate/Remove PDF</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container my-5">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-auto">
        <div class="container text-center">
            &copy; 2026 Rat PDF |
            <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a> |
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>