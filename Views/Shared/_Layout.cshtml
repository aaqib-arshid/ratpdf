    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const maxSize = 50 * 1024 * 1024; // 50 MB

        document.querySelectorAll('input[type="file"]').forEach(input => {
            let errorMsg = document.createElement('div');
            errorMsg.style.color = 'red';
            errorMsg.style.fontSize = '0.9em';
            errorMsg.style.marginTop = '5px';
            errorMsg.style.display = 'none';
            input.parentNode.insertBefore(errorMsg, input.nextSibling);

            input.addEventListener('change', function() {
                let hasError = false;
                errorMsg.style.display = 'none';
                for (let file of this.files) {
                    if (file.size > maxSize) {
                        hasError = true;
                        errorMsg.textContent = `File "${file.name}" is too large. Max 50 MB allowed.`;
                        this.value = '';
                        break;
                    }
                }
                if (hasError) {
                    errorMsg.style.display = 'block';
                }
            });
        });
    });
        function showLoader(message = 'Processing...') {
        $('#loaderMessage').text(message);
        $('#globalLoader').css('display', 'flex');
    }

    function hideLoader() {
        $('#globalLoader').hide();
    }
        function submitWithLoader(formId, message = 'Processing...') {
        showLoader(message);

        // Clearing old cookie
        document.cookie = 'downloadReady=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';

        const poll = setInterval(function () {
            if (document.cookie.includes('downloadReady=1')) {
                document.cookie = 'downloadReady=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
                clearInterval(poll);
                hideLoader();
            }
        }, 500);

        // Safety fallback
        setTimeout(function () {
            clearInterval(poll);
            hideLoader();
        }, 30000);

        $('#' + formId).off('submit').submit();
    }
</script>