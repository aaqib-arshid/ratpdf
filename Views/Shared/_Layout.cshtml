    <link rel="stylesheet" href="~/ratpdf.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />

    <style>
        body {
            background: #f5f6fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: #4a90e2; /* RatPDF primary color */
        }

            .navbar .nav-link, .navbar-brand {
                color: #fff !important;
            }

                .navbar .nav-link:hover {
                    color: #ffdd59 !important;
                }

        .dropdown-menu {
            max-height: 70vh;
            overflow-y: auto;
            min-width: 240px;
        }

        /* Prevent right-side overflow */
        .navbar-nav .dropdown-menu {
            right: auto !important;
            left: 0 !important;
        }

        /* Optional: better alignment on large menus */
        @@media (min-width: 992px) {
            .dropdown-menu {
                transform: translateX(-10px);
            }
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        footer {
            background-color: #4a90e2;
            color: #fff;
        }

            footer a {
                color: #ffdd59;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }

        /* Related Tools Section */
        .related-tools {
            margin: 40px auto 20px;
            padding: 24px;
            max-width: 1100px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
        }

            .related-tools h3 {
                margin-bottom: 16px;
                font-size: 1.25rem;
                font-weight: 700;
                color: #111827;
            }

            .related-tools ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                gap: 14px;
            }

                .related-tools ul li a {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    min-height: 60px;
                    padding: 12px;
                    background: #ffffff;
                    border: 1px solid #e5e7eb;
                    border-radius: 10px;
                    text-decoration: none;
                    font-weight: 600;
                    color: #1f2937;
                    transition: all 0.2s ease;
                }

                    .related-tools ul li a:hover {
                        background: #eef2ff;
                        border-color: #2563eb;
                        color: #2563eb;
                        transform: translateY(-2px);
                    }

                    .related-tools ul li a:focus {
                        outline: none;
                        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
                    }
        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
</head>
<body>
