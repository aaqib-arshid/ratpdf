<!DOCTYPE html>
<html lang="en">
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": "Rat PDF",
          "url": "https://ratpdf.com",
                 "potentialAction": {
          "@@type": "SearchAction",
          "target": "https://ratpdf.com/PDF?search={search_term_string}",
          "query-input": "required name=search_term_string"
        }
        }
    </script>

    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "Rat PDF",
          "url": "https://ratpdf.com",
          "logo": "https://ratpdf.com/images/ratpdf-logo.png"
        }
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="PDF converter, merge PDF, split PDF, compress PDF, img to pdf, pdf to img, PDF to Word, Word to PDF,doc to pdf, pdf to doc, docx to pdf, pdf to docx, pdf to xls, xls to pdf, excel to pdf, pdf to excel, edit pdf, free PDF tools" />
    <meta name="author" content="Rat PDF" />
    <meta name="description" content="@ViewData["Description"]" />
    <title>@ViewData["Title"] - Rat PDF</title>

    @* Fav Icons *@
    <link href="/favicon-48x48.png" rel="icon">
    <link href="/favicon-180x180.png" rel="apple-touch-icon">
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ratpdf.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">


    <style>
        body {
            background: #f5f6fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .navbar {
            background-color: #4a90e2; /* RatPDF primary color */
        }

            .navbar .nav-link, .navbar-brand {
                color: #fff !important;
            }

                .navbar .nav-link:hover {
                    color: #ffdd59 !important;
                }

        .card {
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        footer {
            background-color: #4a90e2;
            color: #fff;
        }

            footer a {
                color: #ffdd59;
                text-decoration: none;
            }

                footer a:hover {
                    text-decoration: underline;
                }

        /* Related Tools Section */
        .related-tools {
            margin: 40px auto 20px;
            padding: 24px;
            max-width: 1100px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
        }

            .related-tools h3 {
                margin-bottom: 16px;
                font-size: 1.25rem;
                font-weight: 700;
                color: #111827;
            }

            .related-tools ul {
                list-style: none;
                padding: 0;
                margin: 0;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
                gap: 14px;
            }

                .related-tools ul li a {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    min-height: 60px;
                    padding: 12px;
                    background: #ffffff;
                    border: 1px solid #e5e7eb;
                    border-radius: 10px;
                    text-decoration: none;
                    font-weight: 600;
                    color: #1f2937;
                    transition: all 0.2s ease;
                }

                    .related-tools ul li a:hover {
                        background: #eef2ff;
                        border-color: #2563eb;
                        color: #2563eb;
                        transform: translateY(-2px);
                    }

                    .related-tools ul li a:focus {
                        outline: none;
                        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.25);
                    }
    </style>
</head>
<body>

    <!-- Navbar -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ratpdf-logo.png" alt="Rat PDF Logo" height="40" class="me-2" />
                    Rat PDF
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                        <!-- Converter Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="converterDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Converter
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="converterDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="ConvertImages">Image To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="DocToPdf">Doc To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToDoc">PDF To Doc</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToExcel">PDF To Excel</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="ExcelToPdf">Excel To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="TextToPdf">Text To PDF</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="PdfToText">PDF To Text</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="ImgToBase64">IMG To BASE64</a></li>
                            </ul>
                        </li>
                        <!-- Formatter Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="converterDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Formatters
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="converterDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="HtmlFormatter">HTML Formatter</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="JsonFormatter">JSON Formatter</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PDF" asp-action="JwtDecoder">Decode JWT</a></li>
                            </ul>
                        </li>
                        <!-- Other tools outside dropdown -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="ImageCompressor">Compress Image Size</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Merge">Merge PDFs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Split">Split PDFs</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Compress">Compress PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Watermark">Add Watermark</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="Password">Protect PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="SignText">Sign PDF</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="PDF" asp-action="RotateOrRemove">Rotate/Remove PDF</a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <div class="container my-5">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-auto">
        <div class="container text-center">
            &copy; 2026 Rat PDF |
            <a asp-controller="Home" asp-action="Terms">Terms & Conditions</a> |
            <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a> |
            <a asp-controller="Home" asp-action="Contact">Contact Us</a> |
            <a asp-controller="Home" asp-action="About">About</a> |
            <a asp-controller="Home" asp-action="Disclaimer">Disclaimer</a>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const maxSize = 50 * 1024 * 1024; // 50 MB

        document.querySelectorAll('input[type="file"]').forEach(input => {
            let errorMsg = document.createElement('div');
            errorMsg.style.color = 'red';
            errorMsg.style.fontSize = '0.9em';
            errorMsg.style.marginTop = '5px';
            errorMsg.style.display = 'none';
            input.parentNode.insertBefore(errorMsg, input.nextSibling);

            input.addEventListener('change', function() {
                let hasError = false;
                errorMsg.style.display = 'none';
                for (let file of this.files) {
                    if (file.size > maxSize) {
                        hasError = true;
                        errorMsg.textContent = `File "${file.name}" is too large. Max 50 MB allowed.`;
                        this.value = ''; 
                        break;
                    }
                }
                if (hasError) {
                    errorMsg.style.display = 'block';
                }
            });
        });
    });
</script>