@using ratpdf.Constants
<div class="modal fade" id="pdfPaywallModal" tabindex="-1" aria-labelledby="pdfPaywallModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="pdfPaywallModalLabel">
                    <i class="bi bi-stars text-warning me-2"></i>Unlimited PDF tools — Pro
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p id="pdfPaywallMessage" class="text-muted mb-3">
                    You've used your @PdfToolLimits.FreeUsesPerDay free uses today. Upgrade to Pro for unlimited access — or <a href="/account/register">register free</a> and come back tomorrow for @PdfToolLimits.FreeUsesPerDay more free uses.
                </p>
                <ul class="list-unstyled small text-muted mb-3">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Unlimited merge, compress, convert, OCR &amp; more</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>4 GB</strong> per file (vs 200 MB free)</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>High-fidelity PDF↔Word &amp; Excel</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>@SubscriptionPricing.FormatProDisplay()</strong> · @SubscriptionPricing.FormatProTagline()</li>
                </ul>
                <div class="d-flex flex-wrap gap-2 small text-muted mb-4 pb-2 border-bottom">
                    <span><i class="bi bi-shield-lock me-1"></i>TLS encrypted</span>
                    <span><i class="bi bi-trash me-1"></i>Auto-delete</span>
                    <span><a href="@SiteEntity.TrustHubPath">Trust center</a></span>
                </div>
                <div class="d-grid gap-2">
                    <a href="/Subscription/Plans?source=paywall" class="btn btn-primary btn-lg fw-semibold">View Plans &amp; Subscribe</a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Continue with free tier tomorrow</button>
                </div>
            </div>
        </div>
    </div>
</div>
