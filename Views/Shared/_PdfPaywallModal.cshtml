<div class="modal fade" id="pdfPaywallModal" tabindex="-1" aria-labelledby="pdfPaywallModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="pdfPaywallModalLabel">
                    <i class="bi bi-stars text-warning me-2"></i>Upgrade for Unlimited Access
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <p id="pdfPaywallMessage" class="text-muted mb-3">
                    You've used your 3 free uses today. Upgrade to Pro for unlimited PDF and image tools.
                </p>
                <ul class="list-unstyled small text-muted mb-4">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Unlimited Merge, Split, Compress, PDF to Word, Edit PDF, image tools &amp; more</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>4 GB</strong> per file (vs 200 MB free), batch up to 3</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>High-fidelity PDF↔Word &amp; PDF↔Excel conversion</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>High-fidelity layout preservation</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Pro — @ratpdf.Constants.SubscriptionPricing.FormatProDisplay()</strong> · @ratpdf.Constants.SubscriptionPricing.FormatProTagline()</li>
                </ul>
                <div class="d-grid gap-2">
                    <a href="/Subscription/Plans" class="btn btn-primary btn-lg">View Plans &amp; Subscribe</a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Maybe Later</button>
                </div>
            </div>
        </div>
    </div>
</div>
