@model ratpdf.Constants.InvoiceProfessionCompareCatalog.ProfessionComparePage
@using ratpdf.Constants
@using ratpdf.Helpers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonical = ViewData["CanonicalUrl"] as string ?? PdfToolSeo.Canonical($"{CompetitiveSeoCatalog.CompareHubPath}/{Model.Slug}");
}

@section Head {
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildFaqLdJson(Model.Faqs.Select(f => new ratpdf.Models.CompressPdfSeo.FaqItem { Question = f.Question, Answer = f.Answer }).ToList()))
    </script>
    <script type="application/ld+json">
    @Html.Raw(SchemaHelper.BuildBreadcrumbLdJson([
        new ratpdf.Models.CompressPdfSeo.BreadcrumbItem { Name = "Home", Url = PdfToolSeo.SiteUrl },
        new ratpdf.Models.CompressPdfSeo.BreadcrumbItem { Name = "Compare", Url = PdfToolSeo.Canonical(CompetitiveSeoCatalog.CompareHubPath) },
        new ratpdf.Models.CompressPdfSeo.BreadcrumbItem { Name = Model.Profession, Url = canonical },
    ]))
    </script>
}

<article class="container py-5">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="@CompetitiveSeoCatalog.CompareHubPath">Compare</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Profession</li>
        </ol>
    </nav>

    <h1 class="fw-bold mb-3">@Model.Title.Replace(" | RatPDF", "")</h1>
    <p class="lead text-muted">@Model.HeroSummary</p>

    @await Html.PartialAsync("_AiCitationBlock")

    <div class="mb-4">
        <a href="/invoice/create" class="btn btn-primary btn-sm rounded-pill me-2">Create invoice PDF free</a>
        <a href="/Subscription/Plans" class="btn btn-outline-secondary btn-sm rounded-pill">Pro plans</a>
    </div>

    <h2 class="h4 fw-semibold mt-4">RatPDF vs typical @Model.Profession.ToLowerInvariant() tools</h2>
    <div class="table-responsive mb-4">
        <table class="table table-bordered">
            <thead><tr><th>Feature</th><th>RatPDF</th><th>Typical alternative</th></tr></thead>
            <tbody>
                @foreach (var row in Model.ComparisonRows)
                {
                    <tr><td>@row.Feature</td><td>@row.RatPdf</td><td>@row.TypicalAlternative</td></tr>
                }
            </tbody>
        </table>
    </div>

    <h2 class="h5 fw-semibold">FAQ</h2>
    @foreach (var faq in Model.Faqs)
    {
        <h3 class="h6 fw-semibold mt-3">@faq.Question</h3>
        <p class="text-muted small">@faq.Answer</p>
    }

    <h2 class="h5 fw-semibold mt-4">Other profession comparisons</h2>
    <ul class="small mb-0">
        @foreach (var other in InvoiceProfessionCompareCatalog.Pages.Where(p => p.Slug != Model.Slug))
        {
            <li><a href="@CompetitiveSeoCatalog.CompareHubPath/@other.Slug">Best invoice generators for @other.Profession.ToLowerInvariant()</a></li>
        }
    </ul>
</article>
