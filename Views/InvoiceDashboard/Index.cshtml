@using ratpdf.Models.Invoice
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <!-- HERO HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Dashboard</h2>
            <p class="text-muted mb-0">Manage your invoices, templates and billing activity</p>
        </div>

        <button class="btn btn-primary px-4 shadow-sm"
                onclick="location.href='/Invoice/Create'">
            + Create Invoice
        </button>
    </div>

    <!-- STATS -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                <div class="text-muted small">Total Invoices</div>
                <div class="display-6 fw-bold">@Model.TotalInvoices</div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                <div class="text-muted small">Plan</div>
                <div class="h4 fw-semibold mb-0">
                    @ratpdf.Constants.Plan.GetPlanName(Model.PlanName)
                </div>
            </div>
        </div>

    </div>

    <!-- RECENT INVOICES -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-semibold">Recent Invoices</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.Invoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Invoice #</th>
                                <th>Customer</th>
                                <th>Currency</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var inv in Model.Invoices)
                            {
                                <tr>
                                    <td class="fw-semibold">@inv.InvoiceNumber</td>
                                    <td>@inv.CustomerName</td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @inv.Currency
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@inv.Total.ToString("N2")</td>
                                    <td>@inv.IssueDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                        <!-- Download Button -->
                                        <a asp-controller="Invoice"
                                               asp-action="Download"
                                               asp-route-id="@inv.Id"
                                               class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-download"></i>
                                            </a> 
                                            <!-- Delete -->
                                            <a asp-controller="Invoice"
                                                   asp-action="Delete"
                                                   asp-route-id="@inv.Id"
                                                   class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                    @if (Model.TotalPages > 1)
                    {
                        <div class="card-footer bg-white border-0 py-3">
                            <nav>
                                <ul class="pagination justify-content-center mb-0">

                                    <!-- Previous -->
                                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link"
                                               href="/InvoiceDashboard/Index?page=@(Model.CurrentPage - 1)">
                                            Previous
                                        </a>
                                    </li>

                                    <!-- Page Numbers -->
                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link"
                                                   href="/InvoiceDashboard/Index?page=@i">
                                                @i
                                            </a>
                                        </li>
                                    }

                                    <!-- Next -->
                                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link"
                                               href="/InvoiceDashboard/Index?page=@(Model.CurrentPage + 1)">
                                            Next
                                        </a>
                                    </li>

                                </ul>
                            </nav>
                        </div>
                    }
   
                </div>
            }
            else
            {
                <div class="p-4 text-center">
                    <p class="text-muted mb-2">No invoices yet</p>
                    <a class="btn btn-outline-primary"
                           asp-controller="Invoice"
                           asp-action="Create">
                        Create your first invoice
                    </a>
                </div>
            }

        </div>
    </div>

    <!-- TEMPLATES -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-semibold">Saved Templates</h5>
        </div>

        <div class="card-body">

            @if (Model.Templates.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var t in Model.Templates)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@t.Name</strong>
                                <small class="text-muted ms-2">@t.CreatedAt.ToString("dd MMM yyyy")</small>
                            </div>
                            <div>
                                <a asp-controller="Templates" asp-action="Load" asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-primary">Load</a>
                                <form asp-controller="Templates" asp-action="Delete" asp-route-id="@t.Id"
                                      method="post" class="d-inline ms-1"
                                      onsubmit="return confirm('Delete this template?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-3">
                    <p class="text-muted mb-2">No templates saved</p>
                    <a asp-controller="Invoice"
                           asp-action="Create"
                           class="btn btn-outline-secondary">
                        Create Template (Pro)
                    </a>
                </div>
            }

        </div>
    </div>

</div>