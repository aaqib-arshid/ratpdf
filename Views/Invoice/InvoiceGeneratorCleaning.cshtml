    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator for Cleaning Business | RatPDF" />
    <meta name="twitter:description" content="Generate cleaning invoices online with service details, hourly rates, and PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Cleaning Business Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-cleaning",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for cleaning businesses, housekeeping services, and janitorial companies.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What should a cleaning invoice include?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A cleaning invoice should include service date and address, description of cleaning services (rooms, windows, carpet, etc.), hourly rate or fixed fee, square footage if applicable, supplies cost, taxes, and payment terms."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate cleaning invoices for free?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows cleaning businesses to create and download professional invoices online for free with no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support recurring cleanings?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can create invoices for one-time, weekly, bi-weekly, or monthly cleaning services easily."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Cleaning Invoice Generator",
        "item": "https://ratpdf.com/invoice/invoice-generator-cleaning"
        }
        ]
        }
    </script>
}

