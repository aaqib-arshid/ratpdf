    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Invoice Generator for Cleaning Business | Create Cleaning Invoices Online</title>
    <meta name="title" content="Free Invoice Generator for Cleaning Business | Create Cleaning Invoices Online" />
    <meta name="description" content="Generate professional cleaning invoices online for free. Create housekeeping, janitorial, and commercial cleaning invoices with service details, hourly rates, and PDF download." />
    <meta name="keywords" content="invoice generator for cleaning business, cleaning invoice maker, housekeeping invoice, janitorial invoice, commercial cleaning invoice, maid service invoice, cleaning bill template, residential cleaning invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator for Cleaning Business | RatPDF" />
    <meta property="og:description" content="Create professional cleaning invoices online for free. Add services, hourly rates, and PDF download." />
