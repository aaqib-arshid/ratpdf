@{
    ViewData["Title"] = "Free Invoice Generator Canada | Create GST/HST Invoices Online for CA";
    ViewData["Description"] = "Generate professional invoices online for Canadian businesses. Free invoice maker with GST/HST, QST, PST support, business number, and PDF download. Perfect for sole traders, small business.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonicalUrl = "https://ratpdf.com/invoice/invoice-generator-canada";
}

@section Head {
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Invoice Generator Canada | Create GST/HST Invoices Online for CA</title>
    <meta name="title" content="Free Invoice Generator Canada | Create GST/HST Invoices Online for CA" />
    <meta name="description" content="Generate professional invoices online for Canadian businesses. Free invoice maker with GST/HST, QST, PST support, business number, and PDF download. Perfect for sole traders, small business." />
    <meta name="keywords" content="invoice generator Canada, Canadian invoice maker, GST HST invoice, business number invoice, tax invoice Canada, small business invoice, free invoice Canada, sole trader invoice, CRA compliant invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="geo.region" content="CA" />
    <meta name="geo.country" content="Canada" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator Canada | RatPDF" />
    <meta property="og:description" content="Create GST/HST invoices and business invoices online instantly in Canada. Free PDF download." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_CA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator Canada | RatPDF" />
    <meta name="twitter:description" content="Generate Canadian invoices with Business Number and GST/HST – free PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Canadian Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-canada",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for Canadian businesses – supports GST/HST, Business Number, and CRA-friendly tax invoices.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "CAD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What is an invoice generator in Canada?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "An invoice generator in Canada helps businesses create GST/HST-compliant invoices with Business Number, tax calculations, and all fields required for CRA reporting."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate GST/HST invoices online for free in Canada?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download tax invoices online for free – no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support Business Number and GST/HST?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add your Business Number (BN) and the tool supports GST, HST, PST, and QST tax rates."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Invoice Generator Canada",
        "item": "https://ratpdf.com/invoice/invoice-generator-canada"
        }
        ]
        }
    </script>
}

