@{
    ViewData["Title"] = "Free Invoice Generator for Tutors | Create Tutoring Invoices Online";
    ViewData["Description"] = "Generate professional invoices for tutors online for free. Create tutoring session, hourly rate, package, and subject invoices with PDF download.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonicalUrl = "https://ratpdf.com/invoice/invoice-generator-tutors";
}

@section Head {
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Invoice Generator for Tutors | Create Tutoring Invoices Online</title>
    <meta name="title" content="Free Invoice Generator for Tutors | Create Tutoring Invoices Online" />
    <meta name="description" content="Generate professional invoices for tutors online for free. Create tutoring session, hourly rate, package, and subject invoices with PDF download." />
    <meta name="keywords" content="invoice generator for tutors, tutoring invoice maker, teacher invoice, tutor billing, private tutor invoice, online tutoring invoice, hourly tutoring invoice, tutoring package invoice, lesson invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator for Tutors | RatPDF" />
    <meta property="og:description" content="Create professional tutoring invoices online for free. Add session details, hourly rates, packages, and PDF download." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator for Tutors | RatPDF" />
    <meta name="twitter:description" content="Generate tutoring invoices online with hourly rates, packages, and PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Tutor Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-tutors",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for private tutors, online teachers, and tutoring centers.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "532"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What should a tutoring invoice include?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A tutoring invoice should include tutor name, subject, student name, session date, duration, hourly rate, number of sessions, total hours, any materials fee, tax, and payment terms."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate tutoring invoices for free?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows tutors to create and download professional invoices online for free with no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support hourly rates and session packages?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can bill by the hour, per session, or for a package of sessions (e.g., 5-session math package)."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Tutor Invoice Generator",
        "item": "https://ratpdf.com/invoice/invoice-generator-tutors"
        }
        ]
        }
    </script>
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-success mb-3 px-3 py-2">100% Free for Tutors</span>
            <h1 class="display-4 fw-bold mb-3">
                Invoice Generator for Tutors – Professional Tutoring Invoices Fast
