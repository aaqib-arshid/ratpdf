                        <p class="mb-0 small text-muted">Invoices Generated</p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded p-3 text-center h-100">
                        <h3 class="fw-bold text-primary mb-1">Free</h3>
                        <p class="mb-0 small text-muted">No Signup Needed</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 text-center mt-5 mt-lg-0">
            <img src="/images/hero-invoice.svg"
                 alt="Invoice Generator for Tutors"
                 class="img-fluid rounded shadow-lg"
                 loading="lazy" />
        </div>
    </div>
</div>

<section class="py-5 bg-light" id="features">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Features Designed for Tutors & Teachers</h2>
            <p class="text-muted">
                Everything you need to bill students and get paid on time.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold">Hourly or Per Session</h3>
                        <p class="text-muted mb-0">
                            Bill by the hour, per session, or for a package of sessions – whatever suits your tutoring style.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold">Subject & Grade Level</h3>
                        <p class="text-muted mb-0">
                            Add subject (Math, English, Science, etc.), grade level, and student name to each line item.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
