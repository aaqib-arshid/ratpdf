        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download GST invoices online for free – no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support ABN and GST?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add your ABN and the tool automatically calculates 10% GST on taxable items."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
