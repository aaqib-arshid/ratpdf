        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What is an invoice generator in Australia?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "An invoice generator in Australia helps businesses create GST-compliant invoices with ABN, 10% GST calculation, and all fields required for tax reporting."
        }
        },
        {
        "@@type": "Question",
