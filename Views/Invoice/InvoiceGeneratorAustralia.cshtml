    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Australian Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-australia",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for Australian businesses – supports ABN, 10% GST, and ATO-friendly tax invoices.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "AUD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
