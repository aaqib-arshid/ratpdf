        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Invoice Generator Australia",
        "item": "https://ratpdf.com/invoice/invoice-generator-australia"
        }
        ]
        }
    </script>
}

