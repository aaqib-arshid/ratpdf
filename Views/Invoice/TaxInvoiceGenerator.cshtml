    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Tax Invoice Generator | Create Professional Tax Invoices Online</title>
    <meta name="title" content="Free Tax Invoice Generator | Create Professional Tax Invoices Online" />
    <meta name="description" content="Generate professional tax invoices online for free. Create tax invoices with GST/VAT, tax calculations, invoice number, customer details, HSN/SAC codes, and downloadable PDF invoices instantly." />
    <meta name="keywords" content="tax invoice generator, tax invoice maker, free tax invoice, GST tax invoice, VAT tax invoice, sales tax invoice, tax invoice template, business tax invoice, invoice with tax, tax receipt generator" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Tax Invoice Generator | RatPDF" />
    <meta property="og:description" content="Create tax-compliant invoices online for free. Download professional tax invoices instantly in PDF format." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Tax Invoice Generator | RatPDF" />
    <meta name="twitter:description" content="Generate tax invoices online with tax calculations, GST/VAT support, and PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Tax Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/tax-invoice-generator",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online tax invoice generator for businesses, freelancers, and professionals needing tax-compliant invoices.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What is a tax invoice?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A tax invoice is a document issued by a registered business that shows the tax amount charged on goods or services. It includes seller and buyer details, tax registration number, itemized tax rates, and total amount including tax."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate tax invoices for free?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download tax invoices online for free without any signup or software installation."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the tax invoice generator support GST and VAT?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, the generator supports multiple tax types including GST (CGST/SGST/IGST) and VAT, with customizable tax rates for different items."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Tax Invoice Generator",
        "item": "https://ratpdf.com/invoice/tax-invoice-generator"
        }
        ]
        }
    </script>
}

