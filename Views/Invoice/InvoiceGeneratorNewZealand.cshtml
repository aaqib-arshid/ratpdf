    <title>Free Invoice Generator New Zealand | Create GST Invoices Online for NZ</title>
    <meta name="title" content="Free Invoice Generator New Zealand | Create GST Invoices Online for NZ" />
    <meta name="description" content="Generate professional invoices online for New Zealand businesses. Free invoice maker with IRD number, 15% GST support, tax invoices, and PDF download. Perfect for sole traders, SMEs." />
    <meta name="keywords" content="invoice generator New Zealand, GST invoice NZ, IRD number invoice, New Zealand invoice template, tax invoice NZ, small business invoice, sole trader invoice, IRD compliant invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="geo.region" content="NZ" />
    <meta name="geo.country" content="New Zealand" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator New Zealand | RatPDF" />
    <meta property="og:description" content="Create GST invoices and business invoices online instantly in New Zealand. Free PDF download." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_NZ" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator New Zealand | RatPDF" />
    <meta name="twitter:description" content="Generate NZ invoices with IRD number and 15% GST – free PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "New Zealand Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-new-zealand",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for New Zealand businesses – supports IRD number, 15% GST, and IRD-friendly tax invoices.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "NZD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What is an invoice generator in New Zealand?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "An invoice generator in New Zealand helps businesses create GST-compliant invoices with IRD number, 15% GST calculation, and all fields required for tax reporting."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate GST invoices online for free in NZ?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download tax invoices online for free – no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support IRD number and GST?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add your IRD number and the tool automatically calculates 15% GST on taxable items."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Invoice Generator New Zealand",
        "item": "https://ratpdf.com/invoice/invoice-generator-new-zealand"
        }
        ]
        }
    </script>
}

