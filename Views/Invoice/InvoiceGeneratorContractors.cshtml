@{
    ViewData["Title"] = "Free Invoice Generator for Contractors | Create Contractor Invoices Online";
    ViewData["Description"] = "Generate professional invoices for contractors online for free. Create construction, independent contractor, and trade invoices with labor, materials, equipment, and downloadable PDF.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonicalUrl = "https://ratpdf.com/invoice/invoice-generator-contractors";
}

@section Head {
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Invoice Generator for Contractors | Create Contractor Invoices Online</title>
    <meta name="title" content="Free Invoice Generator for Contractors | Create Contractor Invoices Online" />
    <meta name="description" content="Generate professional invoices for contractors online for free. Create construction, independent contractor, and trade invoices with labor, materials, equipment, and downloadable PDF." />
    <meta name="keywords" content="invoice generator for contractors, contractor invoice maker, free contractor invoice, construction invoice template, independent contractor invoice, 1099 invoice, trade invoice, subcontractor invoice, handyman invoice, contractor billing software" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator for Contractors | RatPDF" />
    <meta property="og:description" content="Create professional contractor invoices online for free. Add labor, materials, equipment, and download PDF." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator for Contractors | RatPDF" />
    <meta name="twitter:description" content="Generate contractor invoices online with labor, materials, tax, and PDF download support." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Contractor Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-contractors",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for independent contractors, construction businesses, subcontractors, and trade professionals.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What should a contractor invoice include?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A contractor invoice should include your business name and contact info, client details, invoice number, project description, itemized labor hours or fixed price, materials, equipment, taxes, deposit paid, and total due."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate contractor invoices for free?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download professional contractor invoices online for free with no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support labor and material line items?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add separate line items for labor (hourly or fixed), materials, equipment rental, travel, and other expenses."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Contractor Invoice Generator",
        "item": "https://ratpdf.com/invoice/invoice-generator-contractors"
        }
        ]
        }
    </script>
}

<div class="container py-5">
