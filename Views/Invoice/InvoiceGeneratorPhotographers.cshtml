@{
    ViewData["Title"] = "Free Invoice Generator for Photographers | Create Professional Photography Invoices";
    ViewData["Description"] = "Generate professional invoices for photographers online for free. Create photography invoices with client details, shoot information, package pricing, deposits, and downloadable PDF invoices instantly.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonicalUrl = "https://ratpdf.com/invoice/invoice-generator-photographers";
}

@section Head {
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Free Invoice Generator for Photographers | Create Professional Photography Invoices</title>
    <meta name="title" content="Free Invoice Generator for Photographers | Create Professional Photography Invoices" />
    <meta name="description" content="Generate professional invoices for photographers online for free. Create photography invoices with client details, shoot information, package pricing, deposits, and downloadable PDF invoices instantly." />
    <meta name="keywords" content="invoice generator for photographers, photography invoice maker, free photography invoice, photographer invoice template, wedding photography invoice, portrait invoice, event photography billing, freelance photographer invoice, photography payment receipt, photo shoot invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Free Invoice Generator for Photographers | RatPDF" />
    <meta property="og:description" content="Create professional photography invoices online for free. Download photo shoot invoices instantly in PDF format." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Free Invoice Generator for Photographers | RatPDF" />
    <meta name="twitter:description" content="Generate photography invoices online with client info, package details, deposit tracking, and PDF download." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Photography Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-photographers",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for photographers, videographers, and creative professionals.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What should a photography invoice include?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A photography invoice should include client name and contact, shoot date and location, package description, itemized services (hourly rate, editing, travel), deposit amount, payment terms, and total due."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I create free invoices for my photography business?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows you to create and download professional photography invoices online for free with no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support deposits and balances?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add deposit amounts, deduct paid advances, and show remaining balance clearly on the invoice."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Photography Invoice Generator",
        "item": "https://ratpdf.com/invoice/invoice-generator-photographers"
        }
        ]
        }
    </script>
}

