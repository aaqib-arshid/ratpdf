@{
    ViewData["Title"] = "Invoice Generator for Sole Traders | Free Self-Employed Invoice Maker";
    ViewData["Description"] = "Create professional invoices online for sole traders and self-employed professionals. Free invoice generator with tax support, PDF download – no signup.";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canonicalUrl = "https://ratpdf.com/invoice/invoice-generator-sole-trader";
}

@section Head {
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Invoice Generator for Sole Traders | Free Self-Employed Invoice Maker</title>
    <meta name="title" content="Invoice Generator for Sole Traders | Free Self-Employed Invoice Maker" />
    <meta name="description" content="Create professional invoices online for sole traders and self-employed professionals. Free invoice generator with tax support, PDF download – no signup." />
    <meta name="keywords" content="invoice generator sole trader, sole trader invoice maker, self-employed invoice, freelancer invoice UK, independent contractor invoice, small business invoice template, sole proprietor invoice, self billing invoice" />
    <meta name="author" content="RatPDF" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />

    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:title" content="Invoice Generator for Sole Traders | RatPDF" />
    <meta property="og:description" content="Create professional invoices for sole traders and self-employed – free, fast, no signup." />
    <meta property="og:image" content="https://ratpdf.com/images/hero-invoice.svg" />
    <meta property="og:site_name" content="RatPDF" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="@canonicalUrl" />
    <meta name="twitter:title" content="Invoice Generator for Sole Traders | RatPDF" />
    <meta name="twitter:description" content="Generate and download PDF invoices for sole traders – free, no watermark." />
    <meta name="twitter:image" content="https://ratpdf.com/images/hero-invoice.svg" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "Sole Trader Invoice Generator",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/invoice/invoice-generator-sole-trader",
        "image": "https://ratpdf.com/images/hero-invoice.svg",
        "description": "Free online invoice generator for sole traders, freelancers, and self-employed professionals.",
        "offers": {
        "@@type": "Offer",
        "price": "0",
        "priceCurrency": "GBP"
        },
        "publisher": {
        "@@type": "Organization",
        "name": "RatPDF",
        "url": "https://ratpdf.com"
        }
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
        {
        "@@type": "Question",
        "name": "What is a sole trader invoice?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "A sole trader invoice is a bill issued by a self-employed individual for goods or services provided. It must include the trader's name, address, invoice date, unique number, description of services, amount, and any applicable taxes."
        }
        },
        {
        "@@type": "Question",
        "name": "Can I generate invoices for free as a sole trader?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, RatPDF allows sole traders to create and download professional invoices online for free – no signup required."
        }
        },
        {
        "@@type": "Question",
        "name": "Does the invoice generator support VAT?",
        "acceptedAnswer": {
        "@@type": "Answer",
        "text": "Yes, you can add VAT or other taxes to your invoices. If you're not VAT registered, simply set the tax rate to 0%."
        }
        }
        ]
        }
    </script>

    <script type="application/ld+json">
        {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
        {
        "@@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://ratpdf.com"
        },
        {
        "@@type": "ListItem",
        "position": 2,
        "name": "Invoice Tools",
        "item": "https://ratpdf.com/invoice/create"
        },
        {
        "@@type": "ListItem",
        "position": 3,
        "name": "Sole Trader Invoice Generator",
        "item": "https://ratpdf.com/invoice/invoice-generator-sole-trader"
        }
        ]
        }
    </script>
}

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <span class="badge bg-success mb-3 px-3 py-2">Made for Sole Traders & Freelancers</span>
