<script>

    function updatePreview() {

    let rent = parseFloat($("#rent").val()) || 0;
    let maintenance = parseFloat($("#maintenance").val()) || 0;
    let total = rent + maintenance;

    $("#pLandlord").text($("#landlord").val());
    $("#pTenant").text($("#tenant").val());
    $("#pAddress").text($("#address").val());
    $("#pMonth").text($("#month").val());

    $("#pRent").text("" + rent.toLocaleString());
    $("#pMaintenance").text("" + maintenance.toLocaleString());
    $("#pTotal").text("" + total.toLocaleString());
    }

    $("input").on("keyup change", function () {
    updatePreview();
    });

    updatePreview();

</script>