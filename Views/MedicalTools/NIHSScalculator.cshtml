@{
    ViewData["Title"] = "NIH Stroke Scale (NIHSS) Calculator | Neurological Assessment Tool";
    ViewData["Description"] = "Calculate the National Institutes of Health Stroke Scale (NIHSS) score for acute stroke patients. Used by neurologists and emergency physicians. Client‑side, private, free.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="NIHSS calculator, NIH stroke scale, stroke severity assessment, neurological deficit, acute stroke, thrombolysis decision" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/nihss-calculator" />
    <meta property="og:title" content="NIH Stroke Scale (NIHSS) – Stroke Severity Calculator" />
    <meta property="og:description" content="Calculate stroke severity using the validated NIHSS. Essential for thrombolysis decisions and clinical trials." />
    <meta property="og:url" content="https://ratpdf.com/nihss-calculator" />
    <meta property="og:type" content="website" />

    <style>
        .score-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #0d6efd;
        }
        .result-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
            border-left: 4px solid #0d6efd;
            border-radius: 16px;
            transition: transform 0.2s;
        }
        .result-card:hover {
            transform: translateY(-3px);
        }
        .badge-mild { background-color: #d4edda; color: #155724; }
        .badge-moderate { background-color: #fff3cd; color: #856404; }
        .badge-severe { background-color: #f8d7da; color: #721c24; }
        .info-box {
            background-color: #e7f5ff;
            border-left: 4px solid #0d6efd;
            border-radius: 12px;
            padding: 0.75rem 1rem;
        }
        .item-group {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .item-title {
            font-weight: 600;
            margin-bottom: 0.5rem;
            cursor: pointer;
        }
        .form-check {
            margin-left: 1rem;
        }
    </style>
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🧠 NIH Stroke Scale (NIHSS)</h1>
        <p class="lead text-muted">
            Standardised stroke severity assessment – <strong>used globally for thrombolysis decisions and clinical trials</strong><br />
            Used daily by neurologists, emergency physicians, and stroke coordinators. 100% client‑side, private.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">📊 11 items</span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">🩺 Score 0–42</span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">⚕️ Thrombolysis guidance</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <!-- Clinical note -->
                    <div class="alert alert-info mb-4">
                        <strong>📋 Clinical context:</strong> NIHSS is the gold standard for quantifying stroke deficit. Score ≥ 25 suggests severe stroke; score ≤ 5 suggests mild stroke. Used to guide thrombolysis and predict outcomes.
                    </div>

                    <!-- NIHSS Items (11 items) -->
                    <div class="item-group">
                        <div class="item-title">1a. Level of Consciousness (LOC)</div>
                        <div class="form-check"><input type="radio" name="loc" id="loc0" class="form-check-input" value="0" checked><label class="form-check-label" for="loc0">0 – Alert, keenly responsive</label></div>
                        <div class="form-check"><input type="radio" name="loc" id="loc1" class="form-check-input" value="1"><label class="form-check-label" for="loc1">1 – Not alert but arousable by minor stimulation</label></div>
                        <div class="form-check"><input type="radio" name="loc" id="loc2" class="form-check-input" value="2"><label class="form-check-label" for="loc2">2 – Not alert, requires repeated stimulation</label></div>
                        <div class="form-check"><input type="radio" name="loc" id="loc3" class="form-check-input" value="3"><label class="form-check-label" for="loc3">3 – Unresponsive or reflex movements only</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">1b. LOC Questions (month, age)</div>
                        <div class="form-check"><input type="radio" name="locQuestions" id="locq0" class="form-check-input" value="0" checked><label class="form-check-label" for="locq0">0 – Answers both correctly</label></div>
                        <div class="form-check"><input type="radio" name="locQuestions" id="locq1" class="form-check-input" value="1"><label class="form-check-label" for="locq1">1 – Answers one correctly</label></div>
                        <div class="form-check"><input type="radio" name="locQuestions" id="locq2" class="form-check-input" value="2"><label class="form-check-label" for="locq2">2 – Answers neither correctly</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">1c. LOC Commands (open/close eyes, make fist)</div>
                        <div class="form-check"><input type="radio" name="locCommands" id="locc0" class="form-check-input" value="0" checked><label class="form-check-label" for="locc0">0 – Performs both tasks</label></div>
                        <div class="form-check"><input type="radio" name="locCommands" id="locc1" class="form-check-input" value="1"><label class="form-check-label" for="locc1">1 – Performs one task</label></div>
                        <div class="form-check"><input type="radio" name="locCommands" id="locc2" class="form-check-input" value="2"><label class="form-check-label" for="locc2">2 – Performs neither</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">2. Best Gaze (eye movement)</div>
                        <div class="form-check"><input type="radio" name="gaze" id="gaze0" class="form-check-input" value="0" checked><label class="form-check-label" for="gaze0">0 – Normal</label></div>
                        <div class="form-check"><input type="radio" name="gaze" id="gaze1" class="form-check-input" value="1"><label class="form-check-label" for="gaze1">1 – Partial gaze palsy</label></div>
                        <div class="form-check"><input type="radio" name="gaze" id="gaze2" class="form-check-input" value="2"><label class="form-check-label" for="gaze2">2 – Forced deviation or total paresis</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">3. Visual Fields</div>
                        <div class="form-check"><input type="radio" name="visual" id="vis0" class="form-check-input" value="0" checked><label class="form-check-label" for="vis0">0 – No visual loss</label></div>
                        <div class="form-check"><input type="radio" name="visual" id="vis1" class="form-check-input" value="1"><label class="form-check-label" for="vis1">1 – Partial hemianopia</label></div>
                        <div class="form-check"><input type="radio" name="visual" id="vis2" class="form-check-input" value="2"><label class="form-check-label" for="vis2">2 – Complete hemianopia</label></div>
                        <div class="form-check"><input type="radio" name="visual" id="vis3" class="form-check-input" value="3"><label class="form-check-label" for="vis3">3 – Bilateral blindness (score 3)</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">4. Facial Palsy</div>
                        <div class="form-check"><input type="radio" name="facial" id="face0" class="form-check-input" value="0" checked><label class="form-check-label" for="face0">0 – Normal</label></div>
                        <div class="form-check"><input type="radio" name="facial" id="face1" class="form-check-input" value="1"><label class="form-check-label" for="face1">1 – Minor (asymmetric smile)</label></div>
                        <div class="form-check"><input type="radio" name="facial" id="face2" class="form-check-input" value="2"><label class="form-check-label" for="face2">2 – Partial (lower face)</label></div>
                        <div class="form-check"><input type="radio" name="facial" id="face3" class="form-check-input" value="3"><label class="form-check-label" for="face3">3 – Complete (upper/lower)</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">5. Motor Arm (left & right, separate scores)</div>
                        <label class="fw-semibold">Left arm</label>
                        <div class="form-check"><input type="radio" name="armLeft" id="armL0" class="form-check-input" value="0" checked><label for="armL0">0 – No drift</label></div>
                        <div class="form-check"><input type="radio" name="armLeft" id="armL1" class="form-check-input" value="1"><label for="armL1">1 – Drift before 10 sec</label></div>
                        <div class="form-check"><input type="radio" name="armLeft" id="armL2" class="form-check-input" value="2"><label for="armL2">2 – Some effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="armLeft" id="armL3" class="form-check-input" value="3"><label for="armL3">3 – No effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="armLeft" id="armL4" class="form-check-input" value="4"><label for="armL4">4 – No movement</label></div>
                        <div class="mt-2"><label class="fw-semibold">Right arm</label></div>
                        <div class="form-check"><input type="radio" name="armRight" id="armR0" class="form-check-input" value="0" checked><label for="armR0">0 – No drift</label></div>
                        <div class="form-check"><input type="radio" name="armRight" id="armR1" class="form-check-input" value="1"><label for="armR1">1 – Drift before 10 sec</label></div>
                        <div class="form-check"><input type="radio" name="armRight" id="armR2" class="form-check-input" value="2"><label for="armR2">2 – Some effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="armRight" id="armR3" class="form-check-input" value="3"><label for="armR3">3 – No effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="armRight" id="armR4" class="form-check-input" value="4"><label for="armR4">4 – No movement</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">6. Motor Leg (left & right, separate scores)</div>
                        <label class="fw-semibold">Left leg</label>
                        <div class="form-check"><input type="radio" name="legLeft" id="legL0" class="form-check-input" value="0" checked><label for="legL0">0 – No drift</label></div>
                        <div class="form-check"><input type="radio" name="legLeft" id="legL1" class="form-check-input" value="1"><label for="legL1">1 – Drift before 5 sec</label></div>
                        <div class="form-check"><input type="radio" name="legLeft" id="legL2" class="form-check-input" value="2"><label for="legL2">2 – Some effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="legLeft" id="legL3" class="form-check-input" value="3"><label for="legL3">3 – No effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="legLeft" id="legL4" class="form-check-input" value="4"><label for="legL4">4 – No movement</label></div>
                        <div class="mt-2"><label class="fw-semibold">Right leg</label></div>
                        <div class="form-check"><input type="radio" name="legRight" id="legR0" class="form-check-input" value="0" checked><label for="legR0">0 – No drift</label></div>
                        <div class="form-check"><input type="radio" name="legRight" id="legR1" class="form-check-input" value="1"><label for="legR1">1 – Drift before 5 sec</label></div>
                        <div class="form-check"><input type="radio" name="legRight" id="legR2" class="form-check-input" value="2"><label for="legR2">2 – Some effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="legRight" id="legR3" class="form-check-input" value="3"><label for="legR3">3 – No effort against gravity</label></div>
                        <div class="form-check"><input type="radio" name="legRight" id="legR4" class="form-check-input" value="4"><label for="legR4">4 – No movement</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">7. Limb Ataxia</div>
                        <div class="form-check"><input type="radio" name="ataxia" id="atax0" class="form-check-input" value="0" checked><label for="atax0">0 – No ataxia</label></div>
                        <div class="form-check"><input type="radio" name="ataxia" id="atax1" class="form-check-input" value="1"><label for="atax1">1 – Present in one limb</label></div>
                        <div class="form-check"><input type="radio" name="ataxia" id="atax2" class="form-check-input" value="2"><label for="atax2">2 – Present in two limbs</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">8. Sensory</div>
                        <div class="form-check"><input type="radio" name="sensory" id="sens0" class="form-check-input" value="0" checked><label for="sens0">0 – Normal</label></div>
                        <div class="form-check"><input type="radio" name="sensory" id="sens1" class="form-check-input" value="1"><label for="sens1">1 – Mild to moderate loss</label></div>
                        <div class="form-check"><input type="radio" name="sensory" id="sens2" class="form-check-input" value="2"><label for="sens2">2 – Severe or total loss</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">9. Best Language (aphasia)</div>
                        <div class="form-check"><input type="radio" name="language" id="lang0" class="form-check-input" value="0" checked><label for="lang0">0 – No aphasia</label></div>
                        <div class="form-check"><input type="radio" name="language" id="lang1" class="form-check-input" value="1"><label for="lang1">1 – Mild to moderate aphasia</label></div>
                        <div class="form-check"><input type="radio" name="language" id="lang2" class="form-check-input" value="2"><label for="lang2">2 – Severe aphasia</label></div>
                        <div class="form-check"><input type="radio" name="language" id="lang3" class="form-check-input" value="3"><label for="lang3">3 – Mute or global aphasia</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">10. Dysarthria</div>
                        <div class="form-check"><input type="radio" name="dysarthria" id="dys0" class="form-check-input" value="0" checked><label for="dys0">0 – Normal articulation</label></div>
                        <div class="form-check"><input type="radio" name="dysarthria" id="dys1" class="form-check-input" value="1"><label for="dys1">1 – Mild to moderate dysarthria</label></div>
                        <div class="form-check"><input type="radio" name="dysarthria" id="dys2" class="form-check-input" value="2"><label for="dys2">2 – Unintelligible or anarthric</label></div>
                    </div>

                    <div class="item-group">
                        <div class="item-title">11. Extinction and Inattention (neglect)</div>
                        <div class="form-check"><input type="radio" name="neglect" id="neg0" class="form-check-input" value="0" checked><label for="neg0">0 – No abnormality</label></div>
                        <div class="form-check"><input type="radio" name="neglect" id="neg1" class="form-check-input" value="1"><label for="neg1">1 – Visual, tactile, or auditory neglect</label></div>
                        <div class="form-check"><input type="radio" name="neglect" id="neg2" class="form-check-input" value="2"><label for="neg2">2 – Profound neglect or extinction</label></div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-3 mb-4">
                        <button id="calcBtn" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">✨ Calculate NIHSS</button>
                        <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-4">🔄 Reset All</button>
                    </div>

                    <!-- Results -->
                    <div id="resultsArea" class="mt-3">
                        <div class="result-card p-4 text-center">
                            <div class="small text-muted">NIH Stroke Scale Score</div>
                            <div class="score-value" id="nihssScore">—</div>
                            <div id="severity" class="mt-2">—</div>
                        </div>
                        <div class="info-box mt-3">
                            <strong>📊 Interpretation & Clinical Guidance</strong>
                            <div id="clinicalGuidance" class="mt-1">—</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Educational & SEO Content -->
<section class="container py-5">
    <div class="row g-5">
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">📖 What is the NIH Stroke Scale?</h2>
            <p>The National Institutes of Health Stroke Scale (NIHSS) is a 15‑item neurological examination used to objectively quantify the severity of stroke‑related deficit. It is the gold standard for acute stroke assessment.</p>
            <p><strong>Score range:</strong> 0 (normal) to 42 (maximum deficit). Scores ≥ 25 indicate very severe stroke; scores ≤ 5 suggest mild stroke.</p>
            <p>Used for:</p>
            <ul>
                <li>Thrombolysis (tPA) decision‑making</li>
                <li>Predicting outcomes</li>
                <li>Stratifying patients for clinical trials</li>
                <li>Tracking neurological change</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">✨ Clinical Utility</h2>
            <ul>
                <li><strong>Score 0–4:</strong> Minor stroke – may still benefit from tPA</li>
                <li><strong>Score 5–15:</strong> Moderate stroke – clear deficit, tPA often indicated</li>
                <li><strong>Score 16–20:</strong> Moderate to severe – higher risk of complications</li>
                <li><strong>Score 21–42:</strong> Severe stroke – poor prognosis, often require ICU</li>
            </ul>
            <div class="alert alert-light border mt-2">
                <strong>💡 Pro tip:</strong> A change of ≥ 4 points between serial examinations is considered clinically significant.
            </div>
        </div>
    </div>

    <div class="alert alert-warning border-0 rounded-4 mt-3">
        <h5 class="alert-heading">⚠️ Important Considerations</h5>
        <ul class="mb-0">
            <li>NIHSS requires formal training for reliable use; this tool is for educational and reference purposes.</li>
            <li>For intubated, aphasic, or obtunded patients, some items may be untestable – document reasons.</li>
            <li>Always use clinical judgment alongside the scale.</li>
        </ul>
    </div>

    <h2 class="fw-bold mt-5 mb-4">❓ Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq1">What is the minimum score for tPA eligibility?</button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">Most guidelines require NIHSS ≥ 4 for intravenous tPA, but individual protocols vary. Some treat patients with disabling deficits even with low scores.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq2">How often should NIHSS be repeated?</button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">At baseline, after tPA (2 hours), every 4–8 hours for first 24 hours, then daily or with changes in neurological status.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq3">Is patient data stored?</button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">No. All calculations are client‑side. No data leaves your browser.</div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mt-5 mb-4">🔧 Related Tools</h2>
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6"><a href="/cha2ds2-vasc-score" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🫀 CHA₂DS₂‑VASc</div></a></div>
        <div class="col-md-3 col-6"><a href="/has-bled-score" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🩸 HAS‑BLED</div></a></div>
        <div class="col-md-3 col-6"><a href="/map-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">❤️ MAP</div></a></div>
        <div class="col-md-3 col-6"><a href="/gcs-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🧠 GCS</div></a></div>
    </div>
</section>

@section Scripts
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "NIH Stroke Scale (NIHSS) Calculator",
        "applicationCategory": "HealthApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/nihss-calculator",
        "description": "Calculate stroke severity using the 11-item NIH Stroke Scale. Used for thrombolysis decisions and clinical trials.",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": "Complete 11‑item NIHSS, severity classification, clinical recommendations"
    }
    </script>

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "What is the minimum score for tPA eligibility?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Most guidelines require NIHSS ≥ 4 for intravenous tPA, but protocols vary."
                }
            },
            {
                "@@type": "Question",
                "name": "How often should NIHSS be repeated?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "At baseline, after tPA (2 hours), every 4–8 hours for 24 hours, then daily."
                }
            }
        ]
    }
    </script>

    <script>
        (function() {
          
            function getRadioValue(name) {
                const radios = document.querySelectorAll(`input[name="${name}"]`);
                for (let r of radios) {
                    if (r.checked) return parseInt(r.value);
                }
                return 0;
            }

            function getArmScore() {
                let left = getRadioValue('armLeft');
                let right = getRadioValue('armRight');
                return left + right;
            }

            function getLegScore() {
                let left = getRadioValue('legLeft');
                let right = getRadioValue('legRight');
                return left + right;
            }

            function calculateTotal() {
                let total = 0;
                total += getRadioValue('loc');
                total += getRadioValue('locQuestions');
                total += getRadioValue('locCommands');
                total += getRadioValue('gaze');
                total += getRadioValue('visual');
                total += getRadioValue('facial');
                total += getArmScore();
                total += getLegScore();
                total += getRadioValue('ataxia');
                total += getRadioValue('sensory');
                total += getRadioValue('language');
                total += getRadioValue('dysarthria');
                total += getRadioValue('neglect');
                return total;
            }

            function updateResults() {
                const score = calculateTotal();
                document.getElementById('nihssScore').innerText = score;

                let severityClass = '', severityText = '', guidance = '';
                if (score <= 4) {
                    severityClass = 'badge-mild';
                    severityText = 'Minor stroke';
                    guidance = 'Mild deficit. May still benefit from thrombolysis if disabling symptoms. Consider rapid discharge with antiplatelet therapy if not disabling.';
                } else if (score <= 10) {
                    severityClass = 'badge-mild';
                    severityText = 'Mild to moderate stroke';
                    guidance = 'Moderate deficit. Strongly consider intravenous tPA if within 4.5 hours. Admit for stroke workup.';
                } else if (score <= 15) {
                    severityClass = 'badge-moderate';
                    severityText = 'Moderate stroke';
                    guidance = 'Moderate to severe deficit. tPA strongly indicated if eligible. Monitor for neurological deterioration.';
                } else if (score <= 20) {
                    severityClass = 'badge-moderate';
                    severityText = 'Moderate to severe stroke';
                    guidance = 'Significant deficit. High risk of complications. Consider ICU admission and mechanical thrombectomy if large vessel occlusion.';
                } else {
                    severityClass = 'badge-severe';
                    severityText = 'Severe stroke';
                    guidance = 'Very severe deficit. Poor prognosis without intervention. Urgent neurology consultation. Evaluate for endovascular thrombectomy.';
                }
                document.getElementById('severity').innerHTML = `<span class="badge ${severityClass} fs-6 p-2">${severityText} (Score ${score})</span>`;
                document.getElementById('clinicalGuidance').innerHTML = guidance;
            }

            function resetAll() {
                const allRadios = document.querySelectorAll('input[type="radio"]');
                allRadios.forEach(radio => radio.checked = false);
              
                const groups = ['loc', 'locQuestions', 'locCommands', 'gaze', 'visual', 'facial',
                    'armLeft', 'armRight', 'legLeft', 'legRight', 'ataxia', 'sensory', 'language', 'dysarthria', 'neglect'];
                groups.forEach(group => {
                    const first = document.querySelector(`input[name="${group}"][value="0"]`);
                    if (first) first.checked = true;
                });
                updateResults();
            }

          
            const allRadios = document.querySelectorAll('input[type="radio"]');
            allRadios.forEach(radio => radio.addEventListener('change', updateResults));
            document.getElementById('calcBtn').addEventListener('click', updateResults);
            document.getElementById('resetBtn').addEventListener('click', resetAll);

            updateResults();
        })();
    </script>
}