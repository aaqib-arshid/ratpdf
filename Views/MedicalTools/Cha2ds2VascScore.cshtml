@{
    ViewData["Title"] = "CHA₂DS₂‑VASc Score Calculator | Stroke Risk Assessment Tool for AFib";
    ViewData["Description"] = "Calculate CHA₂DS₂‑VASc score for atrial fibrillation patients. Predict annual stroke risk. Used by cardiologists, neurologists, and GPs. 100% client-side, private, free.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="CHA2DS2 VASc score, stroke risk calculator, atrial fibrillation stroke risk, CHADS2 score, anticoagulation decision tool, cardiology calculator" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/cha2ds2-vasc-score" />
    <meta property="og:title" content="CHA₂DS₂‑VASc Score – Stroke Risk Calculator for AFib" />
    <meta property="og:description" content="Clinical decision tool for stroke risk stratification in non‑valvular atrial fibrillation. Evidence‑based, point‑of‑care." />
    <meta property="og:url" content="https://ratpdf.com/cha2ds2-vasc-score" />
    <meta property="og:type" content="website" />

    <style>
        .risk-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
            border-left: 4px solid #0d6efd;
            border-radius: 16px;
            transition: transform 0.2s;
        }
        .risk-card:hover {
            transform: translateY(-3px);
        }
        .score-badge {
            font-size: 2.5rem;
            font-weight: bold;
            color: #0d6efd;
        }
        .interpretation {
            background-color: #e7f5ff;
            border-radius: 12px;
            padding: 0.75rem;
        }
        .risk-table td, .risk-table th {
            padding: 0.5rem;
            text-align: center;
        }
    </style>
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🫀 CHA₂DS₂‑VASc Score Calculator</h1>
        <p class="lead text-muted">
            Stroke risk assessment for non‑valvular atrial fibrillation – <strong>used by clinicians worldwide</strong><br />
            100% client‑side, private, no data stored.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">📊 Stroke risk prediction</span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">🩺 Evidence‑based</span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">🔒 No patient data stored</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="row g-4">
                        <!-- Risk factors checklist -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Patient Risk Factors</label>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="chf" class="form-check-input">
                                <label class="form-check-label" for="chf">❤️ Congestive heart failure (or LV dysfunction)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="hypertension" class="form-check-input">
                                <label class="form-check-label" for="hypertension">🩸 Hypertension</label>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="diabetes" class="form-check-input">
                                <label class="form-check-label" for="diabetes">🍬 Diabetes mellitus</label>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="stroke" class="form-check-input">
                                <label class="form-check-label" for="stroke">🧠 Prior stroke / TIA / thromboembolism (2 points)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="vascular" class="form-check-input">
                                <label class="form-check-label" for="vascular">🩻 Vascular disease (prior MI, PAD, aortic plaque)</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">👤 Demographics</label>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="age75" class="form-check-input">
                                <label class="form-check-label" for="age75">📅 Age ≥ 75 years (2 points)</label>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">📅 Age 65–74 years (1 point)</label>
                                <input type="number" id="age" class="form-control" placeholder="Enter age" min="0" max="120">
                                <div class="form-text">If age ≥ 75, check the box above instead.</div>
                            </div>
                            <div class="form-check mb-2">
                                <input type="checkbox" id="female" class="form-check-input">
                                <label class="form-check-label" for="female">♀️ Female sex (1 point if age ≥ 65 or additional risk factor)</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4 mb-4">
                        <button id="calculateBtn" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">✨ Calculate Score</button>
                        <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-4">🔄 Reset</button>
                    </div>

                    <!-- Results -->
                    <div id="resultsArea" class="mt-4">
                        <div class="risk-card p-4 text-center">
                            <div class="small text-muted">CHA₂DS₂‑VASc Score</div>
                            <div class="score-badge" id="scoreValue">0</div>
                            <div id="scoreInterpretation" class="mt-2">Low risk</div>
                        </div>
                        <div class="mt-3 interpretation">
                            <strong>📊 Annual Stroke Risk (without anticoagulation)</strong>
                            <div id="strokeRisk" class="mt-1">—</div>
                            <div class="small text-muted mt-2">Based on large cohort studies (Lip et al., 2010; Friberg et al., 2012)</div>
                        </div>
                        <div class="mt-3 interpretation">
                            <strong>🩺 Clinical Recommendation</strong>
                            <div id="recommendation" class="mt-1">—</div>
                            <div class="small text-muted mt-2">Per ESC 2020 / ACC 2019 guidelines</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Educational & SEO Content -->
<section class="container py-5">
    <div class="row g-5">
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">📖 What is the CHA₂DS₂‑VASc Score?</h2>
            <p>The CHA₂DS₂‑VASc score is a clinical prediction tool for estimating the risk of ischemic stroke in patients with non‑valvular atrial fibrillation (AFib). It helps clinicians decide whether anticoagulation therapy is beneficial.</p>
            <p><strong>Score components:</strong></p>
            <ul>
                <li>C – Congestive heart failure (1 point)</li>
                <li>H – Hypertension (1 point)</li>
                <li>A₂ – Age ≥ 75 years (2 points)</li>
                <li>D – Diabetes mellitus (1 point)</li>
                <li>S₂ – Prior stroke / TIA / thromboembolism (2 points)</li>
                <li>V – Vascular disease (1 point)</li>
                <li>A – Age 65–74 years (1 point)</li>
                <li>Sc – Female sex (1 point, only when combined with other risk factors)</li>
            </ul>
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">✨ Clinical Utility</h2>
            <ul>
                <li><strong>Score 0</strong> in males / <strong>Score 1</strong> in females → Low risk, no anticoagulation usually recommended.</li>
                <li><strong>Score ≥ 2</strong> → Consider oral anticoagulation (direct oral anticoagulants or warfarin).</li>
                <li>Used daily by cardiologists, neurologists, emergency physicians, and general practitioners.</li>
                <li>Validated in multiple large cohorts.</li>
            </ul>
            <p>All calculations are performed locally in your browser – patient data never leaves your device.</p>
        </div>
    </div>

    <div class="alert alert-info border-0 rounded-4 mt-3">
        <h5 class="alert-heading">💡 Evidence Base</h5>
        <p class="mb-0">The score was derived from the Euro Heart Survey on AF and validated in multiple populations. For a CHA₂DS₂‑VASc score of 0 in males, the adjusted stroke rate is 0%–0.78% per year. For score ≥ 2, annual stroke risk can exceed 6% without anticoagulation.</p>
    </div>

    <h2 class="fw-bold mt-5 mb-4">❓ Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq1">What is the difference between CHADS₂ and CHA₂DS₂‑VASc?</button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">CHA₂DS₂‑VASc adds additional risk factors (vascular disease, age 65–74, female sex) and has better discrimination for patients at truly low risk. It is now the preferred score in international guidelines.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq2">When should I anticoagulate?</button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">Current guidelines (ESC 2020, ACC 2019) recommend oral anticoagulation for males with CHA₂DS₂‑VASc ≥ 2 and females with score ≥ 3. For score 1 in males or 2 in females, consider anticoagulation after shared decision‑making. This tool provides general recommendations – always use clinical judgment.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq3">Is patient data stored?</button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">No. All calculations are client‑side. No information is sent to any server. Your patients’ data remains private.</div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mt-5 mb-4">🔧 Related Tools</h2>
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6"><a href="/bmi-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">⚖️ BMI Calculator</div></a></div>
        <div class="col-md-3 col-6"><a href="/egfr-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🧪 eGFR (CKD-EPI)</div></a></div>
        <div class="col-md-3 col-6"><a href="/wells-score" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🩸 Wells Score (PE/DVT)</div></a></div>
        <div class="col-md-3 col-6"><a href="/period-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🌸 Period Calculator</div></a></div>
    </div>
</section>

@section Scripts
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "CHA₂DS₂‑VASc Score Calculator",
        "applicationCategory": "HealthApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/cha2ds2-vasc-score",
        "description": "Calculate stroke risk in atrial fibrillation using CHA₂DS₂‑VASc score. Evidence-based, point-of-care tool for clinicians.",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": "Stroke risk prediction, guideline recommendations, client-side, private"
    }
    </script>

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "What is the difference between CHADS₂ and CHA₂DS₂‑VASc?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "CHA₂DS₂‑VASc adds vascular disease, age 65-74, and female sex, offering better low-risk discrimination."
                }
            },
            {
                "@@type": "Question",
                "name": "When should I anticoagulate?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Males with score ≥ 2 and females with score ≥ 3 should typically receive anticoagulation per current guidelines."
                }
            }
        ]
    }
    </script>

    <script>
        (function() {
            const chkCHF = document.getElementById('chf');
            const chkHTN = document.getElementById('hypertension');
            const chkDM = document.getElementById('diabetes');
            const chkStroke = document.getElementById('stroke');
            const chkVascular = document.getElementById('vascular');
            const chkAge75 = document.getElementById('age75');
            const ageInput = document.getElementById('age');
            const chkFemale = document.getElementById('female');
            const calculateBtn = document.getElementById('calculateBtn');
            const resetBtn = document.getElementById('resetBtn');
            const scoreSpan = document.getElementById('scoreValue');
            const interpretationDiv = document.getElementById('scoreInterpretation');
            const strokeRiskDiv = document.getElementById('strokeRisk');
            const recommendationDiv = document.getElementById('recommendation');

            function calculateScore() {
                let score = 0;
                // Congestive heart failure
                if (chkCHF.checked) score += 1;
                // Hypertension
                if (chkHTN.checked) score += 1;
                // Diabetes
                if (chkDM.checked) score += 1;
                // Prior stroke/TIA (2 points)
                if (chkStroke.checked) score += 2;
                // Vascular disease
                if (chkVascular.checked) score += 1;
                // Age ≥ 75 (2 points) – overrides age 65-74
                if (chkAge75.checked) {
                    score += 2;
                } else {
                    const age = parseInt(ageInput.value);
                    if (!isNaN(age) && age >= 65 && age <= 74) {
                        score += 1;
                    }
                }
                // Female sex: only add point if age ≥ 65 OR other risk factors present
                if (chkFemale.checked) {
                    const age = parseInt(ageInput.value);
                    const hasOtherRisk = chkCHF.checked || chkHTN.checked || chkDM.checked || chkStroke.checked || chkVascular.checked || chkAge75.checked || (!isNaN(age) && age >= 65);
                    if (hasOtherRisk) {
                        score += 1;
                    }
                }
                scoreSpan.textContent = score;

                // Interpretation and risk table (based on Lip et al. 2010, Friberg et al. 2012)
                let riskPercent = '';
                let interpretation = '';
                let recommendation = '';
                if (score === 0) {
                    interpretation = 'Low stroke risk';
                    riskPercent = '0.2 – 0.8% per year';
                    recommendation = 'No anticoagulation therapy is typically recommended. Consider patient preferences.';
                } else if (score === 1) {
                    interpretation = 'Moderate stroke risk';
                    riskPercent = '0.9 – 2.0% per year';
                    recommendation = 'Consider oral anticoagulation after shared decision‑making (especially if additional risk factors).';
                } else if (score === 2) {
                    interpretation = 'Moderate‑high stroke risk';
                    riskPercent = '2.2 – 3.7% per year';
                    recommendation = 'Oral anticoagulation (DOAC or warfarin) is recommended.';
                } else if (score === 3) {
                    interpretation = 'High stroke risk';
                    riskPercent = '3.7 – 5.6% per year';
                    recommendation = 'Strongly recommend oral anticoagulation (DOAC preferred).';
                } else if (score === 4) {
                    interpretation = 'High stroke risk';
                    riskPercent = '4.8 – 7.4% per year';
                    recommendation = 'Strongly recommend oral anticoagulation. Assess bleeding risk.';
                } else if (score === 5) {
                    interpretation = 'Very high stroke risk';
                    riskPercent = '6.3 – 9.3% per year';
                    recommendation = 'Oral anticoagulation mandatory. Close follow‑up.';
                } else {
                    interpretation = 'Very high stroke risk';
                    riskPercent = '8.2 – 12.5% per year';
                    recommendation = 'Urgent anticoagulation and specialist referral recommended.';
                }
                interpretationDiv.textContent = interpretation;
                strokeRiskDiv.textContent = riskPercent;
                recommendationDiv.textContent = recommendation;
            }

            function resetForm() {
                chkCHF.checked = false;
                chkHTN.checked = false;
                chkDM.checked = false;
                chkStroke.checked = false;
                chkVascular.checked = false;
                chkAge75.checked = false;
                ageInput.value = '';
                chkFemale.checked = false;
                calculateScore();
            }

            calculateBtn.addEventListener('click', calculateScore);
            resetBtn.addEventListener('click', resetForm);
          
            const inputs = [chkCHF, chkHTN, chkDM, chkStroke, chkVascular, chkAge75, ageInput, chkFemale];
            inputs.forEach(input => {
                input.addEventListener('change', calculateScore);
                if (input === ageInput) input.addEventListener('input', calculateScore);
            });
            calculateScore();
        })();
    </script>
}