    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "What is the difference between DVT and PE Wells scores?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "The DVT Wells score focuses on limb findings and risk factors. The PE Wells score includes systemic signs and DVT symptoms, as DVT is a source of emboli."
                }
            },
            {
                "@@type": "Question",
                "name": "How accurate is the Wells score?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "For DVT, a score ≥3 has ~80% sensitivity. For PE, the 'unlikely' category (≤4) combined with a normal D-dimer has >99% negative predictive value."
                }
            }
        ]
    }
    </script>

    <script>
        (function() {
            // DVT Wells Score elements
            const dvtCheckboxes = [
                'dvt_activeCancer', 'dvt_paralysis', 'dvt_bedridden', 'dvt_tenderness',
                'dvt_swelling', 'dvt_calfSwelling', 'dvt_pittingEdema', 'dvt_collaterals',
                'dvt_priorDvt', 'dvt_alternative'
            ];
            const dvtScores = [1, 1, 1, 1, 1, 1, 1, 1, 1, -2];
            let dvtScore = 0;

            // PE Wells Score elements
            const peCheckboxes = [
                'pe_clinicalSigns', 'pe_alternative', 'pe_tachycardia', 'pe_immobilization',
                'pe_priorDvtPe', 'pe_hemoptysis', 'pe_malignancy'
            ];
            const peScores = [3, 3, 1.5, 1.5, 1.5, 1, 1];
            let peScore = 0;

            function updateDvtScore() {
                let total = 0;
                for (let i = 0; i < dvtCheckboxes.length; i++) {
                    const chk = document.getElementById(dvtCheckboxes[i]);
                    if (chk && chk.checked) total += dvtScores[i];
                }
                dvtScore = total;
                document.getElementById('dvtScore').innerText = dvtScore.toFixed(1);

                // Interpretation
                let interpretation = '', probability = '', recommendation = '';
                if (dvtScore <= 0) {
                    interpretation = 'DVT Unlikely';
                    probability = 'Approximately 3% pre-test probability of DVT';
                    recommendation = 'Consider D‑dimer testing. A normal D‑dimer effectively excludes DVT.';
                } else if (dvtScore >= 1 && dvtScore <= 2) {
                    interpretation = 'Moderate Risk';
                    probability = 'Approximately 17% pre-test probability of DVT';
                    recommendation = 'Perform D‑dimer testing. If positive, consider venous ultrasound.';
                } else if (dvtScore >= 3) {
                    interpretation = 'DVT Likely';
                    probability = 'Approximately 75% pre-test probability of DVT';
                    recommendation = 'Proceed directly to venous ultrasound. D‑dimer is not useful due to high pre-test probability.';
                }
                document.getElementById('dvtInterpretation').innerHTML = `<span class="badge ${dvtScore <= 0 ? 'bg-success' : (dvtScore <= 2 ? 'bg-warning text-dark' : 'bg-danger')} p-2 fs-6">${interpretation}</span>`;
                document.getElementById('dvtProbability').innerHTML = probability;
                document.getElementById('dvtRecommendation').innerHTML = recommendation;
            }

            function updatePeScore() {
                let total = 0;
                for (let i = 0; i < peCheckboxes.length; i++) {
                    const chk = document.getElementById(peCheckboxes[i]);
                    if (chk && chk.checked) total += peScores[i];
                }
                peScore = total;
                document.getElementById('peScore').innerText = peScore.toFixed(1);

                let interpretation = '', probability = '', recommendation = '';
                if (peScore <= 4) {
                    interpretation = 'PE Unlikely';
                    probability = 'Approximately 1.3% pre-test probability of PE';
                    recommendation = 'D‑dimer testing is recommended. A normal D‑dimer safely excludes PE.';
                } else {
                    interpretation = 'PE Likely';
                    probability = 'Approximately 40% pre-test probability of PE';
                    recommendation = 'Proceed directly to CTPA (CT pulmonary angiography) or V/Q scan. D‑dimer is not recommended.';
                }
                document.getElementById('peInterpretation').innerHTML = `<span class="badge ${peScore <= 4 ? 'bg-success' : 'bg-danger'} p-2 fs-6">${interpretation}</span>`;
                document.getElementById('peProbability').innerHTML = probability;
                document.getElementById('peRecommendation').innerHTML = recommendation;
            }

            // Event listeners for DVT
            dvtCheckboxes.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('change', updateDvtScore);
            });
            document.getElementById('calcDvtBtn').addEventListener('click', updateDvtScore);
            peCheckboxes.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.addEventListener('change', updatePeScore);
            });
            document.getElementById('calcPeBtn').addEventListener('click', updatePeScore);
            updateDvtScore();
            updatePeScore();
        })();
    </script>
