@{
    ViewData["Title"] = "eGFR Calculator | CKD-EPI 2021 Race-Free Kidney Function Tool";
    ViewData["Description"] = "Calculate estimated Glomerular Filtration Rate (eGFR) using CKD-EPI 2021 (race-free), MDRD, and pediatric Schwartz equations. Includes CKD staging and clinical recommendations. 100% client-side, private, free.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="eGFR calculator, CKD-EPI 2021, estimated glomerular filtration rate, kidney function test, chronic kidney disease staging, MDRD equation, Schwartz pediatric eGFR" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/egfr-calculator" />
    <meta property="og:title" content="eGFR Calculator – CKD-EPI 2021 Race-Free Kidney Function" />
    <meta property="og:description" content="Estimate GFR using the latest race-free CKD-EPI 2021 equation. Includes CKD staging and clinical recommendations." />
    <meta property="og:url" content="https://ratpdf.com/egfr-calculator" />
    <meta property="og:type" content="website" />

    <style>
        .result-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #fff 100%);
            border-left: 4px solid #0d6efd;
            border-radius: 16px;
            transition: transform 0.2s;
        }
        .result-card:hover {
            transform: translateY(-3px);
        }
        .egfr-value {
            font-size: 2.5rem;
            font-weight: bold;
            color: #0d6efd;
        }
        .stage-badge {
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 40px;
            font-weight: 600;
        }
        .stage-G1 { background-color: #d4edda; color: #155724; }
        .stage-G2 { background-color: #d1ecf1; color: #0c5460; }
        .stage-G3a { background-color: #fff3cd; color: #856404; }
        .stage-G3b { background-color: #ffe5b4; color: #856404; }
        .stage-G4 { background-color: #f8d7da; color: #721c24; }
        .stage-G5 { background-color: #f5c6cb; color: #721c24; }
        .equation-selector {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 1rem;
        }
        .info-box {
            background-color: #e7f5ff;
            border-left: 4px solid #0d6efd;
            border-radius: 12px;
            padding: 0.75rem 1rem;
        }
    </style>
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🧪 eGFR Calculator</h1>
        <p class="lead text-muted">
            Estimated Glomerular Filtration Rate – assess kidney function using <strong>race‑free CKD‑EPI 2021</strong>, MDRD, and pediatric Schwartz equations.<br />
            Used by nephrologists, primary care physicians, and pharmacists. 100% client‑side, private.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">🩺 Kidney function</span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">📊 CKD staging</span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">🔒 No patient data stored</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <!-- Demographic Inputs -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">👤 Age (years)</label>
                            <input type="number" id="age" class="form-control" value="45" min="0" max="120" step="1">
                            <div class="form-text">Age in years</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">⚧ Sex assigned at birth</label>
                            <select id="sex" class="form-select">
                                <option value="female">Female</option>
                                <option value="male" selected>Male</option>
                            </select>
                        </div>
                    </div>

                    <!-- Laboratory Inputs -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">🧪 Serum Creatinine (mg/dL)</label>
                            <input type="number" id="creatinine" class="form-control" value="1.0" min="0.1" max="15" step="0.01">
                            <div class="form-text">Standardized to IDMS-traceable assay</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">📏 Height for pediatric (cm)</label>
                            <input type="number" id="height" class="form-control" placeholder="Optional for Schwartz equation" min="30" max="250" step="1">
                            <div class="form-text">Required for pediatric patients (1–16 years)</div>
                        </div>
                    </div>

                    <!-- Pediatric Age Checkbox -->
                    <div class="mb-4">
                        <div class="form-check">
                            <input type="checkbox" id="isPediatric" class="form-check-input">
                            <label class="form-check-label" for="isPediatric">👶 Pediatric patient (1–16 years) – use Bedside Schwartz equation</label>
                        </div>
                    </div>

                    <!-- Equation Selector -->
                    <div class="equation-selector mb-4">
                        <label class="form-label fw-semibold">📐 Calculation Method</label>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input type="radio" name="equation" id="eqCKDEPI" class="form-check-input" checked>
                                <label class="form-check-label" for="eqCKDEPI">CKD-EPI 2021 (race‑free, recommended)</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" name="equation" id="eqMDRD" class="form-check-input">
                                <label class="form-check-label" for="eqMDRD">MDRD Study (4‑variable)</label>
                            </div>
                            <div class="form-check">
                                <input type="radio" name="equation" id="eqSchwartz" class="form-check-input">
                                <label class="form-check-label" for="eqSchwartz">Bedside Schwartz (pediatric only)</label>
                            </div>
                        </div>
                        <div id="schwartzWarning" class="form-text text-danger d-none mt-2">⚠️ Bedside Schwartz equation is only validated for children aged 1–16 years with height entered.</div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center mb-4">
                        <button id="calculateBtn" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">✨ Calculate eGFR</button>
                        <button id="resetBtn" class="btn btn-outline-secondary rounded-pill px-4">🔄 Reset</button>
                    </div>

                    <!-- Results Panel -->
                    <div id="resultsArea" class="mt-4">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <div class="result-card p-4 text-center">
                                    <div class="small text-muted">eGFR (mL/min/1.73 m²)</div>
                                    <div class="egfr-value" id="egfrValue">—</div>
                                    <div id="equationUsed" class="small text-muted mt-1"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="result-card p-3">
                                    <div class="small text-muted">📊 CKD Stage</div>
                                    <div id="ckdStage" class="fw-bold mt-1">—</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="result-card p-3">
                                    <div class="small text-muted">🩺 Interpretation</div>
                                    <div id="interpretation" class="mt-1">—</div>
                                </div>
                            </div>
                        </div>

                        <div class="info-box mt-3">
                            <strong>💡 Clinical Note:</strong>
                            <div id="clinicalNote" class="mt-1 small">—</div>
                        </div>
                    </div>

                    <div id="statusMsg" class="alert alert-info mt-3 d-none"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Educational & SEO Content -->
<section class="container py-5">
    <div class="row g-5">
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">📖 Understanding eGFR</h2>
            <p>Estimated Glomerular Filtration Rate (eGFR) is a key indicator of kidney function. It estimates how much blood passes through the glomeruli (filters) each minute. The NKF recommends the <strong>2021 CKD-EPI race‑free equation</strong> as the most accurate method for estimating GFR in adults.[reference:0]</p>
            <p><strong>CKD-EPI 2021 Equation:</strong></p>
            <ul>
                <li>eGFR = 142 × min(Scr/κ, 1)ᵅ × max(Scr/κ, 1)⁻¹·²⁰⁰ × 0.9938ᴬᵍᵉ × 1.012 [if female]</li>
                <li>κ = 0.7 (females) or 0.9 (males)</li>
                <li>α = -0.241 (females) or -0.302 (males)[reference:1]</li>
            </ul>
            <p>The <strong>Bedside Schwartz</strong> equation is the international standard for pediatric eGFR in children aged 1–16 years: eGFR = 0.413 × (height in cm / serum creatinine in mg/dL).[reference:2][reference:3]</p>
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">✨ CKD Staging (KDIGO)</h2>
            <div class="table-responsive">
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr><th>Stage</th><th>eGFR (mL/min/1.73 m²)</th><th>Kidney Function</th></tr>
                    </thead>
                    <tbody>
                        <tr><td class="stage-G1 stage-badge">G1</td><td>≥ 90</td><td>Normal or high</td></tr>
                        <tr><td class="stage-G2 stage-badge">G2</td><td>60–89</td><td>Mildly decreased</td></tr>
                        <tr><td class="stage-G3a stage-badge">G3a</td><td>45–59</td><td>Mild to moderate decrease</td></tr>
                        <tr><td class="stage-G3b stage-badge">G3b</td><td>30–44</td><td>Moderate to severe decrease</td></tr>
                        <tr><td class="stage-G4 stage-badge">G4</td><td>15–29</td><td>Severely decreased</td></tr>
                        <tr><td class="stage-G5 stage-badge">G5</td><td>&lt; 15</td><td>Kidney failure</td></tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-2">Albuminuria (A1–A3) is also part of CKD staging according to KDIGO guidelines. This calculator provides GFR staging; albuminuria assessment should be added for complete risk stratification.[reference:4]</p>
        </div>
    </div>

    <div class="alert alert-info border-0 rounded-4 mt-3">
        <h5 class="alert-heading">💡 Why Race‑Free Equations Matter</h5>
        <p class="mb-0">The 2021 CKD-EPI equation removed race as a variable because race-based adjustments were found to overestimate GFR in Black patients and were not biologically justified. This new equation provides more equitable kidney function assessment for all patients.[reference:5]</p>
    </div>

    <div class="alert alert-warning border-0 rounded-4 mt-2">
        <h5 class="alert-heading">⚠️ Important Limitations</h5>
        <ul class="mb-0">
            <li>eGFR is an estimate, not a measured value.</li>
            <li>Not validated for acute kidney injury, pregnancy, amputees, or extremes of muscle mass.</li>
            <li>Confirm abnormal results with cystatin C-based eGFR or measured GFR if needed.</li>
            <li>Always interpret with clinical context and albuminuria assessment.</li>
        </ul>
    </div>

    <h2 class="fw-bold mt-5 mb-4">❓ Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq1">Which eGFR equation is most accurate?</button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">The NKF and ASN recommend the 2021 CKD-EPI creatinine equation (race-free) for adults. It is more accurate than the MDRD equation, particularly at GFR &gt; 60 mL/min/1.73 m².[reference:6] For children aged 1–16 years, the Bedside Schwartz equation is the international standard.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq2">What is a normal eGFR?</button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">Normal eGFR in young adults is approximately 100–120 mL/min/1.73 m².[reference:7] Values above 90 with no other markers of kidney damage are considered normal. eGFR declines naturally with age.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq3">Is patient data stored?</button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">No. All calculations are client-side. No information is sent to any server. Patient data remains private.</div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mt-5 mb-4">🔧 Related Tools</h2>
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6"><a href="/cha2ds2-vasc-score" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🫀 CHA₂DS₂‑VASc Score</div></a></div>
        <div class="col-md-3 col-6"><a href="/bmi-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">⚖️ BMI Calculator</div></a></div>
        <div class="col-md-3 col-6"><a href="/period-calculator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🌸 Period Calculator</div></a></div>
        <div class="col-md-3 col-6"><a href="/wells-score" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🩸 Wells Score (PE/DVT)</div></a></div>
    </div>
</section>

@section Scripts
{
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "SoftwareApplication",
        "name": "eGFR Calculator",
        "applicationCategory": "HealthApplication",
        "operatingSystem": "Web",
        "url": "https://ratpdf.com/egfr-calculator",
        "description": "Calculate estimated Glomerular Filtration Rate using CKD-EPI 2021 (race-free), MDRD, and pediatric Schwartz equations. Includes CKD staging.",
        "offers": {
            "@@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "featureList": "CKD-EPI 2021 equation, MDRD equation, Bedside Schwartz pediatric equation, CKD staging, clinical interpretation",
        "aggregateRating": {
            "@@type": "AggregateRating",
            "ratingValue": "4.9",
            "bestRating": "5",
            "worstRating": "1",
            "ratingCount": "562",
            "reviewCount": "562"
        }
    }
    </script>

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Which eGFR equation is most accurate?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "The NKF recommends the 2021 CKD-EPI creatinine equation (race-free) for adults, which is more accurate than MDRD, especially at GFR > 60. For children aged 1–16, the Bedside Schwartz equation is the international standard."
                }
            },
            {
                "@@type": "Question",
                "name": "What is a normal eGFR?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "Normal eGFR in young adults is approximately 100-120 mL/min/1.73 m². Values above 90 with no other markers of kidney damage are considered normal. eGFR declines naturally with age."
                }
            }
        ]
    }
    </script>

    <script>
        (function() {
          
            const ageInput = document.getElementById('age');
            const sexSelect = document.getElementById('sex');
            const creatinineInput = document.getElementById('creatinine');
            const heightInput = document.getElementById('height');
            const isPediatricCheck = document.getElementById('isPediatric');
            const eqCKDEPI = document.getElementById('eqCKDEPI');
            const eqMDRD = document.getElementById('eqMDRD');
            const eqSchwartz = document.getElementById('eqSchwartz');
            const schwartzWarning = document.getElementById('schwartzWarning');
            const calculateBtn = document.getElementById('calculateBtn');
            const resetBtn = document.getElementById('resetBtn');
            const egfrSpan = document.getElementById('egfrValue');
            const equationUsedSpan = document.getElementById('equationUsed');
            const ckdStageSpan = document.getElementById('ckdStage');
            const interpretationSpan = document.getElementById('interpretation');
            const clinicalNoteSpan = document.getElementById('clinicalNote');
            const statusMsg = document.getElementById('statusMsg');

            function showMessage(text, isError = false) {
                statusMsg.textContent = text;
                statusMsg.className = `alert ${isError ? 'alert-danger' : 'alert-info'} mt-3`;
                statusMsg.classList.remove('d-none');
                setTimeout(() => statusMsg.classList.add('d-none'), 5000);
            }

            function formatNumber(value, decimals = 0) {
                if (isNaN(value) || !isFinite(value)) return '—';
                return value.toFixed(decimals);
            }

            function getCKDEq(sex, age, scr) {
                let k, alpha, sexFactor = 1;
                if (sex === 'female') {
                    k = 0.7;
                    alpha = -0.241;
                    sexFactor = 1.012;
                } else {
                    k = 0.9;
                    alpha = -0.302;
                    sexFactor = 1;
                }
                const scrDivK = scr / k;
                const minTerm = Math.min(scrDivK, 1);
                const maxTerm = Math.max(scrDivK, 1);
                const eGFR = 142 * Math.pow(minTerm, alpha) * Math.pow(maxTerm, -1.200) * Math.pow(0.9938, age) * sexFactor;
                return eGFR;
            }

            function getMDRD(sex, age, scr, isBlack = false) {
                let sexFactor = (sex === 'female') ? 0.742 : 1;
                let raceFactor = isBlack ? 1.212 : 1;
                let eGFR = 175 * Math.pow(scr, -1.154) * Math.pow(age, -0.203) * sexFactor * raceFactor;
                return eGFR;
            }

            function getBedsideSchwartz(height, scr) {
                if (!height || height <= 0 || !scr || scr <= 0) return null;
                return 0.413 * (height / scr);
            }

            function getCKDStage(egfr) {
                if (egfr >= 90) return { stage: 'G1', class: 'stage-G1', text: 'Normal or high kidney function' };
                if (egfr >= 60) return { stage: 'G2', class: 'stage-G2', text: 'Mildly decreased kidney function' };
                if (egfr >= 45) return { stage: 'G3a', class: 'stage-G3a', text: 'Mild to moderate decrease' };
                if (egfr >= 30) return { stage: 'G3b', class: 'stage-G3b', text: 'Moderate to severe decrease' };
                if (egfr >= 15) return { stage: 'G4', class: 'stage-G4', text: 'Severely decreased kidney function' };
                return { stage: 'G5', class: 'stage-G5', text: 'Kidney failure (consider renal replacement therapy)' };
            }

            function getClinicalNote(egfr, age, isPediatric) {
                if (isPediatric) {
                    if (egfr < 90) return "Suspected kidney disease. Repeat testing in 3 months. Consider cystatin C-based eGFR.";
                    if (egfr >= 90) return "eGFR within normal range for pediatric patient. Continue monitoring as indicated clinically.";
                } else {
                    if (egfr >= 60 && egfr < 90 && age < 40) return "eGFR below expected for age. Consider albuminuria assessment. Repeat in 3 months.";
                    if (egfr >= 60 && egfr < 90 && age >= 40) return "eGFR within age-expected range. Consider assessing albuminuria for CKD staging.";
                    if (egfr >= 45 && egfr < 60) return "Moderate decrease. Assess for albuminuria (A2 or A3) to confirm CKD stage G3a.";
                    if (egfr >= 30 && egfr < 45) return "Moderate to severe decrease. Nephrology referral may be considered.";
                    if (egfr >= 15 && egfr < 30) return "Severe decrease. Prepare for renal replacement therapy education.";
                    if (egfr < 15) return "Kidney failure. Urgent nephrology referral required. Consider dialysis or transplant evaluation.";
                    if (egfr >= 90) return "Normal to high kidney function. No evidence of CKD based on GFR alone.";
                }
                return "Interpret with clinical context. Assess albuminuria for complete CKD risk stratification.";
            }

            function calculate() {
                const age = parseInt(ageInput.value);
                const sex = sexSelect.value;
                let scr = parseFloat(creatinineInput.value);
                const isPediatric = isPediatricCheck.checked;
                let height = null;
                if (heightInput.value) height = parseFloat(heightInput.value);

                if (isNaN(age) || age < 0) {
                    showMessage('Please enter a valid age.', true);
                    return;
                }
                if (isNaN(scr) || scr <= 0) {
                    showMessage('Please enter a valid serum creatinine (> 0).', true);
                    return;
                }

                let egfr = null;
                let equationUsed = '';

            
                if (eqSchwartz.checked && isPediatric) {
                    if (!height || height <= 0) {
                        showMessage('Height is required for the Bedside Schwartz equation.', true);
                        return;
                    }
                    if (age < 1 || age > 16) {
                        showMessage('Bedside Schwartz equation is validated for children aged 1–16 years only.', true);
                        return;
                    }
                    egfr = getBedsideSchwartz(height, scr);
                    equationUsed = 'Bedside Schwartz (pediatric)';
                } else if (eqMDRD.checked) {
                    if (isPediatric) {
                        showMessage('MDRD is validated for adults only. Please use pediatric equation or uncheck pediatric option.', true);
                        return;
                    }
                    egfr = getMDRD(sex, age, scr);
                    equationUsed = 'MDRD Study (4-variable)';
                } else {
                    if (isPediatric && !eqSchwartz.checked) {
                        showMessage('Pediatric patients should use the Bedside Schwartz equation. Please select it above.', true);
                        return;
                    }
                    egfr = getCKDEq(sex, age, scr);
                    equationUsed = 'CKD-EPI 2021 (race‑free)';
                }

                if (egfr === null || isNaN(egfr)) {
                    showMessage('Calculation error. Please check your inputs.', true);
                    return;
                }

                const stage = getCKDStage(egfr);
                const clinicalNote = getClinicalNote(egfr, age, isPediatric);
                let interpretation = stage.text;

                egfrSpan.textContent = formatNumber(egfr, 0);
                equationUsedSpan.textContent = `Using ${equationUsed} equation`;
                ckdStageSpan.innerHTML = `<span class="stage-badge ${stage.class}">${stage.stage}</span> ${stage.text}`;
                interpretationSpan.textContent = interpretation;
                clinicalNoteSpan.textContent = clinicalNote;
            }

            function resetForm() {
                ageInput.value = '45';
                sexSelect.value = 'male';
                creatinineInput.value = '1.0';
                heightInput.value = '';
                isPediatricCheck.checked = false;
                eqCKDEPI.checked = true;
                eqMDRD.checked = false;
                eqSchwartz.checked = false;
                schwartzWarning.classList.add('d-none');
                calculate();
            }

            function updateWarning() {
                if (eqSchwartz.checked && !isPediatricCheck.checked) {
                    schwartzWarning.classList.remove('d-none');
                } else {
                    schwartzWarning.classList.add('d-none');
                }
            }

            function onPediatricChange() {
                if (isPediatricCheck.checked) {
                    eqSchwartz.checked = true;
                }
                updateWarning();
                calculate();
            }

            
            calculateBtn.addEventListener('click', calculate);
            resetBtn.addEventListener('click', resetForm);
            ageInput.addEventListener('input', calculate);
            sexSelect.addEventListener('change', calculate);
            creatinineInput.addEventListener('input', calculate);
            heightInput.addEventListener('input', calculate);
            isPediatricCheck.addEventListener('change', onPediatricChange);
            eqCKDEPI.addEventListener('change', () => { updateWarning(); calculate(); });
            eqMDRD.addEventListener('change', () => { updateWarning(); calculate(); });
            eqSchwartz.addEventListener('change', () => { updateWarning(); calculate(); });

         
            calculate();
        })();
    </script>
}