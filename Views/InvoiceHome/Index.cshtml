@{
    ViewData["Title"] = "Free Invoice Generator - Create Professional Invoices Instantly";
}

<div class="container-fluid bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-4 fw-bold">Create Professional Invoices in Seconds</h1>
                <p class="lead mt-3">Generate, download, and share beautiful invoices for free — no signup required. Upgrade for custom branding and templates.</p>
                <a asp-controller="Invoice" asp-action="Create" class="btn btn-light btn-lg mt-3 fw-bold">Start Free</a>
            </div>
            <div class="col-md-5 text-center d-none d-md-block">
                <img src="~/images/hero-invoice.svg" alt="Invoice illustration" class="img-fluid" style="max-height:300px;" />
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1 text-primary mb-2">⚡</div>
                    <h5>Instant PDF Download</h5>
                    <p class="text-muted">Fill in details, click download — your invoice is ready in milliseconds.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1 text-primary mb-2">🎨</div>
                    <h5>Custom Branding</h5>
                    <p class="text-muted">Add your logo, brand colors, and custom footer. Remove watermarks with Pro plan.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1 text-primary mb-2">💰</div>
                    <h5>Free Forever</h5>
                    <p class="text-muted">No credit card required. Generate unlimited invoices for free.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container text-center">
        <h2 class="mb-4">Join thousands who trust Rat PDF's Invoice Generator</h2>
        <a asp-controller="Invoice" asp-action="Create" class="btn btn-primary btn-lg px-5">Create Your First Invoice Now →</a>
    </div>
</div>