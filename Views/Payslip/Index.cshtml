    <meta name="keywords" content="free payslip generator,paystub generator,salary slip generator,payslip pdf,paystub maker,payslip template" />

    <meta name="robots" content="index, follow" />

    <link rel="canonical"
          href="https://ratpdf.com/free-payslip-generator" />

    <!-- Open Graph -->
    <meta property="og:title"
          content="Free Payslip Generator Online" />

    <meta property="og:description"
          content="Generate professional payslips instantly with logo upload and PDF download." />

    <meta property="og:url"
          content="https://ratpdf.com/free-payslip-generator" />

    <meta property="og:type"
          content="website" />

    <meta property="og:image"
          content="https://ratpdf.com/images/payslip-generator-preview.jpg" />

    <!-- Twitter -->
