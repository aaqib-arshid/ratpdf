@section Scripts
{
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        function updatePreview() {

        let salary =
        parseFloat($("#basicSalary").val()) || 0;

        let bonus =
        parseFloat($("#bonus").val()) || 0;

        let deductions =
        parseFloat($("#deductions").val()) || 0;

        let net =
        salary + bonus - deductions;

        $("#previewCompany")
        .text($("#companyName").val());

        $("#previewEmployee")
        .text($("#employeeName").val());

        $("#previewEmployeeId")
        .text($("#employeeId").val());

        $("#previewDesignation")
        .text($("#designation").val());

        $("#previewPeriod")
        .text($("#payPeriod").val());

        $("#previewSalary")
        .text("" + salary.toLocaleString());

        $("#previewBonus")
        .text("" + bonus.toLocaleString());

        $("#previewDeductions")
        .text("" + deductions.toLocaleString());

        $("#previewNet")
        .text("" + net.toLocaleString());
        }

        $("input").on("keyup change", function () {
        updatePreview();
        });

        $("#companyLogo").on("change", function (e) {

        const file = e.target.files[0];

        if (file) {

        const reader = new FileReader();

        reader.onload = function (event) {

        $("#logoPreview")
        .attr("src", event.target.result)
        .show();

        };

        reader.readAsDataURL(file);
        }
        });

        updatePreview();

    </script>
}