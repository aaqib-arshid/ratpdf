@model ratpdf.Controllers.HtmlFormatterViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Content.MetaTitle;
    ViewData["Description"] = Model.Content.MetaDescription;
}

@section Head {
    <link rel="canonical" href="https://ratpdf.com/html-formatter/@Model.Content.Slug" />
    <meta property="og:title" content="@Model.Content.MetaTitle" />
    <meta property="og:description" content="@Model.Content.MetaDescription" />
    <meta property="og:url" content="https://ratpdf.com/html-formatter/@Model.Content.Slug" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">@Html.Raw(Model.BreadcrumbSchema)</script>
    <script type="application/ld+json">@Html.Raw(Model.FaqSchema)</script>
}

<article>
    <h1>@Model.Content.HeadingH1</h1>
    @Html.Raw(Model.Content.IntroductionHtml)
    
    @foreach (var sect in Model.Content.Sections)
    {
        <section>
            <h2>@sect.Heading</h2>
            @Html.Raw(sect.Html)
        </section>
    }
    
    @if (!string.IsNullOrEmpty(Model.Content.CodeExampleHtml))
    {
        <div class="code-example">
            <h2>Code Examples</h2>
            @Html.Raw(Model.Content.CodeExampleHtml)
        </div>
    }
    
    @if (Model.Content.Faqs.Any())
    {
        <div class="faq-section">
            <h2>Frequently Asked Questions</h2>
            @foreach (var faq in Model.Content.Faqs)
            {
                <div itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <h3 itemprop="name">@faq.Question</h3>
                    <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <div itemprop="text">@faq.Answer</div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="related-links">
        <h3>Related Topics</h3>
        <ul>
            @foreach (var related in Model.Content.RelatedSlugs)
            {
                <li><a href="/html-formatter/@related">@related.Replace("-", " ")</a></li>
            }
        </ul>
    </div>
</article>