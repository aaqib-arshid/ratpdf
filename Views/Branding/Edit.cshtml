@using ratpdf.Data.Entities
@model BrandingSettings
@{
    ViewData["Title"] = "Custom Branding";
}

<div class="container mt-4">
    <h2>Branding Settings</h2>
    <p class="text-muted">Customize your invoice appearance (Pro/Business feature).</p>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="CompanyName" class="form-label"></label>
                        <input asp-for="CompanyName" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrimaryColor" class="form-label">Brand Color</label>
                        <input asp-for="PrimaryColor" type="color" class="form-control form-control-color" />
                    </div>
                    <div class="col-12">
                        <label asp-for="CompanyAddress" class="form-label"></label>
                        <textarea asp-for="CompanyAddress" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="FooterText" class="form-label">Footer Text</label>
                        <input asp-for="FooterText" class="form-control" placeholder="Thank you for your business" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Logo (PNG/JPG, max 1 MB)</label>
                        <input type="file" name="logoFile" class="form-control" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.LogoUrl))
                        {
                            <div class="mt-2">
                                <img src="@Model.LogoUrl" alt="Logo" style="max-height: 60px;" />
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save Branding</button>
                    <a asp-controller="Invoice" asp-action="Create" class="btn btn-outline-secondary ms-2">Test in Invoice</a>
                </div>
            </form>
        </div>
    </div>
</div>