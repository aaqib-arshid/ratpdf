</script>

    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "FAQPage",
        "mainEntity": [
            {
                "@@type": "Question",
                "name": "Does this tool reduce image resolution?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "No, the output image retains the original width and height exactly."
                }
            },
            {
                "@@type": "Question",
                "name": "Is my image uploaded to a server?",
                "acceptedAnswer": {
                    "@@type": "Answer",
                    "text": "No, all conversion happens locally in your browser."
                }
            }
        ]
    }
    </script>

    <script>
        (function() {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const fileNameDiv = document.getElementById('fileName');
            const originalImg = document.getElementById('originalPreview');
            const originalPlaceholder = document.getElementById('originalPlaceholder');
            const convertedImg = document.getElementById('convertedPreview');
            const convertedPlaceholder = document.getElementById('convertedPlaceholder');
            const convertBtn = document.getElementById('convertBtn');
            const downloadBtn = document.getElementById('downloadBtn');
            const qualityControl = document.getElementById('qualityControl');
            const qualitySlider = document.getElementById('qualitySlider');
            const statusMsg = document.getElementById('statusMsg');
            const formatBadges = document.querySelectorAll('.format-badge');
            
            let currentFile = null;
            let originalImageUrl = null;
            let convertedBlob = null;
            let selectedFormat = 'image/png';      // default PNG
            let originalWidth = 0, originalHeight = 0;
            
            function showMessage(text, isError = false) {
                statusMsg.textContent = text;
                statusMsg.className = `alert ${isError ? 'alert-danger' : 'alert-info'} mt-3`;
                statusMsg.classList.remove('d-none');
                setTimeout(() => statusMsg.classList.add('d-none'), 5000);
            }
            
            function setActiveFormat(format) {
                selectedFormat = format;
                formatBadges.forEach(badge => {
                    const fmt = badge.getAttribute('data-format');
                    if (fmt === format) {
                        badge.classList.add('active');
                    } else {
                        badge.classList.remove('active');
                    }
                });

                if (format === 'image/jpeg' || format === 'image/webp') {
                    qualityControl.classList.remove('d-none');
                } else {
                    qualityControl.classList.add('d-none');
                }

                if (currentFile && originalImageUrl) {
                    convertImage();
                }
            }
            

            function handleFile(file) {
                if (!file) return;
                if (!file.type.startsWith('image/')) {
                    showMessage('Please select an image file.', true);
                    return;
                }
                currentFile = file;
                fileNameDiv.innerText = file.name;
                const url = URL.createObjectURL(file);
                if (originalImageUrl) URL.revokeObjectURL(originalImageUrl);
                originalImageUrl = url;
                originalImg.src = url;
                originalImg.style.display = 'block';
                originalPlaceholder.style.display = 'none';
                convertBtn.disabled = false;
                downloadBtn.disabled = true;
                convertedImg.style.display = 'none';
                convertedPlaceholder.style.display = 'block';
                convertedBlob = null;
                

                const img = new Image();
                img.onload = () => {
                    originalWidth = img.width;
                    originalHeight = img.height;
                    console.log(`Original dimensions: ${originalWidth}x${originalHeight}`);
                };
                img.src = url;
            }
            

            async function convertImage() {
                if (!currentFile) {
                    showMessage('No image selected.', true);
                    return;
                }
                convertBtn.disabled = true;
                showMessage('Converting...', false);
                
                try {
                    const img = await loadImage(originalImageUrl);
                    const canvas = document.createElement('canvas');
                    canvas.width = img.width;
                    canvas.height = img.height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, img.width, img.height);
                    
                    let mimeType = selectedFormat;
                    let quality = undefined;
                    if (selectedFormat === 'image/jpeg' || selectedFormat === 'image/webp') {
                        quality = parseInt(qualitySlider.value) / 100;
                    }
                    const blob = await new Promise(resolve => {
                        canvas.toBlob(resolve, mimeType, quality);
                    });
                    convertedBlob = blob;
                    const url = URL.createObjectURL(blob);
                    convertedImg.src = url;
                    convertedImg.style.display = 'block';
                    convertedPlaceholder.style.display = 'none';
                    downloadBtn.disabled = false;
                    showMessage('Conversion complete! You can now download.');
                } catch (err) {
                    console.error(err);
                    showMessage('Conversion failed: ' + err.message, true);
                } finally {
                    convertBtn.disabled = false;
                }
            }
            
            function loadImage(src) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    img.onload = () => resolve(img);
                    img.onerror = reject;
                    img.src = src;
                });
            }
            
            function downloadConverted() {
                if (!convertedBlob) {
                    showMessage('No converted image. Please convert first.', true);
                    return;
                }
                const extension = selectedFormat.split('/')[1].replace('jpeg', 'jpg');
                const filename = `converted_${Date.now()}.${extension}`;
                const url = URL.createObjectURL(convertedBlob);
                const a = document.createElement('a');
                a.href = url;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showMessage(`Downloaded as ${extension.toUpperCase()} – resolution preserved (${originalWidth}x${originalHeight}).`);
            }
            
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                const file = e.dataTransfer.files[0];
                if (file) {
                    fileInput.files = e.dataTransfer.files;
                    handleFile(file);
                }
            });
            fileInput.addEventListener('change', () => {
                if (fileInput.files.length > 0) handleFile(fileInput.files[0]);
            });
            
            formatBadges.forEach(badge => {
                badge.addEventListener('click', () => {
                    const format = badge.getAttribute('data-format');
                    setActiveFormat(format);
                });
            });
            
            convertBtn.addEventListener('click', convertImage);
            downloadBtn.addEventListener('click', downloadConverted);
            qualitySlider.addEventListener('input', () => {
                if (currentFile && originalImageUrl) convertImage();
            });
            
            setActiveFormat('image/png');
        })();
    </script>
}