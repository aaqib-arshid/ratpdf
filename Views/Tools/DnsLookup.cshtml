@{
ViewData["Title"] = "DNS Lookup Tool - Check A, MX Records Online";
ViewData["Description"] = "Free DNS lookup tool. Check A records, MX records, and domain DNS information instantly.";
}

<head>
    <link rel="canonical" href="https://ratpdf.com/Tools/DnsLookup" />
</head>

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">
        <h2 class="fw-bold mb-3">DNS Lookup Tool</h2>
        <p class="text-muted mb-4">Enter a domain to check DNS records like A and MX.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger text-start">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-action="DnsLookup">
            <div class="mb-3">
                <input type="text" name="domain" class="form-control form-control-lg"
                       placeholder="Enter domain (example.com)">
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">
                Lookup DNS
            </button>
        </form>
        @if (ViewBag.ARecords != null)
        {
            <hr />
            <div class="text-start mt-3">
                <h5>A Records (IP Addresses)</h5>
                <ul>
                    @foreach (var ip in ViewBag.ARecords)
                    {
                        <li>@ip</li>
                    }
                </ul>
            </div>
        }

        @if (ViewBag.MXRecords != null)
        {
            <div class="text-start mt-3">
                <h5>MX Records (Mail Servers)</h5>
                <ul>
                    @foreach (var mx in ViewBag.MXRecords)
                    {
                        <li>@mx</li>
                    }
                </ul>
            </div>
        }

    </div>
</div>

</div>

