@section Scripts
{
    <script>

        function binaryToDecimal(binary)
        {
            if(!/^[01]+$/.test(binary))
            {
                return "";
            }

            return parseInt(binary, 2);
        }

        $("#binaryInput").on("keyup change", function ()
        {
            let value = $(this).val().trim();

            if(value === "")
            {
                $("#decimalOutput").text("0");
                return;
            }

            let result = binaryToDecimal(value);

            $("#decimalOutput").text(
                result === "" ? "Invalid Binary" : result
            );
        });

    </script>
}