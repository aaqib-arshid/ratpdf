                    Analyze Another Domain
                </a>
            </div>

        </div>
    }

</article>

<script>
    (function () {
        // ── Score ring + counter animation ──
        var arc = document.getElementById('scoreArc');
        var counter = document.getElementById('scoreCounter');
        if (arc && counter) {
            var score = @score;
            var circumference = @(circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture));
            var targetOffset = circumference * (1 - score / 100);
            var start = null;
            var duration = 1100;

            function animateCounter(ts) {
                if (!start) start = ts;
                var progress = Math.min((ts - start) / duration, 1);
                var ease = 1 - Math.pow(1 - progress, 3);
                counter.textContent = Math.round(ease * score);
                if (progress < 1) requestAnimationFrame(animateCounter);
            }

            setTimeout(function () {
                arc.style.strokeDashoffset = targetOffset;
                requestAnimationFrame(animateCounter);
            }, 200);
        }

        // ── Copy link button ──
        // Wired here rather than via onclick="" so the function stays
        // scoped to this partial and doesn't need to exist on the parent page.
        var copyBtn = document.getElementById('copyLinkBtn');
        if (copyBtn) {
            copyBtn.addEventListener('click', function () {
                var btn = this; 
                var url = "https://ratpdf.com/Tools/GSCIndex";
                navigator.clipboard.writeText(url).then(function () {
                    var orig = btn.textContent;
                    btn.textContent = 'Copied!';
                    setTimeout(function () { btn.textContent = orig; }, 2000);
                }).catch(function () {
                    var ta = document.createElement('textarea');
                    ta.value = url;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    var orig = btn.textContent;
                    btn.textContent = 'Copied!';
                    setTimeout(function () { btn.textContent = orig; }, 2000);
                });
            });
        }
    })();
</script>
