@model ratpdf.Models.DecayResult

@{
    Layout = null;
    var hasErrors = !ViewData.ModelState.IsValid;
    var shareUrl = "https://ratpdf.com/tools/gscindex";
    var score = Model?.DecayScore ?? 0;
    var scoreColor = score >= 70 ? "#ef4444" : score >= 40 ? "#f97316" : "#22c55e";
    var scoreLabel = score >= 70 ? "Critical" : score >= 40 ? "Moderate" : "Healthy";
    var totalPages = Model?.Articles?.Count ?? 0;
    var criticalPages = Model?.Articles?.Count(a => a.DecayPercent > 60) ?? 0;
    var avgDecay = totalPages > 0 ? (int)Model.Articles.Average(a => a.DecayPercent) : 0;
    var circumference = 2 * Math.PI * 54;
    var dashOffset = circumference * (1 - score / 100.0);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root {
        --bg: #0c0d10;
        --surface: #13151b;
        --surface2: #1a1d26;
        --border: rgba(255,255,255,0.07);
        --border-soft: rgba(255,255,255,0.04);
        --text: #e8eaf2;
        --muted: #6b7488;
        --accent: #e2ff6a;
        --accent-dim: rgba(226,255,106,0.12);
        --danger: #ef4444;
        --warn: #f97316;
        --good: #22c55e;
        --font-display: 'Syne', sans-serif;
        --font-body: 'DM Sans', sans-serif;
        --font-mono: 'DM Mono', monospace;
        --r: 10px;
    }

    .decay-report * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .decay-report {
        font-family: var(--font-body);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        padding: 0 0 80px;
        font-size: 15px;
        line-height: 1.65;
    }

    /* ── HEADER BAND ── */
    .dr-hero {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 48px 40px 40px;
        position: relative;
        overflow: hidden;
    }

        .dr-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 90% 50%, rgba(226,255,106,0.04) 0%, transparent 70%);
            pointer-events: none;
        }

    .dr-hero-eyebrow {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .dr-hero-eyebrow::before {
            content: '';
            display: inline-block;
            width: 20px;
            height: 1px;
            background: var(--accent);
        }

    .dr-hero h1 {
        font-family: var(--font-display);
        font-size: clamp(26px, 4vw, 40px);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: #fff;
        margin-bottom: 8px;
    }

        .dr-hero h1 span {
            color: var(--accent);
        }

    .dr-hero-sub {
        color: var(--muted);
        font-size: 14px;
        max-width: 520px;
    }

    .dr-hero-actions {
        display: flex;
        gap: 10px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .dr-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-body);
        font-size: 13px;
        font-weight: 500;
        padding: 9px 18px;
        border-radius: 6px;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.15s;
        border: none;
    }

        .dr-btn:hover {
            opacity: 0.8;
        }

    .dr-btn-primary {
        background: var(--accent);
        color: #0c0d10;
    }

    .dr-btn-ghost {
        background: var(--surface2);
        color: var(--text);
        border: 1px solid var(--border);
    }

    /* ── MAIN LAYOUT ── */
    .dr-body {
        padding: 32px 40px;
        max-width: 1100px;
    }

    /* ── SCORE + STATS ROW ── */
    .dr-top-row {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dr-score-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 28px 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .dr-score-ring {
        position: relative;
        width: 130px;
        height: 130px;
        margin-bottom: 16px;
    }

        .dr-score-ring svg {
            transform: rotate(-90deg);
        }

    .dr-score-ring-track {
        fill: none;
        stroke: var(--surface2);
        stroke-width: 8;
    }

    .dr-score-ring-fill {
        fill: none;
        stroke-width: 8;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.2s cubic-bezier(0.16,1,0.3,1);
    }

    .dr-score-num {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .dr-score-num strong {
            font-family: var(--font-display);
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            color: #fff;
        }

        .dr-score-num small {
            font-family: var(--font-mono);
            font-size: 10px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

    .dr-score-label {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 4px 12px;
        border-radius: 30px;
        font-weight: 500;
    }

        .dr-score-label.critical {
            background: rgba(239,68,68,0.15);
            color: #f87171;
        }

        .dr-score-label.moderate {
            background: rgba(249,115,22,0.15);
            color: #fb923c;
        }

        .dr-score-label.healthy {
            background: rgba(34,197,94,0.15);
            color: #4ade80;
        }

    .dr-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        align-content: start;
    }

    .dr-stat {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 20px;
    }

    .dr-stat-label {
        font-size: 12px;
        color: var(--muted);
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 6px;
    }

    .dr-stat-val {
        font-family: var(--font-display);
        font-size: 28px;
        font-weight: 700;
        color: #fff;
        line-height: 1;
    }

    .dr-stat-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 4px;
    }

    /* ── TABLE SECTION ── */
    .dr-section {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        overflow: hidden;
        margin-bottom: 20px;
    }

    .dr-section-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .dr-section-title {
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 700;
        color: #fff;
    }

    .dr-section-hint {
        font-size: 12px;
        color: var(--muted);
        font-family: var(--font-mono);
    }

    table.dr-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

    .dr-table thead th {
        padding: 11px 20px;
        text-align: left;
        font-family: var(--font-mono);
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
        font-weight: 400;
        white-space: nowrap;
    }

        .dr-table thead th:not(:first-child) {
            text-align: right;
        }

    .dr-table tbody tr {
        border-bottom: 1px solid var(--border-soft);
        transition: background 0.1s;
    }

        .dr-table tbody tr:last-child {
            border-bottom: none;
        }

        .dr-table tbody tr:hover {
            background: rgba(255,255,255,0.025);
        }

    .dr-table td {
        padding: 14px 20px;
        vertical-align: middle;
    }

        .dr-table td:not(:first-child) {
            text-align: right;
        }

    .dr-table .dr-url a {
        color: var(--text);
        text-decoration: none;
        font-size: 13px;
        max-width: 320px;
        display: block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .dr-table .dr-url a:hover {
            color: var(--accent);
        }

    .dr-table .dr-url small {
        display: block;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 11px;
        margin-top: 2px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 320px;
    }

    .dr-num {
        font-family: var(--font-mono);
        font-size: 13px;
        color: #cdd0db;
    }

    .dr-decay-cell {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    .dr-decay-bar-wrap {
        width: 60px;
        height: 4px;
        background: var(--surface2);
        border-radius: 2px;
        overflow: hidden;
    }

    .dr-decay-bar {
        height: 100%;
        border-radius: 2px;
    }

    .dr-decay-pct {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 500;
        min-width: 42px;
        text-align: right;
    }

    .dr-badge {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 30px;
    }

        .dr-badge.high {
            background: rgba(239,68,68,0.15);
            color: #f87171;
        }

        .dr-badge.med {
            background: rgba(249,115,22,0.15);
            color: #fb923c;
        }

        .dr-badge.low {
            background: rgba(226,255,106,0.12);
            color: #bfd944;
        }

    /* ── INFO PANELS ── */
    .dr-two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .dr-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 24px;
    }

        .dr-panel h3 {
            font-family: var(--font-display);
            font-size: 15px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dr-panel h3 .ico {
                width: 26px;
                height: 26px;
                background: var(--accent-dim);
                border-radius: 6px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
            }

    .dr-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

        .dr-list li {
            font-size: 13.5px;
            color: #a8adc0;
            display: flex;
            align-items: flex-start;
            gap: 8px;
            line-height: 1.5;
        }

            .dr-list li::before {
                content: '';
                display: inline-block;
                width: 5px;
                height: 5px;
                background: var(--accent);
                border-radius: 50%;
                margin-top: 6px;
                flex-shrink: 0;
            }

    .dr-steps {
        list-style: none;
        counter-reset: step;
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

        .dr-steps li {
            counter-increment: step;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            font-size: 13.5px;
            color: #a8adc0;
            line-height: 1.5;
        }

            .dr-steps li::before {
                content: counter(step);
                display: flex;
                align-items: center;
                justify-content: center;
                width: 22px;
                height: 22px;
                background: var(--surface2);
                border: 1px solid var(--border);
                border-radius: 50%;
                font-family: var(--font-mono);
                font-size: 10px;
                color: var(--accent);
                flex-shrink: 0;
                margin-top: 1px;
            }

    /* ── FAQ ── */
    .dr-faq {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .dr-faq-item {
        border-bottom: 1px solid var(--border);
        padding: 18px 0;
    }

        .dr-faq-item:first-child {
            padding-top: 0;
        }

        .dr-faq-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .dr-faq-q {
        font-family: var(--font-display);
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 6px;
    }

    .dr-faq-a {
        font-size: 13.5px;
        color: #8a90a8;
        line-height: 1.6;
    }

    /* ── CTA ── */
    .dr-cta {
        background: var(--accent-dim);
        border: 1px solid rgba(226,255,106,0.18);
        border-radius: var(--r);
        padding: 32px 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

        .dr-cta h2 {
            font-family: var(--font-display);
            font-size: 20px;
            font-weight: 800;
            color: var(--accent);
            margin-bottom: 4px;
        }

        .dr-cta p {
            font-size: 13.5px;
            color: #a8adc0;
            max-width: 420px;
        }

    /* ── ERROR / EMPTY ── */
    .dr-state-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 56px 40px;
        text-align: center;
        max-width: 520px;
        margin: 60px auto;
    }

        .dr-state-box h2 {
            font-family: var(--font-display);
            font-size: 22px;
            font-weight: 800;
            color: #fff;
            margin-bottom: 10px;
        }

        .dr-state-box p {
            color: var(--muted);
            font-size: 14px;
            margin-bottom: 24px;
        }

        .dr-state-box.error h2 {
            color: #f87171;
        }

    @@media (max-width: 780px) {
        .dr-hero {
            padding: 32px 20px 28px;
        }

        .dr-body {
            padding: 24px 20px;
        }

        .dr-top-row {
            grid-template-columns: 1fr;
        }

        .dr-stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .dr-two-col {
            grid-template-columns: 1fr;
        }

        .dr-score-card {
            flex-direction: row;
            text-align: left;
            gap: 20px;
        }
    }
</style>

<article class="decay-report">

    @if (hasErrors)
    {
        <div class="dr-body">
            <div class="dr-state-box error" role="alert">
                <h2>Report Unavailable</h2>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <p>@error.ErrorMessage</p>
                }
                <a href="/Tools/GSCIndex" class="dr-btn dr-btn-primary">Try Again</a>
            </div>
        </div>
    }
    else if (Model == null)
    {
        <div class="dr-body">
            <div class="dr-state-box">
                <h2>No Report Yet</h2>
                <p>Enter your domain above to analyze content decay using live Google Search Console data.</p>
                <a href="/Tools/GSCIndex" class="dr-btn dr-btn-primary">Analyze a Domain</a>
            </div>
        </div>
    }
    else
    {
        <!-- HERO -->
        <header class="dr-hero">
            <div class="dr-hero-eyebrow">Content Decay Report</div>
            <h1>@Model.Domain <span>audit</span></h1>
            <p class="dr-hero-sub">
                16 months of Google Search Console data — page-level traffic trends, peak vs. recent performance, and decay severity.
            </p>
            <div class="dr-hero-actions">
                <a href="/Tools/GSCIndex" class="dr-btn dr-btn-primary">Analyze Another Domain</a>
                <button class="dr-btn dr-btn-ghost" id="copyLinkBtn">Copy Report Link</button>
                <a href="https://twitter.com/intent/tweet?text=@Uri.EscapeDataString($"My site scored {Model.DecayScore}/100 on content decay — check yours")&url=@shareUrl"
                   target="_blank" class="dr-btn dr-btn-ghost">
                    Share ↗
                </a>
            </div>
        </header>

        <div class="dr-body">

            <!-- SCORE + STATS -->
            <div class="dr-top-row">
                <div class="dr-score-card">
                    <div class="dr-score-ring">
                        <svg width="130" height="130" viewBox="0 0 130 130" aria-hidden="true">
                            <circle class="dr-score-ring-track" cx="65" cy="65" r="54" />
                            <circle class="dr-score-ring-fill" cx="65" cy="65" r="54"
                                    id="scoreArc"
                                    stroke="@scoreColor"
                                    stroke-dasharray="@(circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))"
                                    stroke-dashoffset="@(circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))" />
                        </svg>
                        <div class="dr-score-num">
                            <strong id="scoreCounter">0</strong>
                            <small>/ 100</small>
                        </div>
                    </div>
                    <span class="dr-score-label @(scoreLabel.ToLower())">@scoreLabel</span>
                </div>

                <div class="dr-stats-grid">
                    <div class="dr-stat">
                        <div class="dr-stat-label">Pages analyzed</div>
                        <div class="dr-stat-val">@totalPages</div>
                        <div class="dr-stat-sub">indexed URLs</div>
                    </div>
                    <div class="dr-stat">
                        <div class="dr-stat-label">Critical pages</div>
                        <div class="dr-stat-val" style="color:#f87171">@criticalPages</div>
                        <div class="dr-stat-sub">decay &gt; 60%</div>
                    </div>
                    <div class="dr-stat">
                        <div class="dr-stat-label">Avg decay</div>
                        <div class="dr-stat-val" style="color:#fb923c">@avgDecay%</div>
                        <div class="dr-stat-sub">across all pages</div>
                    </div>
                    <div class="dr-stat" style="grid-column: 1 / -1; background: rgba(226,255,106,0.04); border-color: rgba(226,255,106,0.12);">
                        <div class="dr-stat-label" style="color:#bfd944">Recoverable traffic</div>
                        <div class="dr-stat-val" style="color:var(--accent); font-size:22px">
                            Updating decayed pages can recover <strong>30–70%</strong> of lost clicks without new content.
                        </div>
                    </div>
                </div>
            </div>

            <!-- PAGES TABLE -->
            @if (Model.Articles != null && Model.Articles.Any())
            {
                <div class="dr-section" style="margin-bottom:20px;">
                    <div class="dr-section-header">
                        <span class="dr-section-title">Decaying pages</span>
                        <span class="dr-section-hint">Top @(Math.Min(25, Model.Articles.Count)) by severity</span>
                    </div>
                    <table class="dr-table">
                        <thead>
                            <tr>
                                <th>Page</th>
                                <th>Peak clicks</th>
                                <th>Recent clicks</th>
                                <th>Decay</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Articles.Take(25))
                            {
                                var sev = item.DecayPercent > 60 ? "high" : item.DecayPercent > 30 ? "med" : "low";
                                var barColor = item.DecayPercent > 60 ? "#ef4444" : item.DecayPercent > 30 ? "#f97316" : "#e2ff6a";
                                var pctColor = item.DecayPercent > 60 ? "#f87171" : item.DecayPercent > 30 ? "#fb923c" : "#bfd944";
                                var barWidth = Math.Min(100, item.DecayPercent);
                                <tr>
                                    <td class="dr-url">
                                        <a href="@item.Url" target="_blank" rel="noopener">@item.Title</a>
                                        <small>@item.Url</small>
                                    </td>
                                    <td><span class="dr-num">@item.PeakClicks.ToString("N0")</span></td>
                                    <td><span class="dr-num">@item.CurrentClicks.ToString("N0")</span></td>
                                    <td>
                                        <div class="dr-decay-cell">
                                            <div class="dr-decay-bar-wrap">
                                                <div class="dr-decay-bar" style="width:@barWidth%;background:@barColor"></div>
                                            </div>
                                            <span class="dr-decay-pct" style="color:@pctColor">@item.DecayPercent%</span>
                                            <span class="dr-badge @sev">@(sev == "high" ? "Critical" : sev == "med" ? "Moderate" : "Low")</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- TWO COLUMN INFO -->
            <div class="dr-two-col">
                <div class="dr-panel">
                    <h3><span class="ico">⚠</span> Why pages decay</h3>
                    <ul class="dr-list">
                        <li>Outdated statistics and stale references lower trust signals</li>
                        <li>Competitors publish fresher, deeper content on the same topics</li>
                        <li>Search intent shifts — what users want changes over time</li>
                        <li>Weak internal linking cuts PageRank flow to affected URLs</li>
                        <li>Algorithm updates re-weight topical authority and E-E-A-T</li>
                    </ul>
                </div>
                <div class="dr-panel">
                    <h3><span class="ico">↑</span> Recovery actions</h3>
                    <ol class="dr-steps">
                        <li>Refresh outdated stats and add this year's data</li>
                        <li>Expand thin sections to match competitor depth</li>
                        <li>Fix internal linking from high-authority pages</li>
                        <li>Rewrite headings to match current search intent</li>
                        <li>Add FAQ blocks targeting related queries</li>
                        <li>Re-submit updated URLs via Google Search Console</li>
                    </ol>
                </div>
            </div>

            <!-- HOW IT WORKS -->
            <div class="dr-panel" style="margin-bottom:20px;">
                <h3><span class="ico">⚙</span> How this report is calculated</h3>
                <ol class="dr-steps">
                    <li>Connect securely to Google Search Console API with OAuth credentials</li>
                    <li>Fetch up to 16 months of page-level click data (50,000-row limit per query)</li>
                    <li>Group performance by URL and identify the peak traffic period per page</li>
                    <li>Compare peak clicks against the most recent 3-month average</li>
                    <li>Calculate decay percentage: <code style="font-family:var(--font-mono);font-size:12px;color:var(--accent);background:var(--surface2);padding:1px 6px;border-radius:4px">((peak − recent) / peak) × 100</code></li>
                    <li>Rank all pages by severity and compute an overall site-level decay score</li>
                </ol>
            </div>

            <!-- FAQ -->
            <div class="dr-section" style="margin-bottom:20px;">
                <div class="dr-section-header">
                    <span class="dr-section-title">FAQ</span>
                </div>
                <div style="padding: 8px 24px 24px;">
                    <div class="dr-faq">
                        <div class="dr-faq-item">
                            <div class="dr-faq-q">What causes content decay?</div>
                            <div class="dr-faq-a">Search engines continuously re-rank pages based on freshness, relevance, and competition. Pages that aren't updated lose ground to newer content targeting the same keywords.</div>
                        </div>
                        <div class="dr-faq-item">
                            <div class="dr-faq-q">How often should I run this audit?</div>
                            <div class="dr-faq-a">Every 2–3 months. Traffic loss accelerates the longer it goes unaddressed, and quarterly audits let you catch drops before they become critical.</div>
                        </div>
                        <div class="dr-faq-item">
                            <div class="dr-faq-q">Is updating old content really more effective than publishing new content?</div>
                            <div class="dr-faq-a">Often yes. Existing pages already have backlinks, indexing history, and authority. A well-executed refresh can recover rankings in weeks rather than the months it takes a new URL to gain traction.</div>
                        </div>
                        <div class="dr-faq-item">
                            <div class="dr-faq-q">Why use Search Console data instead of third-party tools?</div>
                            <div class="dr-faq-a">Search Console is sourced directly from Google — it shows actual impressions, clicks, and position with no sampling. Third-party tools estimate this data from keyword databases, which introduces significant inaccuracy at the page level.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CTA -->
            <div class="dr-cta">
                <div>
                    <h2>Don't wait for traffic to disappear.</h2>
                    <p>Content decay is silent and compounding. Identify and fix it before competitors claim those rankings permanently.</p>
