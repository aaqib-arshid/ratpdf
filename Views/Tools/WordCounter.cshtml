@{
    ViewData["Title"] = "Word Counter";
    ViewData["Description"] = "Count words, characters, sentences, paragraphs, reading/speaking time, keyword density, and Flesch-Kincaid reading level instantly.";
}
<head>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2855035251823717"
            crossorigin="anonymous"></script>
</head>
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@300;400;500&display=swap');

    :root {
        --ink: white;
        --paper: ghostwhite;
        --card: floralwhite;
        --border: #2e2b25;
        --amber: #e8a020;
        --amber-dim: #a06e10;
        --cream: #0d6efd;
        --muted: black;
        --stat-bg: #252320;
    }

    body {
        background: var(--ink);
        color: var(--cream);
    }

    /* ── Page wrapper ── */
    .wc-page {
        min-height: 100vh;
        padding: 60px 20px 80px;
        font-family: 'DM Sans', sans-serif;
        background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(232,160,32,.12) 0%, transparent 60%), var(--ink);
    }

    /* ── Header ── */
    .wc-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .wc-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.4rem, 5vw, 3.6rem);
            font-weight: 900;
            letter-spacing: -.02em;
            color: var(--cream);
            margin: 0 0 8px;
            line-height: 1.1;
        }

            .wc-header h1 span {
                color: var(--amber);
            }

        .wc-header p {
            font-size: .95rem;
            color: var(--muted);
            font-weight: 300;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

    /* ── Main card ── */
    .wc-card {
        max-width: 860px;
        margin: 0 auto;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 32px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(232,160,32,.06);
    }

    /* ── Textarea section ── */
    .wc-input-wrap {
        padding: 28px 28px 0;
        position: relative;
    }

    .wc-textarea {
        width: 100%;
        min-height: 200px;
        background: var(--paper);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--cream);
        font-family: 'DM Sans', sans-serif;
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.7;
        padding: 20px 22px;
        resize: vertical;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
        box-sizing: border-box;
    }

        .wc-textarea::placeholder {
            color: var(--muted);
        }

        .wc-textarea:focus {
            border-color: var(--amber-dim);
            box-shadow: 0 0 0 3px rgba(232,160,32,.08);
        }

    /* live word badge */
    .live-badge {
        position: absolute;
        top: 38px;
        right: 40px;
        background: rgba(232,160,32,.12);
        border: 1px solid rgba(232,160,32,.25);
        color: var(--amber);
        font-family: 'DM Mono', monospace;
        font-size: .72rem;
        letter-spacing: .08em;
        padding: 3px 10px;
        border-radius: 20px;
        pointer-events: none;
        opacity: 0;
        transition: opacity .3s;
    }

        .live-badge.visible {
            opacity: 1;
        }

    /* ── Divider ── */
    .wc-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border) 20%, var(--border) 80%, transparent);
        margin: 28px 0 0;
    }

    /* ── Stats grid ── */
    .wc-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
    }

    @@media(max-width: 600px) {
        .wc-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .stat-cell {
        background: var(--card);
        padding: 22px 20px 18px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        transition: background .2s;
    }

        .stat-cell:hover {
            background: var(--stat-bg);
        }

    .stat-label {
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .stat-value {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--cream);
        line-height: 1;
        transition: color .25s;
    }

        .stat-value.highlight {
            color: var(--amber);
        }

    /* Reading level gets full width */
    .stat-cell.wide {
        grid-column: span 3;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 18px 24px;
    }

    @@media(max-width:600px) {
        .stat-cell.wide {
            grid-column: span 2;
        }
    }

    .stat-cell.wide .stat-value {
        font-size: 1.3rem;
        color: var(--amber);
    }

    /* ── Keywords ── */
    .wc-keywords {
        padding: 20px 24px;
        border-top: 1px solid var(--border);
    }

    .kw-label {
        font-size: .68rem;
        font-weight: 500;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 10px;
    }

    .kw-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .kw-chip {
        background: rgba(232,160,32,.08);
        border: 1px solid rgba(232,160,32,.18);
        color: var(--cream);
        font-family: 'DM Mono', monospace;
        font-size: .8rem;
        padding: 5px 12px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        opacity: 0;
        transform: translateY(6px);
        animation: chipIn .3s forwards;
    }

        .kw-chip .kw-count {
            color: var(--amber);
            font-weight: 500;
        }

    @@keyframes chipIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ── Actions ── */
    .wc-actions {
        padding: 20px 24px 28px;
        border-top: 1px solid var(--border);
        display: flex;
        gap: 12px;
    }

    .btn-amber {
        background: var(--amber);
        color: var(--ink);
        border: none;
        font-family: 'DM Sans', sans-serif;
        font-weight: 500;
        font-size: .85rem;
        letter-spacing: .04em;
        padding: 10px 22px;
        border-radius: 8px;
        cursor: pointer;
        transition: background .2s, transform .1s;
    }

        .btn-amber:hover {
            background: #f0aa28;
        }

        .btn-amber:active {
            transform: scale(.97);
        }

    .btn-ghost {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
        font-family: 'DM Sans', sans-serif;
        font-weight: 400;
        font-size: .85rem;
        padding: 10px 22px;
        border-radius: 8px;
        cursor: pointer;
        transition: color .2s, border-color .2s;
    }

        .btn-ghost:hover {
            color: var(--cream);
            border-color: var(--muted);
        }

    /* ── Related tools ── */
    .wc-related {
        max-width: 860px;
        margin: 40px auto 0;
        padding: 0 4px;
    }

        .wc-related h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--muted);
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

    .related-links {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

        .related-links a {
            color: var(--muted);
            text-decoration: none;
            font-size: .82rem;
            letter-spacing: .03em;
            border: 1px solid var(--border);
            padding: 6px 14px;
            border-radius: 6px;
            transition: color .2s, border-color .2s;
        }

            .related-links a:hover {
                color: var(--amber);
                border-color: var(--amber-dim);
            }

    @@keyframes pop {
        0% {
            transform: scale(1);
        }

        40% {
            transform: scale(1.06);
        }

        100% {
            transform: scale(1);
        }
    }

    .stat-value.pop {
        animation: pop .25s ease;
    }
</style>

<div class="wc-page">

    <div class="wc-header">
        <h1>Word <span>Counter</span></h1>
        <p>Live text analysis &amp; readability stats</p>
    </div>

    <div class="wc-card">

        <div class="wc-input-wrap">
            <textarea id="inputText" class="wc-textarea" rows="8"
                      placeholder="Paste or type your text here…"></textarea>
            <span class="live-badge" id="liveBadge">● LIVE</span>
        </div>

        <div class="wc-divider"></div>

        <div class="wc-stats">
            <div class="stat-cell">
                <div class="stat-label">Words</div>
                <div class="stat-value" id="wordCount">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">Characters</div>
                <div class="stat-value" id="charCount">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">No Spaces</div>
                <div class="stat-value" id="charCountNoSpaces">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">Sentences</div>
                <div class="stat-value" id="sentenceCount">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">Paragraphs</div>
                <div class="stat-value" id="paragraphCount">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">FK Grade</div>
                <div class="stat-value" id="fkGrade">0</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">Reading Time</div>
                <div class="stat-value" id="readingTime" style="font-size:1.4rem;">—</div>
            </div>
            <div class="stat-cell">
                <div class="stat-label">Speaking Time</div>
                <div class="stat-value" id="speakingTime" style="font-size:1.4rem;">—</div>
            </div>
            <div class="stat-cell wide">
                <div class="stat-label">Reading Level</div>
                <div class="stat-value" id="readingLevel">—</div>
            </div>
        </div>

        <!-- Keywords -->
        <div class="wc-keywords">
            <div class="kw-label">Top Keywords</div>
            <div class="kw-chips" id="topKeywords">
                <span style="color:var(--muted);font-size:.85rem;font-style:italic;">
                    Start typing to see keywords…
                </span>
            </div>
        </div>

        <!-- Actions -->
        <div class="wc-actions">
            <button class="btn-amber" id="exportCSV">Export CSV</button>
            <button class="btn-ghost" id="clearText">Clear Text</button>
        </div>

    </div>

    <!-- Related tools -->
    <div class="wc-related">
        <h3>Related Tools</h3>
        <div class="related-links">
            <a href="/PDF/JwtDecoder">JWT Decoder</a>
            <a href="/PDF/HtmlFormatter">HTML Formatter</a>
            <a href="/PDF/ImgToBase64">Image to Base64</a>
        </div>
    </div>
    <div class="wc-related">
        <div class="card shadow-sm p-4" style="border-radius:12px;">
            <h2 class="fw-bold mb-3">How to Use the Word Counter</h2>
            <ol>
                <li>Paste or type any text into the box above. This can be an essay, blog post, article, social media post, or any content you want to analyze.</li>
                <li>The tool updates all statistics instantly as you type. You do not need to press submit or refresh; it provides live feedback for every word you enter.</li>
                <li>View detailed statistics including word count, character count (with and without spaces), sentence count, paragraph count, reading time, speaking time, top keywords, and Flesch-Kincaid reading grade level.</li>
                <li>Use the CSV export to download all statistics for reporting, editing, or SEO analysis. This allows you to track keyword usage, optimize content length, and monitor readability across multiple documents.</li>
            </ol>

