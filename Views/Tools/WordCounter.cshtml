@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        function formatTime(seconds) {
            if (!seconds || seconds === 0) return '—';
            if (seconds < 60) return seconds + ' sec';
            const m = Math.floor(seconds / 60);
            const s = seconds % 60;
            return s > 0 ? `${m} min ${s} sec` : `${m} min`;
        }

        function animateStat(el) {
            el.classList.remove('pop');
            void el.offsetWidth;
            el.classList.add('pop');
        }

        function setStat(id, value) {
            const el = document.getElementById(id);
            if (el && el.textContent !== String(value)) {
                el.textContent = value;
                animateStat(el);
            }
        }

        $(document).ready(function () {
            const badge = document.getElementById('liveBadge');

            const updateStats = () => {
                const text = $('#inputText').val();
                badge.classList.toggle('visible', text.length > 0);

                $.post('/Tools/GetWordStats', { text: text }, function (data) {
                    setStat('wordCount',         data.wordCount);
                    setStat('charCount',         data.characterCount);
                    setStat('charCountNoSpaces', data.characterCountNoSpaces);
                    setStat('sentenceCount',     data.sentenceCount);
                    setStat('paragraphCount',    data.paragraphCount);
                    setStat('fkGrade',           data.fleschKincaidGrade);

                    const rt = formatTime(data.readingTimeSeconds);
                    const st = formatTime(data.speakingTimeSeconds);
                    setStat('readingTime',  rt);
                    setStat('speakingTime', st);
                    setStat('readingLevel', data.readingLevel || '—');

                    // Keywords as chips
                    const kw = data.topKeywords;
                    const container = document.getElementById('topKeywords');
                    container.innerHTML = '';
                    if (kw && Object.keys(kw).length) {
                        Object.entries(kw).forEach(([word, count], i) => {
                            const chip = document.createElement('span');
                            chip.className = 'kw-chip';
                            chip.style.animationDelay = (i * 60) + 'ms';
                            chip.innerHTML = `${word} <span class="kw-count">×${count}</span>`;
                            container.appendChild(chip);
                        });
                    } else {
                        container.innerHTML = '<span style="color:var(--muted);font-size:.85rem;font-style:italic;">Start typing to see keywords…</span>';
                    }
                });
            };

            $('#inputText').on('input', updateStats);

            $('#clearText').click(() => {
                $('#inputText').val('');
                updateStats();
            });

            $('#exportCSV').click(() => {
                const rows = [
                    ['Metric', 'Value'],
                    ['Words',                    $('#wordCount').text()],
                    ['Characters',               $('#charCount').text()],
                    ['Characters (no spaces)',   $('#charCountNoSpaces').text()],
                    ['Sentences',                $('#sentenceCount').text()],
                    ['Paragraphs',               $('#paragraphCount').text()],
                    ['Reading Time',             $('#readingTime').text()],
                    ['Speaking Time',            $('#speakingTime').text()],
                    ['Flesch-Kincaid Grade',     $('#fkGrade').text()],
                    ['Reading Level',            $('#readingLevel').text()],
                    ['Top Keywords',             $('#topKeywords').text().trim()]
                ];
                const csv     = "data:text/csv;charset=utf-8," + rows.map(r => r.join(",")).join("\n");
                const link    = document.createElement("a");
                link.href     = encodeURI(csv);
                link.download = "word_stats.csv";
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        });
    </script>

