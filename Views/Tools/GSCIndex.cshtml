@* ── HERO ── *@
<section class="hero" aria-labelledby="hero-heading">
    <span class="hero__badge" aria-label="Tool category">Free SEO Tool</span>
    <h1 class="hero__title" id="hero-heading">
        Find Out Which Pages Are
        <span>Dying on Google</span><br />Before It's Too Late
    </h1>
    <p class="hero__subtitle">
        Paste your domain. Get a content decay score, a list of at-risk articles,
        and a one-click refresh checklist — in under 30 seconds. No signup needed.
    </p>
</section>

@* ── INPUT CARD ── *@
<main id="main-content">
    <div class="input-card" role="search" aria-label="Domain analysis form">
        <label class="input-label" for="loginInput">
            First Login to your google account which is associated with Google Search Console
        </label>
        <div class="input-row"><a href="/Tools/LoginGoogle">Connect Google Search Console</a></div>
        <label class="input-label" for="domainInput">
            Enter your domain or article URL
        </label>
        <form asp-action="Analyze" asp-controller="Tools" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="input-row">
                <input asp-for="Domain"
                       type="url"
                       placeholder="https://yourblog.com" />

                <button type="submit" class="btn-primary">
                    Analyze →
                </button>
            </div>

        </form>
        <p class="input-note" id="domain-hint">
            Requires read-only Google Search Console access. We never store your data.
        </p>
        <p class="field-error" id="domain-error" role="alert" aria-live="polite"></p>
    </div>
    @* ── LOADING STATE ── *@
    <div class="loading-state" id="loadingState" aria-live="polite" aria-label="Analysing your content">
        <div class="spinner" role="status" aria-hidden="true"></div>
        <p>Analysing your content decay&hellip;</p>
    </div>

    @* ── RESULTS SECTION — rendered by Results.cshtml partial ── *@
    <div id="resultsContainer" aria-live="polite"></div>
</main>

