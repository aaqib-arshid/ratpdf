@{
    ViewData["Title"] = "Strong Password Generator Online Free | Random Secure Password Tool";
    ViewData["Description"] = "Generate strong, random passwords instantly with our free Password Generator. Customizable length, symbols, numbers, and uppercase letters. Includes strength meter and copy to clipboard.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Head
{
    <meta name="description" content="Generate strong, random passwords instantly with our free Password Generator. Customizable length, symbols, numbers, and uppercase letters. Includes strength meter and copy to clipboard." />
    <meta name="keywords" content="strong password generator, random password generator, secure password tool, password creator, random password maker, strong password creator, password strength checker" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://ratpdf.com/password-generator" />
    <meta property="og:title" content="Strong Password Generator | Random Secure Password Tool" />
    <meta property="og:description" content="Create strong, hack-resistant passwords instantly. Custom length, symbols, numbers, and case. Free and client-side only." />
    <meta property="og:url" content="https://ratpdf.com/password-generator" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ratpdf.com/assets/password-preview.png" />

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "SoftwareApplication",
            "name": "Strong Password Generator",
            "applicationCategory": "SecurityApplication",
            "operatingSystem": "Web",
            "url": "https://ratpdf.com/password-generator",
            "offers": {
                "@@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            },
            "description": "Free tool to generate random, strong passwords with customizable length, symbols, numbers, and uppercase letters. Includes real-time strength meter.",
            "featureList": "Length slider, symbols toggle, numbers toggle, uppercase toggle, strength meter, copy to clipboard"
        }
    </script>

    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "FAQPage",
            "mainEntity": [
                {
                    "@@type": "Question",
                    "name": "How does the password generator work?",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "You select the length (8–50 characters) and which character sets to include (lowercase, uppercase, numbers, symbols). The tool then randomly picks characters from the chosen sets to create a secure password."
                    }
                },
                {
                    "@@type": "Question",
                    "name": "Is this password generator secure?",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "Yes. All password generation happens locally in your browser using JavaScript's crypto.getRandomValues() for true randomness. No data is sent over the internet."
                    }
                },
                {
                    "@@type": "Question",
                    "name": "What makes a password strong?",
                    "acceptedAnswer": {
                        "@@type": "Answer",
                        "text": "A strong password is long (at least 12 characters) and uses a mix of uppercase letters, lowercase letters, numbers, and symbols. Avoid common words or personal information."
                    }
                }
            ]
        }
    </script>

    <style>
        .strength-meter {
            height: 8px;
            border-radius: 8px;
            transition: width 0.2s ease, background-color 0.2s;
        }
        .strength-label {
            font-weight: 600;
            font-size: 0.85rem;
        }
        .password-display {
            font-family: 'SF Mono', 'Fira Code', monospace;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
            word-break: break-all;
        }
        .slider-value {
            font-weight: 600;
            background: #e9ecef;
            padding: 4px 12px;
            border-radius: 40px;
            display: inline-block;
        }
        .copy-btn:active {
            transform: scale(0.96);
        }
    </style>
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🔐 Strong Password Generator</h1>
        <p class="lead text-muted">
            Create secure, random passwords instantly — <strong>free, client‑side, and privacy‑focused</strong>.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">🔢 Length 8–50</span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">✨ Symbols included</span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">📊 Strength meter</span>
            <span class="badge bg-info bg-opacity-10 text-dark px-3 py-2 rounded-pill">📋 Copy to clipboard</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">🔑 Generated Password</label>
                        <div class="input-group">
                            <input type="text" id="passwordField" class="form-control form-control-lg password-display bg-light" readonly value="Click Generate" />
                            <button id="copyBtn" class="btn btn-outline-secondary copy-btn" type="button" title="Copy to clipboard">📋 Copy</button>
                        </div>
                        <div id="copyFeedback" class="form-text mt-1 text-success" style="display:none;">Copied!</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold d-flex justify-content-between">
                            <span>📏 Password Length</span>
                            <span class="slider-value" id="lengthValue">12</span>
                        </label>
                        <input type="range" id="lengthSlider" class="form-range" min="6" max="50" value="12" step="1" />
                        <div class="d-flex justify-content-between text-muted small">
                            <span>6 (weak)</span>
                            <span>12+ (strong)</span>
                            <span>50 (very strong)</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">🔧 Character Sets</label>
                        <div class="d-flex flex-wrap gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeLowercase" checked disabled>
                                <label class="form-check-label" for="includeLowercase">Lowercase (a-z)</label>
                                <small class="text-muted ms-1">(always on)</small>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeUppercase" checked>
                                <label class="form-check-label" for="includeUppercase">Uppercase (A-Z)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeNumbers" checked>
                                <label class="form-check-label" for="includeNumbers">Numbers (0-9)</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="includeSymbols" checked>
                                <label class="form-check-label" for="includeSymbols">Symbols (@Html.Raw("!@#$%^&*..."))</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">💪 Password Strength</label>
                        <div class="strength-meter w-100" id="strengthBar" style="background-color: #e9ecef; height: 8px; border-radius: 8px;">
                            <div id="strengthFill" class="strength-meter" style="width: 0%; background-color: #dc3545;"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-2">
                            <span class="strength-label" id="strengthText">Weak</span>
                            <span class="strength-label text-muted">More length & variety = stronger</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button id="generateBtn" class="btn btn-primary btn-lg rounded-pill shadow-sm">✨ Generate Strong Password</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="container py-5">
    <div class="row g-5">
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">🛡️ Why You Need a Strong Password</h2>
            <p>Weak passwords are the #1 cause of account breaches. Hackers use dictionary attacks, brute force, and credential stuffing to break simple passwords. Our <strong>random password generator</strong> creates high‑entropy passwords that are nearly impossible to crack.</p>
            <p>All generation happens locally using <code>crypto.getRandomValues()</code> – cryptographically secure randomness. No passwords are ever stored or transmitted.</p>
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">⚙️ How to Use This Tool</h2>
            <ul>
                <li><strong>Adjust length</strong> – drag the slider (longer = stronger).</li>
                <li><strong>Choose character sets</strong> – symbols, numbers, uppercase, lowercase (lowercase is mandatory).</li>
                <li><strong>Click "Generate"</strong> – a new random password appears.</li>
                <li><strong>Copy</strong> – use the copy button to save it to your clipboard.</li>
                <li><strong>Strength meter</strong> – updates in real time based on length and character variety.</li>
            </ul>
        </div>
    </div>

    <h2 class="fw-bold mt-5 mb-3">📊 Password Strength Guide</h2>
    <div class="table-responsive">
        <table class="table table-bordered">
            <thead class="table-light">
                <tr><th>Strength</th><th>Criteria</th><th>Example</th></tr>
            </thead>
            <tbody>
                <tr><td class="text-danger">Weak</td><td>Less than 8 characters or only lowercase</td><td>password123</td></tr>
                <tr><td class="text-warning">Medium</td><td>8–11 chars with 2 character sets</td><td>SunnyDay99</td></tr>
                <tr><td class="text-success">Strong</td><td>12+ chars with 3 character sets</td><td>Tr0ub4dor&Horse</td></tr>
                <tr><td class="text-success fw-bold">Very Strong</td><td>16+ chars with all 4 sets (lower, upper, numbers, symbols)</td><td>7x#kL9$mQp!2zR&</td></tr>
            </tbody>
        </table>
    </div>

    <h2 class="fw-bold mt-5 mb-3">🔒 Tips for Secure Password Management</h2>
    <div class="alert alert-secondary border-0 rounded-4">
        <ul class="mb-0">
            <li>Use a <strong>unique password</strong> for every account.</li>
            <li>Enable <strong>Two-Factor Authentication (2FA)</strong> wherever possible.</li>
            <li>Use a <strong>password manager</strong> (e.g., Bitwarden, 1Password, KeePass) to store complex passwords.</li>
            <li>Aim for <strong>at least 12 characters</strong> – length trumps complexity.</li>
            <li>Never share passwords via email or text.</li>
        </ul>
    </div>

    <h2 class="fw-bold mt-5 mb-4">❓ Frequently Asked Questions</h2>
    <div class="accordion" id="faqAccordion">
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq1">Is the generated password truly random?</button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                <div class="accordion-body">Yes. The generator uses the Web Cryptography API (<code>crypto.getRandomValues()</code>), which provides cryptographically strong random numbers – the same standard used for secure tokens and encryption keys.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm mb-3 rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq2">Are symbols like @Html.Raw("@#$%") included? Which ones?</button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">Yes. The symbol set includes: <code>'@Html.Raw("!@#$%^&*()_+-=[]{}|;:,.<>?/~")';</code> (32 common symbols). You can toggle them on/off.</div>
            </div>
        </div>
        <div class="accordion-item border-0 shadow-sm rounded-3">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed rounded-3 bg-light fw-semibold" data-bs-toggle="collapse" data-bs-target="#faq3">Can I adjust the password length beyond 50?</button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                <div class="accordion-body">50 characters is already extremely secure (2^300+ possibilities). For most uses, 16-20 characters with all character sets is more than enough. The slider is capped at 50 for performance and usability.</div>
            </div>
        </div>
    </div>

    <h2 class="fw-bold mt-5 mb-4">🔧 Related Tools</h2>
    <div class="row g-3 mb-5">
        <div class="col-md-3 col-6"><a href="/binary-to-decimal" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🔢 Binary to Decimal</div></a></div>
        <div class="col-md-3 col-6"><a href="/qr-code-generator" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">📱 QR Code Generator</div></a></div>
        <div class="col-md-3 col-6"><a href="/PDF/JsonFormatter" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">{ } JSON Formatter</div></a></div>
        <div class="col-md-3 col-6"><a href="/Tools/WhatIsMyIP" class="text-decoration-none"><div class="card border-0 shadow-sm text-center p-3 h-100">🌍 What Is My IP</div></a></div>
    </div>
</section>

@section Scripts
{
    <script>
        (function() {
            const passwordField = document.getElementById('passwordField');
            const lengthSlider = document.getElementById('lengthSlider');
            const lengthValue = document.getElementById('lengthValue');
            const includeUppercase = document.getElementById('includeUppercase');
            const includeNumbers = document.getElementById('includeNumbers');
            const includeSymbols = document.getElementById('includeSymbols');
            const generateBtn = document.getElementById('generateBtn');
            const copyBtn = document.getElementById('copyBtn');
            const copyFeedback = document.getElementById('copyFeedback');
            const strengthFill = document.getElementById('strengthFill');
            const strengthText = document.getElementById('strengthText');

            const lowercaseSet = 'abcdefghijklmnopqrstuvwxyz';
            const uppercaseSet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const numberSet = '0123456789';
            const symbolSet = '@Html.Raw("!@#$%^&*()_+-=[]{}|;:,.<>?/~")';

            function getRandomInt(max) {
                const randomBuffer = new Uint32Array(1);
                crypto.getRandomValues(randomBuffer);
                return randomBuffer[0] % max;
            }

            function generatePassword() {
                let length = parseInt(lengthSlider.value, 10);
                if (isNaN(length)) length = 12;
                
                let charset = lowercaseSet; 
                if (includeUppercase.checked) charset += uppercaseSet;
                if (includeNumbers.checked) charset += numberSet;
                if (includeSymbols.checked) charset += symbolSet;
                
                if (charset.length === 0) {
                    charset = lowercaseSet;
                }
                
                let password = '';
                for (let i = 0; i < length; i++) {
                    const randomIndex = getRandomInt(charset.length);
                    password += charset[randomIndex];
                }
                
                let requiredSets = [lowercaseSet];
                if (includeUppercase.checked) requiredSets.push(uppercaseSet);
                if (includeNumbers.checked) requiredSets.push(numberSet);
                if (includeSymbols.checked) requiredSets.push(symbolSet);
                
                for (let set of requiredSets) {
                    let hasChar = false;
                    for (let ch of password) {
                        if (set.includes(ch)) { hasChar = true; break; }
                    }
                    if (!hasChar && set.length > 0) {
                        const randomPos = getRandomInt(password.length);
                        const randomChar = set[getRandomInt(set.length)];
                        password = password.substring(0, randomPos) + randomChar + password.substring(randomPos + 1);
                    }
                }
                
                return password;
            }
            
            function updateStrengthMeter(password, length, hasUpper, hasNumbers, hasSymbols) {
                let setsCount = 1; 
                if (hasUpper) setsCount++;
                if (hasNumbers) setsCount++;
                if (hasSymbols) setsCount++;
                
                let score = 0;

                if (length >= 8) score += 20;
                if (length >= 12) score += 20;
                if (length >= 16) score += 20;

                score += (setsCount - 1) * 13; 
                
                let percent = Math.min(100, score);
                let color = '#dc3545'; // red
                let label = 'Weak';
                if (percent >= 40 && percent < 65) { color = '#ffc107'; label = 'Medium'; }
                else if (percent >= 65 && percent < 85) { color = '#0d6efd'; label = 'Good'; }
                else if (percent >= 85) { color = '#198754'; label = 'Very Strong'; }
                
                strengthFill.style.width = percent + '%';
                strengthFill.style.backgroundColor = color;
                strengthText.textContent = label;
                strengthText.style.color = color;
            }
            
            function refreshPassword() {
                const length = parseInt(lengthSlider.value, 10);
                const hasUpper = includeUppercase.checked;
                const hasNumbers = includeNumbers.checked;
                const hasSymbols = includeSymbols.checked;
                
                const newPassword = generatePassword();
                passwordField.value = newPassword;
                
                updateStrengthMeter(newPassword, length, hasUpper, hasNumbers, hasSymbols);
            }
            
            function updateLengthDisplay() {
                const val = lengthSlider.value;
                lengthValue.textContent = val;
                refreshPassword();
            }
            
            function copyToClipboard() {
                if (!passwordField.value || passwordField.value === 'Click Generate') {
                    copyFeedback.textContent = 'Generate a password first!';
                    copyFeedback.style.color = '#dc3545';
                    copyFeedback.style.display = 'block';
                    setTimeout(() => { copyFeedback.style.display = 'none'; copyFeedback.style.color = '#198754'; copyFeedback.textContent = 'Copied!'; }, 2000);
                    return;
                }
                navigator.clipboard.writeText(passwordField.value).then(() => {
                    copyFeedback.textContent = 'Copied!';
                    copyFeedback.style.color = '#198754';
                    copyFeedback.style.display = 'block';
                    setTimeout(() => { copyFeedback.style.display = 'none'; }, 2000);
                }).catch(() => {
                    copyFeedback.textContent = 'Failed to copy';
                    copyFeedback.style.color = '#dc3545';
                    copyFeedback.style.display = 'block';
                    setTimeout(() => { copyFeedback.style.display = 'none'; }, 2000);
                });
            }
            
            lengthSlider.addEventListener('input', updateLengthDisplay);
            includeUppercase.addEventListener('change', refreshPassword);
            includeNumbers.addEventListener('change', refreshPassword);
            includeSymbols.addEventListener('change', refreshPassword);
            generateBtn.addEventListener('click', refreshPassword);
            copyBtn.addEventListener('click', copyToClipboard);
            
            refreshPassword();
        })();
    </script>
}