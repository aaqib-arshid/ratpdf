@{
    ViewData["Title"] = "Bulk Image Compressor Online Free | Compress Multiple Images at Once";
    ViewData["Description"] = "Compress multiple images (JPG, PNG, WebP) in bulk. 100% browser-based – no upload, no server. Preserves original resolution. Download all as ZIP.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="bulk image compressor, compress multiple images, batch image compression, reduce image size bulk, zip images, browser image compressor" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/bulk-image-compressor" />
    <meta property="og:title" content="Bulk Image Compressor – Compress Many Images at Once" />
    <meta property="og:description" content="Compress and download multiple images as a ZIP file. All processing is local – your privacy is guaranteed." />
    <meta property="og:url" content="https://ratpdf.com/bulk-image-compressor" />
    <meta property="og:type" content="website" />

    <style>
        .drop-zone {
            border: 2px dashed #ccc;
            border-radius: 20px;
            background: #f8f9fa;
            cursor: pointer;
            transition: all 0.2s;
        }
        .drop-zone.drag-over {
            border-color: #0d6efd;
            background-color: #e7f5ff;
        }
        .image-card {
            transition: transform 0.2s;
        }
        .image-card:hover {
            transform: translateY(-3px);
        }
        .progress-bar-custom {
            transition: width 0.3s ease;
        }
        .result-img {
            max-width: 80px;
            max-height: 80px;
            object-fit: cover;
            border-radius: 8px;
        }
    </style>
</head>
<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">🗜️ Bulk Image Compressor</h1>
        <p class="lead text-muted">
            Compress multiple images at once – <strong>JPG, PNG, WebP, BMP</strong><br />
            All processing stays in your browser. Download as ZIP.
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill">📦 Bulk upload</span>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">🔒 No server</span>
            <span class="badge bg-warning bg-opacity-10 text-dark px-3 py-2 rounded-pill">📐 Resolution preserved</span>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <!-- File upload zone -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">📂 Select Images (multiple allowed)</label>
                        <div id="dropZone" class="drop-zone p-5 text-center">
                            <i class="bi bi-cloud-upload fs-1 text-primary"></i>
                            <p class="mt-2 mb-0">Drag & drop or click to select</p>
                            <small class="text-muted">Supports JPG, PNG, WebP, BMP (max 50 files)</small>
                            <input type="file" id="fileInput" class="d-none" accept="image/jpeg,image/png,image/webp,image/bmp" multiple />
                        </div>
                        <div id="fileCount" class="form-text mt-2"></div>
                    </div>

                    <!-- Compression settings -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">🎨 Output Format</label>
                            <select id="outputFormat" class="form-select rounded-pill">
                                <option value="image/jpeg">JPEG (lossy, small size)</option>
                                <option value="image/png" selected>PNG (lossless, transparency)</option>
                                <option value="image/webp">WebP (modern, good compression)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold" id="qualityLabel">📊 JPEG/WebP Quality (%)</label>
                            <input type="range" id="qualitySlider" class="form-range" min="1" max="100" value="85">
                            <div class="d-flex justify-content-between">
                                <span>Smaller file</span>
                                <span>Better quality</span>
                            </div>
                            <div id="qualityValue" class="form-text text-end">85%</div>
                        </div>
                    </div>

                    <!-- Action buttons -->
                    <div class="d-flex flex-wrap gap-3 justify-content-center mb-4">
                        <button id="compressBtn" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm" disabled>⚡ Compress All Images</button>
                        <button id="downloadZipBtn" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm" disabled>📦 Download ZIP</button>
                        <button id="clearBtn" class="btn btn-outline-secondary rounded-pill px-4">🗑️ Clear All</button>
                    </div>

                    <!-- Progress bar -->
                    <div id="progressArea" class="mb-4 d-none">
                        <div class="d-flex justify-content-between mb-1">
                            <span id="progressStatus">Processing images...</span>
                            <span id="progressPercent">0%</span>
                        </div>
                        <div class="progress" style="height: 10px; border-radius: 10px;">
                            <div id="progressBar" class="progress-bar progress-bar-custom bg-success" style="width: 0%;"></div>
                        </div>
                    </div>

                    <!-- Image list -->
                    <div id="imageList" class="row g-3 mt-2">
                        <div class="col-12 text-muted text-center">No images selected</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Educational & SEO Section -->
