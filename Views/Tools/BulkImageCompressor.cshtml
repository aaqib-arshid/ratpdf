    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

    <script>
        (function() {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('fileInput');
            const fileCountDiv = document.getElementById('fileCount');
            const outputFormatSelect = document.getElementById('outputFormat');
            const qualitySlider = document.getElementById('qualitySlider');
            const qualityValue = document.getElementById('qualityValue');
            const qualityLabel = document.getElementById('qualityLabel');
            const compressBtn = document.getElementById('compressBtn');
            const downloadZipBtn = document.getElementById('downloadZipBtn');
            const clearBtn = document.getElementById('clearBtn');
            const progressArea = document.getElementById('progressArea');
            const progressBar = document.getElementById('progressBar');
            const progressStatus = document.getElementById('progressStatus');
            const progressPercent = document.getElementById('progressPercent');
            const imageListDiv = document.getElementById('imageList');
            
            let selectedFiles = [];
            let compressedResults = []; 
            let processing = false;
            
            function updateFileCount() {
                fileCountDiv.innerText = selectedFiles.length ? `${selectedFiles.length} image(s) selected` : '';
            }
            
            function renderImageList() {
                if (selectedFiles.length === 0) {
                    imageListDiv.innerHTML = '<div class="col-12 text-muted text-center">No images selected</div>';
                    return;
                }
                let html = '';
                selectedFiles.forEach((file, idx) => {
                    const result = compressedResults.find(r => r.originalName === file.name);
                    const sizeReduction = result ? ((1 - result.compressedSize / result.originalSize) * 100).toFixed(1) : 0;
                    html += `
                        <div class="col-md-6 col-lg-4">
                            <div class="card image-card h-100">
                                <div class="card-body text-center">
                                    <img id="preview_${idx}" class="result-img mb-2" style="max-width:100px; max-height:100px;">
                                    <div class="small text-truncate">${file.name}</div>
                                    <div class="small text-muted">${(file.size / 1024).toFixed(1)} KB</div>
                                    ${result ? `<div class="small text-success">→ ${(result.compressedSize / 1024).toFixed(1)} KB (${sizeReduction}% less)</div>` : '<div class="small text-secondary">Not compressed yet</div>'}
                                </div>
                            </div>
                        </div>
                    `;
                });
                imageListDiv.innerHTML = html;

                selectedFiles.forEach((file, idx) => {
                    const img = document.getElementById(`preview_${idx}`);
                    if (img) {
                        const url = URL.createObjectURL(file);
                        img.src = url;
                        img.onload = () => URL.revokeObjectURL(url);
                    }
                });
            }
            
            async function compressImage(file, outputMime, quality) {
                return new Promise((resolve, reject) => {
                    const img = new Image();
                    const url = URL.createObjectURL(file);
                    img.onload = () => {
                        URL.revokeObjectURL(url);
                        const canvas = document.createElement('canvas');
                        canvas.width = img.width;
                        canvas.height = img.height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0);
                        canvas.toBlob(blob => {
                            resolve({
                                originalName: file.name,
                                blob: blob,
                                originalSize: file.size,
                                compressedSize: blob.size,
                                width: img.width,
                                height: img.height,
                                format: outputMime
                            });
                        }, outputMime, quality);
                    };
                    img.onerror = reject;
                    img.src = url;
                });
            }
            
            async function compressAll() {
                if (selectedFiles.length === 0) {
                    alert('Please select images first.');
                    return;
                }
                if (processing) return;
                processing = true;
                compressBtn.disabled = true;
                downloadZipBtn.disabled = true;
                progressArea.classList.remove('d-none');
                const outputMime = outputFormatSelect.value;
                const quality = parseInt(qualitySlider.value) / 100;
                compressedResults = [];
                let completed = 0;
                const total = selectedFiles.length;
                
                for (let i = 0; i < selectedFiles.length; i++) {
                    const file = selectedFiles[i];
                    try {
                        const result = await compressImage(file, outputMime, quality);
                        compressedResults.push(result);
                        completed++;
                        const percent = (completed / total) * 100;
                        progressBar.style.width = percent + '%';
                        progressPercent.innerText = Math.round(percent) + '%';
                        progressStatus.innerText = `Compressed ${completed} of ${total} images`;
                        renderImageList();
                    } catch (err) {
                        console.error(`Error compressing ${file.name}:`, err);
                        progressStatus.innerText = `Error on ${file.name}`;
                    }
                }
                progressBar.style.width = '100%';
                progressStatus.innerText = 'Compression complete!';
                setTimeout(() => {
                    progressArea.classList.add('d-none');
                }, 1500);
                downloadZipBtn.disabled = false;
                compressBtn.disabled = false;
                processing = false;
            }
            
            function downloadZip() {
                if (compressedResults.length === 0) {
                    alert('No compressed images. Please compress first.');
                    return;
                }
                const zip = new JSZip();
                for (let res of compressedResults) {
                    let ext = res.format.split('/')[1].replace('jpeg', 'jpg');
                    let name = res.originalName.replace(/\.[^/.]+$/, '') + '.' + ext;
                    zip.file(name, res.blob);
                }
                zip.generateAsync({ type: 'blob' }).then(blob => {
                    saveAs(blob, `compressed_images_${Date.now()}.zip`);
                });
            }
            
            function clearAll() {
                selectedFiles = [];
                compressedResults = [];
                fileInput.value = '';
                renderImageList();
                updateFileCount();
                compressBtn.disabled = true;
                downloadZipBtn.disabled = true;
            }
            
            function handleFiles(files) {
                const imageFiles = Array.from(files).filter(f => f.type.startsWith('image/'));
                if (imageFiles.length === 0) return;
                selectedFiles = imageFiles;
                compressedResults = [];
                updateFileCount();
                renderImageList();
                compressBtn.disabled = false;
                downloadZipBtn.disabled = true;
            }
            
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('drag-over');
                const files = e.dataTransfer.files;
                if (files.length) handleFiles(files);
            });
            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length) handleFiles(e.target.files);
            });
            compressBtn.addEventListener('click', compressAll);
            downloadZipBtn.addEventListener('click', downloadZip);
            clearBtn.addEventListener('click', clearAll);
            
            outputFormatSelect.addEventListener('change', () => {
                const isLossy = outputFormatSelect.value === 'image/jpeg' || outputFormatSelect.value === 'image/webp';
                qualitySlider.disabled = !isLossy;
                qualityLabel.innerText = isLossy ? `📊 ${outputFormatSelect.value.split('/')[1].toUpperCase()} Quality (%)` : 'Quality (not applicable for PNG)';
                if (selectedFiles.length) compressBtn.disabled = false;
            });
            qualitySlider.addEventListener('input', () => {
                qualityValue.innerText = qualitySlider.value + '%';
            });
        })();
    </script>