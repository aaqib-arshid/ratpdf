@section Scripts
{
    <script>

        function decimalToBinary(decimal)
        {
        decimal = parseInt(decimal);

        if (isNaN(decimal))
        {
        return "";
        }

        return decimal.toString(2);
        }

        function updateConverter()
        {
        let decimal =
        $("#decimalInput").val().trim();

        if(decimal === "")
        {
        $("#binaryOutput").text("0");
        $("#binaryPreview").text("0");
        $("#decimalPreview").text("0");
        $("#bitCount").text("1");
        return;
        }

        let binary =
        decimalToBinary(decimal);

        $("#binaryOutput")
        .text(binary);

        $("#binaryPreview")
        .text(binary);

        $("#decimalPreview")
        .text(decimal);

        $("#bitCount")
        .text(binary.length);
        }

        $("#decimalInput")
        .on("keyup change", function ()
        {
        updateConverter();
        });

        updateConverter();

    </script>
}