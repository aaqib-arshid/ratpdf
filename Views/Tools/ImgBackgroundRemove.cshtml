<script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const filePreview = document.getElementById('filePreview');

    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.classList.add('bg-light');
    });

    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        fileInput.files = e.dataTransfer.files;
        filePreview.innerText = fileInput.files[0].name;
    });

    fileInput.addEventListener('change', () => {
        filePreview.innerText = fileInput.files[0].name;
    });
    
   $('#removeImgBgForm').on('submit', function (e) {
    e.preventDefault();

    showLoader('Uploading image...');

    var formData = new FormData(this);

    $.ajax({
        url: '/Tools/RemoveImgBackground',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,

        success: function (res) {
            if (res.paymentRequired) {

            showPaymentPopup();

            return;
        }
            if (!res.jobId) {
                hideLoader();
                showToast(res.message || "Something went wrong");
                return;
            }

            showToast(res.message || "Processing started");

            showLoader('Removing background...');

            pollJob(res.jobId);
        },

        error: function () {
            hideLoader();
            showToast("Server error. Please try again.");
        }
    });
});
function pollJob(jobId) {

    let interval = setInterval(function () {

        $.get('/Tools/GetJobStatus?jobId=' + jobId, function (res) {

            if (res.status === "completed") {

                clearInterval(interval);

                hideLoader();

                window.location.href = res.url; 
            }
        });

    }, 2000);
}
function showToast(message) {
    const toast = document.createElement('div');
    toast.innerText = message;
    toast.style.position = 'fixed';
    toast.style.bottom = '20px';
    toast.style.right = '20px';
    toast.style.background = '#333';
    toast.style.color = '#fff';
    toast.style.padding = '10px 15px';
    toast.style.borderRadius = '8px';
    toast.style.zIndex = '9999';

    document.body.appendChild(toast);

    setTimeout(() => toast.remove(), 5000);
}
function showPaymentPopup() {

    let html = `
    
    <div id="paymentModal"
         style="position:fixed;
         top:0;
         left:0;
         width:100%;
         height:100%;
         background:rgba(0,0,0,.5);
         z-index:99999;
         display:flex;
         align-items:center;
         justify-content:center;">

         <div style="background:#fff;
         padding:30px;
         border-radius:10px;
         width:350px;
         text-align:center;">

            <h3>Upgrade Plan</h3>

            <button onclick="buyPlan('daily')"
                    class="btn btn-primary w-100 mb-2">
                ₹29 Unlimited 24 Hours
            </button>

            <button onclick="buyPlan('monthly')"
                    class="btn btn-dark w-100">
                ₹199 Monthly Unlimited
            </button>

         </div>

    </div>
    `;

    $('body').append(html);
}
async function buyPlan(plan) {

    const response = await fetch('/Tools/CreateImgBgOrder', {

        method: 'POST',

        headers: {
            'Content-Type':
                'application/x-www-form-urlencoded'
        },

        body: `plan=${plan}`
    });

    const order = await response.json();

    const options = {

        key: order.key,

        amount: order.amount * 100,

        currency: 'INR',

        name: 'RatPDF',

        description: 'AI Background Remover',

        order_id: order.orderId,

        handler: async function (response) {

            const verify = await fetch(
                '/Tools/VerifyImgBgPayment',
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/x-www-form-urlencoded'
                },

                body:
                    `razorpay_payment_id=${response.razorpay_payment_id}`
                    + `&razorpay_order_id=${response.razorpay_order_id}`
                    + `&razorpay_signature=${response.razorpay_signature}`
                    + `&plan=${plan}`
            });

            const result = await verify.json();

            if (result.success) {

                alert('Payment successful');

                $('#paymentModal').remove();
            }
        }
    };

    const rzp = new Razorpay(options);

    rzp.open();
}
</script>
}