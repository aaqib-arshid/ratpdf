    <script type="module" src="~/js/bgremover.js"></script>
     <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const filePreview = document.getElementById('filePreview');
        const originalPreview = document.getElementById('originalPreview');
        const originalPlaceholder = document.getElementById('originalPlaceholder');
        const resultPreview = document.getElementById('resultPreview');
        const resultPlaceholder = document.getElementById('resultPlaceholder');
        const removeBtn = document.getElementById('removeBgBtn');
        const downloadBtn = document.getElementById('downloadBtn');
        const progressArea = document.getElementById('progressArea');
        const progressBar = document.getElementById('progressBar');
        const progressStatus = document.getElementById('progressStatus');
        const progressPercent = document.getElementById('progressPercent');
        const statusMsg = document.getElementById('statusMsg');

        let currentOriginalBlob = null;
        let currentResultBlob = null;
        let originalDimensions = { width: 0, height: 0 };

        function showMessage(text, isError = false) {
            statusMsg.textContent = text;
            statusMsg.className = `alert ${isError ? 'alert-danger' : 'alert-info'} mt-3`;
            statusMsg.classList.remove('d-none');
            setTimeout(() => {
                statusMsg.classList.add('d-none');
            }, 5000);
        }

        function updateProgress(percent, text) {
            progressBar.style.width = percent + '%';
            progressPercent.textContent = Math.round(percent) + '%';
            progressStatus.textContent = text;
        }

        // Helper to get image dimensions
        function getImageDimensions(blob) {
            return new Promise((resolve) => {
                const url = URL.createObjectURL(blob);
                const img = new Image();
                img.onload = () => {
                    URL.revokeObjectURL(url);
                    resolve({ width: img.width, height: img.height });
                };
                img.src = url;
            });
        }

        // Handle file selection
        async function handleFile(file) {
            if (!file) return;
            const url = URL.createObjectURL(file);
            originalPreview.src = url;
            originalPreview.style.display = 'block';
            originalPlaceholder.style.display = 'none';
            currentOriginalBlob = file;
            currentResultBlob = null;
            resultPreview.style.display = 'none';
            resultPlaceholder.style.display = 'block';
            resultPreview.src = '';
            removeBtn.disabled = false;
            downloadBtn.disabled = true;
            filePreview.innerText = file.name;

            // Get original dimensions
            const dims = await getImageDimensions(file);
            originalDimensions = dims;
            console.log(`Original dimensions: ${dims.width}x${dims.height}`);
        }

        // Drag & drop handlers
        dropZone.addEventListener('click', () => fileInput.click());

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('drag-over');
        });
        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('drag-over');
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-over');
            const file = e.dataTransfer.files[0];
            if (file) {
                fileInput.files = e.dataTransfer.files;
                handleFile(file);
            }
        });

        fileInput.addEventListener('change', () => {
            if (fileInput.files.length > 0) {
                handleFile(fileInput.files[0]);
            }
        });

        // Background removal
        removeBtn.addEventListener('click', async () => {
            if (!currentOriginalBlob) {
                showMessage('Please select an image first.', true);
                return;
            }

            removeBtn.disabled = true;
            downloadBtn.disabled = true;
            progressArea.classList.remove('d-none');
            updateProgress(0, 'Loading AI model...');

            try {
                updateProgress(5, 'Initializing background removal...');
                const resultBlob = await removeBackground(currentOriginalBlob, {
                    progress: (key, progress, total) => {
                        const percent = 5 + (progress / total) * 90;

                        const messages = {
                            fetch: "Downloading AI model...",
                            downloadModel: "Preparing AI engine...",
                            loadModel: "Loading model...",
                            inference: "Removing background...",
                            segment: "Processing image..."
                        };

                        const text = messages[key] || "Processing image...";

                        updateProgress(percent, text);
                    }
                });

                currentResultBlob = resultBlob;
                const resultUrl = URL.createObjectURL(resultBlob);
                resultPreview.src = resultUrl;
                resultPreview.style.display = 'block';
                resultPlaceholder.style.display = 'none';
                downloadBtn.disabled = false;
                updateProgress(100, 'Complete!');
                showMessage(`✅ Background removed! Output size: ${originalDimensions.width}×${originalDimensions.height} (same as original).`);

                resultPreview.onload = () => URL.revokeObjectURL(resultUrl);
                setTimeout(() => {
                    progressArea.classList.add('d-none');
                }, 1500);
            } catch (err) {
                console.error(err);
                showMessage('Error removing background: ' + (err.message || 'Unknown error'), true);
                progressArea.classList.add('d-none');
            } finally {
                removeBtn.disabled = false;
            }
        });

        // Download result
        downloadBtn.addEventListener('click', () => {
            if (!currentResultBlob) {
                showMessage('No result to download. Please remove background first.', true);
                return;
            }
            const url = URL.createObjectURL(currentResultBlob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `transparent_${originalDimensions.width}x${originalDimensions.height}.png`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showMessage(`PNG downloaded (${originalDimensions.width}×${originalDimensions.height}) — resolution preserved!`);
        });
    </script>
}