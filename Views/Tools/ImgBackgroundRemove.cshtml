@model RemoveImgBgModel

@{
    ViewData["Title"] = "Remove Background While Keeping Same Resolution | Free AI Tool";
    ViewData["Description"] = "Remove background from any image while preserving the exact original resolution. Browser-based, private, no upload. Download transparent PNG instantly.";
}

@section Head {
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="background remover keep resolution, remove background same resolution, no resolution loss, transparent PNG original size, AI background remover online, browser-based background remover" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/Tools/RemoveImgBackground" />
    <meta property="og:title" content="Remove Background While Keeping Same Resolution | AI Background Remover" />
    <meta property="og:description" content="Remove background from any image while preserving original resolution. 100% browser-based – your images never leave your device." />
    <meta property="og:url" content="https://ratpdf.com/Tools/RemoveImgBackground" />
    <meta property="og:type" content="website" />

    <style>
        .image-preview {
            max-width: 100%;
            max-height: 300px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            background: repeating-conic-gradient(#f0f0f0 0% 25%, #ffffff 0% 50%) 50% / 20px 20px;
        }
        .result-area {
            background: repeating-conic-gradient(#ddd 0% 25%, #f5f5f5 0% 50%) 50% / 20px 20px;
            border-radius: 16px;
            padding: 1rem;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 200px;
        }
        .progress-bar-custom {
            transition: width 0.3s ease;
        }
        .resolution-note {
            background: #e7f5ff;
            border-left: 4px solid #0d6efd;
            padding: 0.75rem 1rem;
            border-radius: 12px;
            font-size: 0.9rem;
        }
        #dropZone {
            border: 2px dashed #ccc;
            transition: all 0.2s;
        }
        #dropZone.drag-over {
            border-color: #0d6efd;
            background-color: #e7f5ff;
        }
    </style>
}

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 800px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" height="60" class="mb-3" alt="RatPDF Logo" />
            <h2 class="fw-bold mb-3">AI Background Remover – Keep Same Resolution</h2>
            <p class="text-muted mb-4">
                Upload a JPG or PNG image and remove background instantly with AI.<br />
                <strong>Output PNG has the exact same width & height as your original image.</strong>
            </p>

            <!-- File Upload Area -->
            <div class="mb-4">
                <div id="dropZone" class="border border-dashed rounded p-4 mb-3"
                     style="cursor: pointer; background-color: #f8f9fa;">
                    <i class="bi bi-image display-4 text-primary mb-2"></i>
                    <p class="mb-0 text-muted">
                        Drag & drop image here or click to select
                    </p>
                    <input type="file"
                           id="fileInput"
                           class="d-none"
                           accept="image/jpeg,image/png,image/webp,image/bmp" />
                </div>
                <div id="filePreview" class="text-muted mb-3"></div>
            </div>

            <!-- Progress Area -->
            <div id="progressArea" class="mb-4 d-none">
                <div class="d-flex justify-content-between mb-1">
                    <span id="progressStatus">Loading AI model...</span>
                    <span id="progressPercent">0%</span>
                </div>
                <div class="progress" style="height: 10px; border-radius: 10px;">
                    <div id="progressBar" class="progress-bar progress-bar-custom bg-success" style="width: 0%;"></div>
                </div>
            </div>

            <!-- Original & Result Previews -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="fw-semibold">📷 Original Image</label>
                    <div class="result-area">
                        <img id="originalPreview" class="image-preview" src="#" alt="Original preview" style="display: none;">
                        <div id="originalPlaceholder" class="text-muted">No image selected</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="fw-semibold">✨ Transparent Background<br><small class="text-muted">(same resolution)</small></label>
                    <div class="result-area">
                        <img id="resultPreview" class="image-preview" src="#" alt="Result preview" style="display: none;">
                        <div id="resultPlaceholder" class="text-muted">Result will appear here</div>
                    </div>
                </div>
            </div>

            <!-- Resolution guarantee note -->
            <div class="resolution-note mb-4">
                <strong>✅ Preserves original resolution</strong> — The output PNG has exactly the same width and height as your input image. No resizing, no cropping, no quality loss.
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <button id="removeBgBtn" class="btn btn-primary btn-lg px-4 shadow-sm" disabled>✨ Remove Background</button>
                <button id="downloadBtn" class="btn btn-success btn-lg px-4 shadow-sm" disabled>💾 Download PNG (same resolution)</button>
            </div>

            <div id="statusMsg" class="alert alert-info mt-3 d-none"></div>

        </div>
    </div>
</div>

