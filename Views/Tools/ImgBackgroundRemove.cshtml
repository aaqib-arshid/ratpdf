@model RemoveImgBgModel

@{
    ViewData["Title"] = "Free AI Background Remover Online";
    ViewData["Description"] = "Remove image background instantly for free. Upload JPG or PNG and download transparent PNG online using AI.";

}

<head>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="background remover, remove bg, image background remover, transparent png, ai background remover online" />
    <meta name="author" content="RatPDF" />
    <link rel="canonical" href="https://ratpdf.com/Tools/RemoveImgBackground" />

    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8899635585691076"
            crossorigin="anonymous"></script>
</head>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 700px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <img src="~/images/ratpdf-logo.png" height="60" class="mb-3" />
            <h2 class="fw-bold mb-3">AI Background Remover</h2>
            <p class="text-muted mb-4">
                Upload a JPG or PNG image and remove background instantly with AI.
            </p>

            <!-- Validation Errors -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger text-start">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <!-- Upload Form -->
            <form asp-action="RemoveImgBackground" asp-controller="Tools"
                  method="post" enctype="multipart/form-data"
                  id="removeImgBgForm">

                <div class="mb-3">
                    <div id="dropZone" class="border border-dashed rounded p-4 mb-3"
                         style="cursor: pointer; background-color: #f8f9fa;">
                        <i class="bi bi-image display-4 text-primary mb-2"></i>
                        <p class="mb-0 text-muted">
                            Drag & drop image here or click to select
                        </p>

                        <input type="file"
                               name="File"
                               id="fileInput"
                               class="form-control d-none"
                               accept="image/png, image/jpeg" />
                    </div>
                </div>

                <div id="filePreview" class="text-muted mb-3"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    Remove Background
                </button>
            </form>

        </div>
    </div>
</div>

<!-- RELATED TOOLS -->
<section class="related-tools text-center mt-4">
    <h3>Related Tools</h3>
    <ul class="list-unstyled">
        <li><a href="/PDF/ImgToBase64">Image to Base64</a></li>
        <li><a href="/PDF/ImageCompressor">Image Compressor</a></li>
        <li><a href="/PDF/ConvertImages">Images to PDF</a></li>
    </ul>
</section>

