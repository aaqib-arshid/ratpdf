@model IpResult
@{
    ViewData["Title"] = "What Is My IP Address? Check Your Public IP & Location";
    ViewData["Description"] = "Find your public IP address, location, ISP, and geolocation instantly. Free What is my IP tool with map and details.";
}

<head>
    <link rel="canonical" href="https://ratpdf.com/Tools/WhatIsMyIP" />

</head>

<div class="container py-5 d-flex justify-content-center align-items-start">
    <div class="card shadow-lg p-5" style="max-width: 600px; width: 100%; border-radius: 15px;">
        <div class="card-body text-center">

            <h2 class="fw-bold mb-3">What Is My IP Address?</h2>
            <p class="text-muted mb-4">Instantly check your public IP address, location, and ISP details.</p>

            @if (Model != null)
            {
                <h1 class="text-primary">@Model.Query</h1>

                <button class="btn btn-outline-secondary mb-3"
                        onclick="navigator.clipboard.writeText('@Model.Query')">
                    Copy IP
                </button>

                <div class="text-start mt-3">
                    <p><strong>Country:</strong> @Model.Country</p>
                    <p><strong>Region:</strong> @Model.RegionName</p>
                    <p><strong>City:</strong> @Model.City</p>
                    <p><strong>ZIP:</strong> @Model.Zip</p>
                    <p><strong>ISP:</strong> @Model.ISP</p>
                    <p><strong>Organization:</strong> @Model.Org</p>
                    <p><strong>Latitude:</strong> @Model.Lat</p>
                    <p><strong>Longitude:</strong> @Model.Lon</p>
                </div>

                <iframe width="100%" height="300" style="border:0; border-radius:10px;"
                        src="https://maps.google.com/maps?q=@Model.Lat,@Model.Lon&z=10&output=embed">
                </iframe>
            }
        </div>
    </div>
</div>

<!-- SEO CONTENT -->

<div class="container py-5">
    <div class="card shadow-sm p-4" style="border-radius: 12px;">

        <h2 class="fw-bold mb-3">What Is My IP Address?</h2>

        <p>
            Your IP address is a unique identifier assigned to your device when you connect to the internet.
            It allows websites and services to recognize your device and deliver content correctly.
        </p>

        <h2 class="fw-semibold mt-5">How to Check Your IP Address</h2>
        <ol>
            <li>Open this page</li>
            <li>Your IP address is automatically detected</li>
            <li>View location and ISP details instantly</li>
        </ol>

        <h2 class="fw-semibold mt-5">What Information Does This Tool Show?</h2>
        <ul>
            <li>Your public IP address</li>
            <li>Country, region, and city</li>
            <li>Internet service provider (ISP)</li>
            <li>Geolocation (latitude and longitude)</li>
        </ul>

        <h2 class="fw-semibold mt-5">Why Check Your IP?</h2>
        <ul>
            <li>Troubleshoot network issues</li>
            <li>Verify VPN or proxy connection</li>
            <li>Check location accuracy</li>
            <li>Improve online privacy awareness</li>
        </ul>

        <h2 class="fw-semibold mt-5">FAQ</h2>

        <h4>What is a public IP address?</h4>
        <p>Your public IP is the address visible on the internet assigned by your ISP.</p>

        <h4>Can my IP reveal my exact location?</h4>
        <p>No, it shows approximate location only, not your exact address.</p>

        <h4>Is this tool free?</h4>
        <p>Yes, it is completely free and works instantly.</p>

        <h2 class="fw-semibold mt-5">Conclusion</h2>
        <p>
            Checking your IP address helps you understand your internet connection and location details.
            Use this free tool anytime to instantly view your IP and related information.
        </p>

    </div>

</div>

@section Scripts {

    <script type="application/ld+json">
        @Html.Raw(@"{
          ""@context"": ""https://schema.org"",
          ""@graph"": [

                {
                  ""@type"": ""SoftwareApplication"",
                    ""name"": ""What Is My IP Tool"",
                    ""applicationCategory"": ""UtilityApplication"",
                    ""operatingSystem"": ""Web"",
                    ""url"": ""https://ratpdf.com/Tools/WhatIsMyIP"",
                  ""description"": ""Check your public IP address, ISP, and location instantly."",
                    ""offers"": {
                ""@type"": ""Offer"",
                        ""price"": ""0"",
                        ""priceCurrency"": ""USD""
                    }
                },

                {
              ""@type"": ""HowTo"",
                    ""name"": ""How to Check Your IP Address"",
                    ""step"": [
                        {
                      ""@type"": ""HowToStep"",
                            ""name"": ""Open the Tool"",
                            ""text"": ""Visit the What Is My IP page.""
                        },
                        {
                      ""@type"": ""HowToStep"",
                            ""name"": ""View Your IP"",
                            ""text"": ""Your IP address will be automatically displayed.""
                        },
                        {
                      ""@type"": ""HowToStep"",
                            ""name"": ""Check Details"",
                            ""text"": ""See your location and ISP information.""
                        }
                    ]
                },

                {
              ""@type"": ""FAQPage"",
                    ""mainEntity"": [
                        {
                      ""@type"": ""Question"",
                            ""name"": ""What is a public IP address?"",
                            ""acceptedAnswer"": {
                    ""@type"": ""Answer"",
                                ""text"": ""It is the IP assigned by your ISP and visible on the internet.""
                            }
                        },
                        {
                  ""@type"": ""Question"",
                            ""name"": ""Is this tool free?"",
                            ""acceptedAnswer"": {
                        ""@type"": ""Answer"",
                                ""text"": ""Yes, it is completely free.""
                            }
            }
                    ]
                }

            ]
        }");
</script>

}
