@using ratpdf.Models
@model ratpdf.Controllers.JwtDecodeViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Content.MetaTitle;
    ViewData["Description"] = Model.Content.MetaDescription;
}

@section Head {
    <link rel="canonical" href="https://ratpdf.com/jwt-decode/@Model.Content.Slug" />
    <meta property="og:title" content="@Model.Content.MetaTitle" />
    <meta property="og:description" content="@Model.Content.MetaDescription" />
    <meta property="og:url" content="https://ratpdf.com/jwt-decode/@Model.Content.Slug" />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    
    <script type="application/ld+json">
        @Html.Raw(Model.BreadcrumbSchema)
    </script>
    <script type="application/ld+json">
        @Html.Raw(Model.FaqSchema)
    </script>
    <script type="application/ld+json">
        @Html.Raw(Model.TechArticleSchema)
    </script>
}

<article class="jwt-page">
    <h1>@Model.Content.HeadingH1</h1>
    
    <div class="content">
        @Html.Raw(Model.Content.IntroductionHtml)
    </div>

    @foreach (var sect in Model.Content.Sections)
    {
        <section>
            <h2>@sect.Heading</h2>
            @Html.Raw(sect.Html)
        </section>
    }

    @if (!string.IsNullOrEmpty(Model.Content.CodeExampleHtml))
    {
        <div class="code-section">
            <h2>Code Examples</h2>
            @Html.Raw(Model.Content.CodeExampleHtml)
        </div>
    }

    @if (Model.Content.Faqs.Any())
    {
        <div class="faq-section">
            <h2>Frequently Asked Questions</h2>
            @foreach (var faq in Model.Content.Faqs)
            {
                <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <h3 itemprop="name">@faq.Question</h3>
                    <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <div itemprop="text">@Html.Raw(faq.Answer)</div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="related-links">
        <h3>Related Topics</h3>
        <ul>
            @foreach (var relatedSlug in Model.Content.RelatedSlugs)
            {
                <li>
                    <a href="/jwt-decode/@relatedSlug">
                        @System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(relatedSlug.Replace("-", " "))
                    </a>
                </li>
            }
        </ul>
    </div>
</article>

<style>
    .jwt-page { max-width: 900px; margin: 0 auto; padding: 20px; }
    .jwt-page h1 { font-size: 2.2rem; margin-bottom: 1rem; }
    .jwt-page h2 { font-size: 1.6rem; margin-top: 2rem; border-bottom: 1px solid #eee; }
    .code-section pre { background: #f4f4f4; padding: 15px; border-radius: 5px; overflow-x: auto; }
    .faq-section .faq-item { margin-bottom: 1.5rem; }
    .related-links { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd; }
</style>